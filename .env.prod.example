# docs/adr/0042 / docs/self-hosting.md — copy to .env, fill in every value
# marked CHANGE ME. Unlike the dev .env.example, there is no working
# default for most of these: a real domain, a real SMTP provider, and
# real secrets are not optional in production.

# --- Domain & TLS ---
DOMAIN=example.com
ACME_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_USER=brisk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=brisk
POSTGRES_APP_PASSWORD=CHANGE_ME

# --- Tenant/site — generate with `uuidgen` (or any UUID), then run the
# seed step (docs/self-hosting.md) to create matching rows for them ---
DEFAULT_TENANT_ID=CHANGE_ME
DEFAULT_SITE_ID=CHANGE_ME

# --- First admin account — also created by the seed step. Set a real,
# unique password here before seeding: this becomes the actual production
# admin login, not a placeholder. It can be changed afterward via the
# "Forgot password?" flow once SMTP below is real. ---
DEFAULT_USER_EMAIL=CHANGE_ME
DEFAULT_USER_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 32
PREVIEW_TOKEN_SECRET=CHANGE_ME

# --- Optional: comma-separated allow-list restricting which of the
# bundled themes this deployment will serve, e.g. BRISK_THEME=classic —
# what an agency sets so its client can only ever pick the agency's own
# theme. Unset (the default): every bundled theme is selectable. This
# does NOT pick which theme a site currently uses — that's chosen live
# from editor-app's Style dialog (Site.themeName). Read at runtime by
# public-site, so changing it needs a restart, not a rebuild
# (docs/adr/0021/0042). ---
# BRISK_THEME=

# --- SMTP (a real provider — Mailpit is dev-only) ---
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# --- Cloudflare Turnstile (real site/secret keys — the defaults below are
# Cloudflare's own published test keys, always pass, no real challenge) ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Postgres backup sidecar ---
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# --- Optional: S3-compatible media storage instead of local disk ---
# MEDIA_STORAGE_PROVIDER=s3
# S3_MEDIA_BUCKET=brisk-media
# S3_MEDIA_REGION=us-east-1
# S3_MEDIA_ENDPOINT=
# S3_MEDIA_FORCE_PATH_STYLE=false
# S3_MEDIA_ACCESS_KEY_ID=
# S3_MEDIA_SECRET_ACCESS_KEY=
# S3_MEDIA_PUBLIC_BASE_URL=

# --- Optional: newsletter provider ---
# NEWSLETTER_PROVIDER=mailchimp
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# NEWSLETTER_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_LIST_ID=
