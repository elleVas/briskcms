# docs/adr/0042 — keeps the build context small; every Dockerfile installs
# and builds fresh inside its own stage, so none of this needs to travel in.
node_modules
**/node_modules
dist
**/dist
out-tsc
**/out-tsc
coverage
**/coverage
.nx/cache
.nx/workspace-data
tmp
**/*.tsbuildinfo
test-output
**/test-output

# local-only, never needed inside a build
.git
.env
.env.local
.vscode
*.log

