# Superuser: solo per migration/admin, MAI per le query runtime dell'app (bypassa RLS)
POSTGRES_USER=brisk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=brisk
POSTGRES_PORT=5432

# Ruolo applicativo non-superuser (utente fisso "brisk_app", vedi db/init/000_roles.sh):
# è la connessione che deve usare il backend, rispetta le policy RLS.
POSTGRES_APP_PASSWORD=changeme_app

# Tenant/sito di questa istanza self-hosted (single-tenant per deployment,
# vedi docs/adr/0010). Popolati da `pnpm --filter @brisk/postgres-db run db:seed`.
DEFAULT_TENANT_ID=31329174-2ede-4151-be9d-a3e765d21e1f
DEFAULT_SITE_ID=568b7d6a-3483-45f2-83f1-3b31b433c5eb

# Utente admin per sviluppo/test locali — nessuna registrazione pubblica
# esiste (vedi docs/adr/0010). Popolato dallo stesso `db:seed`.
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=changeme_dev_password

# Firma HMAC dei token di preview (@brisk/preview-token-adapter) — token
# stateless, non c'è più una tabella da consultare/ripulire. Un vero
# deployment DEVE generarne uno reale con `openssl rand -hex 32`: chi
# conosce questo valore può forgiare un token per vedere qualunque
# contenuto in bozza del tenant (nessun accesso in scrittura o
# all'account, ma resta un'esposizione reale di contenuto non pubblico).
PREVIEW_TOKEN_SECRET=changeme_preview_secret

# Origine dell'editor-app, per il CORS ristretto dell'API (vedi apps/api/src/main.ts)
# e per costruire i link di verifica email/reset password nelle email inviate.
EDITOR_APP_URL=http://localhost:4200

# SMTP generico per l'invio email (verifica account, reset password) — vedi
# docs/adr/0011-email-verification-password-reset.md. In locale punta a
# Mailpit (docker-compose), che non richiede autenticazione: SMTP_USER/
# SMTP_PASSWORD restano vuoti. In produzione vanno sostituiti con un
# provider SMTP reale.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_ADDRESS=noreply@brisk.local
SMTP_USER=
SMTP_PASSWORD=

# apps/editor-app (Vite): solo le var con prefisso VITE_ arrivano al browser,
# per questo DEFAULT_SITE_ID è duplicato qui sotto con lo stesso valore.
VITE_API_URL=http://localhost:3000/api
VITE_DEFAULT_SITE_ID=568b7d6a-3483-45f2-83f1-3b31b433c5eb

# apps/public-site (SSR, Node): letta da process.env a runtime, non a build
# time (vedi src/lib/public-api-client.ts) — stessa API, chiamata server-side.
API_URL=http://localhost:3000/api

# apps/editor-app: dove punta il link "Visualizza pagina" nell'editor (vedi
# page-editor-view.tsx) — l'origine pubblica del sito che apps/public-site serve.
VITE_PUBLIC_SITE_URL=http://localhost:4321

# apps/editor-app: chiave PUBBLICA del widget Turnstile su login/reset-
# password (security review 2026-08-24, punto 13) — la site key è pensata
# per essere esposta al browser, mai la secret key (TURNSTILE_SECRET_KEY
# sopra, letta solo lato apps/api). Stesso valore di test Cloudflare già
# usato per TURNSTILE_SITE_KEY.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# apps/api: pipeline media (vedi docs/adr/0013). MEDIA_UPLOAD_DIR è dove
# LocalDiskMediaStorageAdapter scrive i file e da dove main.ts li serve;
# API_PUBLIC_URL è l'origine con cui vengono costruiti gli URL pubblici dei
# file caricati — stesso valore di VITE_API_URL, letto qui dal lato API.
# Le stesse due variabili (e MEDIA_STORAGE_PROVIDER/S3_MEDIA_* sotto) sono
# riusate anche per il campo "Caricamento file" nei form (@brisk/local-disk-
# attachment-storage / @brisk/s3-attachment-storage) — gli allegati finiscono
# in un sottocartella "attachments" separata dalla libreria media curata,
# nessuna variabile in più da configurare.
# Consigliato un path ASSOLUTO in locale (es. /Users/te/progetti/briskcsm/
# uploads): un path relativo si risolve rispetto alla cwd del processo, che
# cambia a seconda di chi lo lancia (nx serve dalla root, webpack build da
# apps/api, Jest da apps/api) — stesso .env, cartelle diverse. In produzione
# questo punta al mount point del volume Docker persistente (Fase 6), già
# assoluto e fisso per definizione lì.
MEDIA_UPLOAD_DIR=./uploads
API_PUBLIC_URL=http://localhost:3000/api

# Cloudflare Turnstile — CAPTCHA reale sui form pubblici (docs/adr/0015),
# oltre all'honeypot già esistente. TURNSTILE_SECRET_KEY è letta da
# apps/api (@brisk/turnstile-captcha, verifica server-side); TURNSTILE_SITE_KEY
# è letta da apps/public-site e renderizzata nell'HTML del widget (server-side,
# come API_URL sopra — non è una var VITE_/PUBLIC_ perché apps/public-site
# non fa build-time bundling per-dominio, vedi src/lib/public-api-client.ts).
# I valori di default qui sotto sono le chiavi di test documentate da
# Cloudflare (sempre "superate", nessuna sfida reale) — stesso spirito di
# SMTP_HOST=localhost sopra: funzionano subito in locale senza un account
# Cloudflare vero. Vanno sostituite con le chiavi reali del sito in produzione.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# apps/public-site: quale pacchetto tema in themes/<nome> (docs/adr/0021)
# questo build usa — letta solo in astro.config.mjs, a build-time, mai per
# richiesta. Non richiesta (requireEnv non la usa): se assente, il default
# nel codice è "classic", quindi non serve toccare .github/workflows/ci.yml
# per farla funzionare in CI.
# BRISK_THEME=classic

# apps/api: adapter di storage media alternativo, S3-compatibile (AWS S3 o
# self-hosted come MinIO) invece di LocalDisk — vedi @brisk/s3-media-storage.
# Non impostare MEDIA_STORAGE_PROVIDER (o lasciarlo a "local") mantiene il
# comportamento di sempre; le variabili S3_MEDIA_* sotto sono richieste solo
# quando MEDIA_STORAGE_PROVIDER=s3. S3_MEDIA_ENDPOINT va valorizzato solo
# per un endpoint S3-compatibile self-hosted (es. MinIO), va lasciato vuoto
# per AWS S3 reale; S3_MEDIA_FORCE_PATH_STYLE=true è richiesto da MinIO.
# MEDIA_STORAGE_PROVIDER=s3
# S3_MEDIA_BUCKET=brisk-media
# S3_MEDIA_REGION=us-east-1
# S3_MEDIA_ENDPOINT=http://localhost:9000
# S3_MEDIA_FORCE_PATH_STYLE=true
# S3_MEDIA_ACCESS_KEY_ID=
# S3_MEDIA_SECRET_ACCESS_KEY=
# S3_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/brisk-media

# apps/api: iscrizione newsletter (campo "newsletter-consent" nel form
# builder + blocco standalone "Iscrizione newsletter") — vedi
# @brisk/mailchimp-newsletter / @brisk/brevo-newsletter. Newsletter è
# opzionale: senza NEWSLETTER_PROVIDER impostato, l'iscrizione è un no-op
# innocuo (nessuna delle variabili sotto è richiesta). Impostare
# NEWSLETTER_PROVIDER=mailchimp oppure =brevo attiva il provider
# corrispondente — solo le sue variabili diventano allora obbligatorie.
# NEWSLETTER_PROVIDER=mailchimp
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# NEWSLETTER_PROVIDER=brevo
# BREVO_API_KEY=
# BREVO_LIST_ID=
