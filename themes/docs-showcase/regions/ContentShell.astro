---
import type { PageTreeNodeDto } from '../../../apps/public-site/src/lib/public-api-client';
import { localePathFromAncestors } from '../../../apps/public-site/src/lib/locale-path';
import type { ThemeContentShellProps } from '../../../apps/public-site/src/lib/theme-regions';

/**
 * La sidebar docs e il pager prev/next di questo tema. Sostituisce la copia
 * integrale di PageLayout.astro che il tema teneva prima: <html>, <head>,
 * header, footer, consent, CSP e preview bridge sono tornati al core, e qui
 * resta solo cio che e davvero di questo tema.
 *
 * Il fetch dell'albero, la guardia sul dominio e la gestione dell'errore non
 * sono piu qui: arrivano gia risolti da `pageTree()`, che il core memoizza
 * per richiesta e fa risolvere a [] in caso di guasto.
 */
type Props = ThemeContentShellProps;

const { locale, currentPath, i18n, pageTree, route } = Astro.props;

// --- Sidebar: a docs section is a 2-level hierarchy (root → category →
// doc page), all categories shown simultaneously (like inertiajs.com's own
// /docs), not just the current page's own siblings. Built from the flat
// page tree (docs/adr/0021's own list-published-page-tree endpoint, added
// for this theme) rather than `ancestors`: `ancestors` alone can't tell a
// section's *root* page (which has no ancestors of its own, being
// top-level) that it should still show its own category tree.
interface SidebarNode {
	slug: string;
	title: string;
	href: string;
}
interface SidebarGroup {
	title: string;
	items: SidebarNode[];
}
// `order` (drag-to-reorder in the editor's pages list) is the sort key to
// use now — `createdAt` is only a tiebreak for pages that predate manual
// ordering, all sharing the same default `order` value (see
// list-published-page-tree.use-case.ts), same "order asc, createdAt asc"
// semantics as the editor's own pages list.
const byOrderThenCreatedAtAsc = (a: PageTreeNodeDto, b: PageTreeNodeDto) =>
	a.order - b.order || a.createdAt.localeCompare(b.createdAt);
const toSidebarNode = (node: PageTreeNodeDto): SidebarNode => ({
	slug: node.slug,
	title: node.title,
	href: localePathFromAncestors(locale, node.ancestorSlugs, node.slug),
});

let sidebarGroups: SidebarGroup[] = [];
// Solo su una pagina vera: su ricerca e sugli errori non c'e un nodo
// corrente da cui risalire, quindi chiamare pageTree() sarebbe un fetch
// per niente. Il core lo memoizza comunque per richiesta.
const tree: PageTreeNodeDto[] = route === 'page' ? await pageTree() : [];

// Il pathname intero, non solo l'ultimo segmento: l'unicita degli slug e
// per fratelli (docs/adr/0029), quindi due pagine docs sotto genitori
// DIVERSI possono legittimamente avere lo stesso slug finale (due
// "overview"). Confrontare il solo slug prendeva quella che capitava prima
// nell'albero appiattito, evidenziando la voce sbagliata nella sidebar e
// puntando il pager ai fratelli del nodo sbagliato. L'href di un nodo,
// costruito allo stesso modo, e invece unico.
const currentNode =
	tree.find(
		(node) =>
			localePathFromAncestors(locale, node.ancestorSlugs, node.slug) ===
			currentPath,
	) ?? null;

if (currentNode) {
	// Si risale alla radice della sezione (parentId === null). La radice
	// puo essere la pagina corrente stessa (si sta visitando la landing
	// della sezione), una categoria, o una pagina foglia.
	let docsRoot = currentNode;
	const visited = new Set<string>([docsRoot.id]);
	while (docsRoot.parentId) {
		const parent = tree.find((node) => node.id === docsRoot.parentId);
		if (!parent || visited.has(parent.id)) break;
		docsRoot = parent;
		visited.add(docsRoot.id);
	}

	const categories = tree
		.filter((node) => node.parentId === docsRoot.id)
		.sort(byOrderThenCreatedAtAsc);
	sidebarGroups = categories
		.map((category) => ({
			title: category.title,
			items: tree
				.filter((node) => node.parentId === category.id)
				.sort(byOrderThenCreatedAtAsc)
				.map(toSidebarNode),
		}))
		.filter((group) => group.items.length > 0);
}
const hasSidebar = sidebarGroups.length > 0;
const flatDocs = sidebarGroups.flatMap((group) => group.items);
const currentDocIndex = flatDocs.findIndex((node) => node.href === currentPath);
const prevDoc = currentDocIndex > 0 ? flatDocs[currentDocIndex - 1] : null;
const nextDoc =
	currentDocIndex >= 0 && currentDocIndex < flatDocs.length - 1
		? flatDocs[currentDocIndex + 1]
		: null;
---

	hasSidebar ? (
		<div class="brisk-docs-shell">
			<nav class="brisk-docs-sidebar" aria-label={i18n.t('docs.sidebarLabel')}>
				{sidebarGroups.map((group) => (
					<div class="brisk-docs-sidebar__group">
						<div class="brisk-docs-sidebar__title">{group.title}</div>
						<ul class="brisk-docs-sidebar__list">
							{group.items.map((item) => (
								<li>
									<a
										href={item.href}
										aria-current={item.href === currentPath ? 'page' : undefined}
									>
										{item.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</nav>
			<div class="brisk-docs-shell__content">
				<slot />
				<nav class="brisk-docs-pagination" aria-label={i18n.t('docsPagination.navLabel')}>
					{prevDoc ? (
						<a class="brisk-docs-pagination__link brisk-docs-pagination__link--prev" href={prevDoc.href}>
							<span class="brisk-docs-pagination__label">{i18n.t('docsPagination.prev')}</span>
							<span class="brisk-docs-pagination__title">{prevDoc.title}</span>
						</a>
					) : (
						<span />
					)}
					{nextDoc && (
						<a class="brisk-docs-pagination__link brisk-docs-pagination__link--next" href={nextDoc.href}>
							<span class="brisk-docs-pagination__label">{i18n.t('docsPagination.next')}</span>
							<span class="brisk-docs-pagination__title">{nextDoc.title}</span>
						</a>
					)}
				</nav>
			</div>
		</div>
	) : (
		<slot />
	)
<style>
	.brisk-header--sticky {
		position: sticky;
		top: 0;
		z-index: 40;
	}
	.brisk-docs-shell {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2.5rem;
		max-width: 72rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
	}
	.brisk-docs-sidebar__group + .brisk-docs-sidebar__group {
		margin-top: 1.5rem;
	}
	.brisk-docs-sidebar__title {
		font-weight: 700;
		font-size: 0.9375rem;
		margin-bottom: 0.75rem;
	}
	.brisk-docs-sidebar__list {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		list-style: none;
		padding: 0;
		margin: 0;
		border-left: 2px solid var(--border);
	}
	.brisk-docs-sidebar__list a {
		display: block;
		padding: 0.375rem 0.875rem;
		margin-left: -2px;
		border-left: 2px solid transparent;
		font-size: 0.875rem;
		color: var(--muted-foreground);
		text-decoration: none;
	}
	.brisk-docs-sidebar__list a:hover {
		color: var(--foreground);
	}
	.brisk-docs-sidebar__list a[aria-current='page'] {
		border-left-color: var(--primary);
		color: var(--primary);
		font-weight: 600;
	}
	.brisk-docs-pagination {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	.brisk-docs-pagination__link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-width: 45%;
		text-decoration: none;
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		border: 1px solid var(--border);
	}
	.brisk-docs-pagination__link:hover {
		border-color: var(--primary);
	}
	.brisk-docs-pagination__link--next {
		margin-left: auto;
		text-align: right;
		align-items: flex-end;
	}
	.brisk-docs-pagination__label {
		font-size: 0.75rem;
		color: var(--muted-foreground);
	}
	.brisk-docs-pagination__title {
		font-weight: 600;
		color: var(--primary);
	}
	@media (max-width: 800px) {
		.brisk-docs-shell {
			grid-template-columns: 1fr;
		}
	}
</style>
