---
// Override of apps/public-site/src/components/blocks/Hero.astro, resolved
// via resolveThemeBlockOverride (docs/adr/0021's per-block escalation) —
// same title/subtitle props as core, themes/README.md's own boundary: a
// theme restyles, it doesn't get new data fields on an existing block.
// The pill badge below is a fixed design element of this theme, not
// editor-controlled content — same reasoning astro.build's own "Astro 7.2
// Available now!" badge is baked into their homepage, not a CMS field.
// A relative path, not the bare specifier — see the comment in
// ../PageLayout.astro for why.
import type { HeroProps } from '@brisk/shared-types';

type Props = HeroProps;

const { title, subtitle } = Astro.props;
---

<header class="brisk-docs-hero">
	<div class="brisk-docs-hero__badge">✨ Built with Brisk itself</div>
	<h1 class="brisk-docs-hero__title">{title}</h1>
	<p class="brisk-docs-hero__subtitle">{subtitle}</p>
</header>

<style>
	.brisk-docs-hero {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		padding: 6rem 1.5rem 7rem;
		text-align: center;
		border-radius: var(--radius-lg, var(--radius));
		/* Reads the theme's own --primary token (theme.css) rather than a
		   literal color duplicated here — the "carta da zucchero" blue stays
		   a single source of truth. Three layers, back to front: a glossy
		   diagonal sheen (the "lucido" look), a bright highlight upper-left,
		   a darker vignette toward the bottom edge for real depth instead of
		   the previous flat wash — deliberately more pronounced ("più
		   marcata") than the original single soft radial. Rest of the site
		   is the dark --background token (this theme is all-dark by design,
		   unlike inertiajs.com's light home + dark docs). */
		background: linear-gradient(
				115deg,
				transparent 28%,
				color-mix(in oklab, var(--primary-foreground) 22%, transparent) 47%,
				transparent 64%
			),
			radial-gradient(
				ellipse 90% 70% at 22% -10%,
				color-mix(in oklab, var(--primary) 42%, white 46%),
				transparent 62%
			),
			radial-gradient(
				ellipse 120% 90% at 50% 115%,
				color-mix(in oklab, var(--primary) 65%, black 30%),
				var(--primary) 55%
			);
		color: var(--primary-foreground);
	}
	.brisk-docs-hero__badge {
		display: inline-flex;
		align-items: center;
		padding: 0.375rem 0.9rem;
		border-radius: 999px;
		background: color-mix(in oklab, var(--primary-foreground) 14%, transparent);
		border: 1px solid color-mix(in oklab, var(--primary-foreground) 22%, transparent);
		font-size: 0.8125rem;
		font-weight: 500;
	}
	.brisk-docs-hero__title {
		max-width: 42rem;
		margin: 0;
		font-size: 3rem;
		line-height: 1.1;
		font-weight: 800;
		letter-spacing: -0.02em;
	}
	.brisk-docs-hero__subtitle {
		max-width: 34rem;
		margin: 0;
		font-size: 1.125rem;
		color: color-mix(in oklab, var(--primary-foreground) 80%, var(--primary));
	}
	@media (max-width: 640px) {
		.brisk-docs-hero__title {
			font-size: 2.25rem;
		}
	}
</style>
