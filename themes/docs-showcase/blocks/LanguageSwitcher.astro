---
// Override of apps/public-site/src/components/blocks/LanguageSwitcher.astro
// (docs/adr/0021's per-block escalation) — same data/logic as core (which
// enabled locale to link where), the difference is purely presentational:
// a compact icon toggle (globe + current locale) instead of a plain
// "EN | IT" text list. Restyle only, per themes/README's boundary — no
// new block type needed for this, LanguageSwitcher already carries
// everything a toggle needs (2026-08-30, user explicitly asked whether a
// new generic icon-button block was warranted here — it wasn't: this is a
// one-off restyle of an existing data-driven block, not a new reusable
// content primitive).
import type {
  LanguageSwitcherProps,
  PublishedPageTranslation,
  PublishedSite,
} from '@brisk/shared-types';
import { localePath } from '@brisk/theme-runtime';
import { Translator } from '@brisk/theme-runtime';

interface Props extends LanguageSwitcherProps {
  locale: string;
  translations: PublishedPageTranslation[];
  site: PublishedSite;
}

const { position, visibility, locale, translations, site } = Astro.props;

const defaultTranslation = translations.find(
  (translation) => translation.locale === site.defaultLocale,
);

interface LocaleLink {
  locale: string;
  href: string;
}

const links = site.enabledLocales
  .map((enabledLocale): LocaleLink | null => {
    const translation = translations.find(
      (candidate) => candidate.locale === enabledLocale,
    );
    if (translation) {
      return {
        locale: enabledLocale,
        href: localePath(translation.locale, translation.slug),
      };
    }
    if (site.untranslatedPageFallback === 'redirect-to-default' && defaultTranslation) {
      return {
        locale: enabledLocale,
        href: localePath(defaultTranslation.locale, defaultTranslation.slug),
      };
    }
    return null;
  })
  .filter((link): link is LocaleLink => link !== null);

const i18n = new Translator(locale);
const globeSvg = Astro.locals.resolveIcon('globe', site.themeName);

// Exactly 2 enabled locales (this site's real config, and the common
// case) renders as a single toggle: current locale + globe, clicking
// jumps straight to the other one. 3+ locales falls back to the plain
// list core already renders — a toggle stops making sense once there's
// more than one "other" option to pick between.
const isToggle = links.length === 2;
const otherLink = isToggle
  ? links.find((link) => link.locale !== locale)
  : null;
---

{
  links.length > 1 && (
    <nav
      class:list={[
        'brisk-language-switcher',
        { 'brisk-language-switcher--right': position === 'right' },
        { 'brisk-visibility-desktop-only': visibility === 'desktop-only' },
        { 'brisk-visibility-mobile-only': visibility === 'mobile-only' },
      ]}
      aria-label={i18n.t('languageSwitcher.label')}
    >
      {isToggle && otherLink ? (
        <a
          class="brisk-language-toggle"
          href={otherLink.href}
          aria-label={`${locale.toUpperCase()} → ${otherLink.locale.toUpperCase()}`}
        >
          {globeSvg && <span class="brisk-language-toggle__icon" aria-hidden="true" set:html={globeSvg} />}
          <span class="brisk-language-toggle__current">{locale.toUpperCase()}</span>
        </a>
      ) : (
        links.map((link) => (
          <a
            href={link.href}
            aria-current={link.locale === locale ? 'true' : undefined}
          >
            {link.locale.toUpperCase()}
          </a>
        ))
      )}
    </nav>
  )
}

<style>
  .brisk-language-switcher {
    display: flex;
    gap: 0.5rem;
  }
  .brisk-language-switcher--right {
    margin-left: auto;
  }
  .brisk-language-switcher a[aria-current='true'] {
    font-weight: 600;
    text-decoration: underline;
  }
  .brisk-language-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--foreground);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .brisk-language-toggle:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .brisk-language-toggle__icon {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
  }
  .brisk-language-toggle__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
