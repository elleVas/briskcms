---
import type { StatusBadgeProps } from './StatusBadge.block';

// Same instance-style convention every core block uses, and since
// ADR-0047 it costs a theme block nothing at all: the per-instance
// override is a generated CSS RULE, not an inline attribute — an inline
// `style` cannot hold the container query a per-breakpoint value needs.
// A stylable block receives the class that rule targets and puts it on
// its root element; the custom properties below
// (`--brisk-override-bg`/`--brisk-override-text`, the fixed shared names
// from libs/shared-types/src/lib/block-style-overrides.ts) arrive through
// it. Nothing to build by hand, and no copy of those names in TypeScript
// to drift from the real ones.
interface Props extends StatusBadgeProps {
  instanceClass?: string | null;
}

const { label, tone, instanceClass } = Astro.props;
---

<span
  class:list={['brisk-status-badge', instanceClass]}
  data-tone={tone}
  data-brisk-field="label"
>
  <span class="brisk-status-badge__dot" aria-hidden="true"></span>
  {label}
</span>

<style>
  .brisk-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.15rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    background: var(--brisk-override-bg, var(--muted));
    color: var(--brisk-override-text, var(--muted-foreground));
  }
  .brisk-status-badge__dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    /* Fixed per-tone colors, not theme tokens — same reasoning as
       Callout.astro's own tone colors: an info/success/warning signal
       has to stay recognizable regardless of the active theme's palette. */
    background: #3b82f6;
  }
  .brisk-status-badge[data-tone='success'] .brisk-status-badge__dot {
    background: #22c55e;
  }
  .brisk-status-badge[data-tone='warning'] .brisk-status-badge__dot {
    background: #f59e0b;
  }
  .brisk-status-badge[data-tone='neutral'] .brisk-status-badge__dot {
    background: #94a3b8;
  }
</style>
