---
// Override of apps/public-site/src/components/blocks/Button.astro,
// resolved via resolveThemeBlockOverride (docs/adr/0021's per-block
// escalation) — same props/markup as core, the ONE difference is layout:
// every standalone Button under this theme centers itself in its
// container, regardless of how/where the editor placed it. Deliberate
// demonstration that a theme's own CSS can override a layout decision
// the editor/content author never made explicit (user's own framing,
// 2026-08-30) — content stays theme-agnostic, the theme still gets the
// final say on presentation.
import type { ButtonProps } from '@brisk/shared-types';
import { resolveLinkHref } from '@brisk/theme-runtime';

// `instanceClass` and not `styleOverride` since ADR-0047: the per-instance
// override is a generated CSS rule now, not an inline attribute, because an
// inline `style` cannot hold the container query a per-breakpoint value
// needs. A theme block receives the class that rule targets and puts it on
// its root element; the override itself never reaches the component.
type Props = ButtonProps & {
  instanceClass?: string | null;
  variantClass?: string | null;
};

const { label, linkType, page, url, instanceClass, variantClass } =
  Astro.props;
// The same function core's Button uses (ADR-0063), and the reason a
// theme gets one at all: this copy resolved a page with `localePath`,
// which knows nothing about ancestors — so a Button pointing at a
// nested page linked to `/en/prezzi` instead of `/en/docs/prezzi` and
// 404'd, the bug PR #137 fixed everywhere except in here. It also fell
// back to the url field whenever the page did not resolve.
const href = resolveLinkHref({ linkType, page, url });
---

<a
  class:list={['brisk-button', variantClass, instanceClass]}
  href={href ?? undefined}
  data-brisk-field="label"
>
  {label}
</a>

<style>
  .brisk-button {
    display: block;
    width: fit-content;
    margin-inline: auto;
    padding: var(--brisk-override-padding-y, 0.5rem)
      var(--brisk-override-padding-x, 1.25rem);
    border-radius: var(--brisk-override-radius, var(--radius));
    background: var(--brisk-override-bg, var(--primary));
    color: var(--brisk-override-text, var(--primary-foreground));
    text-decoration: none;
    border: 1px solid var(--brisk-override-bg, var(--primary));
  }
  .brisk-button--secondary {
    background: transparent;
    color: var(--brisk-override-bg, var(--primary));
  }

  /* `ghost` is core's own look since ADR-0056; this is the theme
     restyling it, which is what a theme is for. Declaring it moved to
     core, the appearance stayed here. */
  .brisk-button--ghost {
    background: transparent;
    color: var(--brisk-override-text, var(--foreground));
    border: 1px solid var(--border);
  }

  .brisk-button--ghost:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Declared by this theme in Button.variants.ts, not by core (ADR-0047):
     a look the theme ADDS to the core Button rather than a block type of
     its own. The class name is what BlockRenderer emits from
     `Block.variant`; nothing else was needed to make it render. It is
     the same gradient this theme's hero uses, which is exactly the kind
     of thing core should not ship and a theme should. */
  .brisk-button--gradient {
    background: linear-gradient(135deg, var(--primary), var(--secondary));
    color: var(--primary-foreground);
    border-color: transparent;
  }
</style>
