---
// Override of apps/public-site/src/layouts/PageLayout.astro, resolved via
// resolveThemeLayoutOverride (docs/adr/0021's full-layout escalation).
// Everything above <body> (head/meta/SEO/Tier-1-theme-override wiring) is
// unchanged from core — copied, not re-derived, so this theme doesn't
// silently drift from whatever core's own <head> does. The only real
// difference is inside <body>: a docs-style sidebar next to the content
// for any page that's part of a multi-page section, nothing for a
// standalone page (the home included) — see the sidebar logic below.
// Path relativo (non il bare specifier "@brisk/shared-types"): themes/ non
// è un pacchetto workspace pnpm con il proprio node_modules come ogni
// apps/*/libs/*, quindi un import bare da qui non si risolve mai — cammina
// verso l'alto nel filesystem e non trova nulla (il node_modules di ogni
// pacchetto è isolato per pacchetto). Stesso motivo per cui ogni altro
// import in questo file è già relativo.
import {
	buildBlockStyleOverridesCss,
	DEFAULT_THEME_TOKENS,
	type Block,
	type SeoMeta,
} from '../../libs/shared-types/src/index';
import {
	listPublishedPageTree,
	type PageTreeNodeDto,
	type PublishedPageAncestorDto,
	type PublishedPageTranslationDto,
	type PublishedSiteDto,
} from '../../apps/public-site/src/lib/public-api-client';
import BlockRenderer from '../../apps/public-site/src/components/BlockRenderer.astro';
import { editorAppUrl } from '../../apps/public-site/src/lib/editor-app-url';
import {
	localeDirection,
	localePath,
	localePathFromAncestors,
} from '../../apps/public-site/src/lib/locale-path';
import { buildSchemaOrgGraph } from '../../apps/public-site/src/lib/schema-org';
import { resolveThemeFont } from '../../apps/public-site/src/lib/theme-font';
import { Translator } from '../../apps/public-site/src/lib/i18n';
import '../../apps/public-site/src/styles/global.css';
import './theme.css';
import themeManifest from './theme.json';
import '../../apps/public-site/src/styles/visibility.css';

interface Props {
	seoMeta: SeoMeta;
	locale: string;
	translations: PublishedPageTranslationDto[];
	site: PublishedSiteDto;
	header: Block[] | null;
	footer: Block[] | null;
	headerSticky: boolean;
	ancestors: PublishedPageAncestorDto[];
	// Solo la rotta di preview lo passa (vedi il piano dell'editor visuale,
	// Giorno 2) — stessa prop di core PageLayout.astro, che questo file
	// sovrascrive per intero (docs/adr/0021's full-layout escalation), va
	// quindi propagata anche qui.
	editable?: boolean;
}

const {
	seoMeta,
	locale,
	translations,
	site,
	header,
	footer,
	headerSticky,
	ancestors,
	editable,
} = Astro.props;
const defaultTranslation = translations.find(
	(translation) => translation.locale === site.defaultLocale,
);
const i18n = new Translator(locale);

const pageUrl = seoMeta.canonical || Astro.url.href;
const ogImage = seoMeta.ogTags?.['image'];
const schemaOrgGraph = buildSchemaOrgGraph({ site, seoMeta, pageUrl });
const schemaOrgJson = JSON.stringify(schemaOrgGraph).replace(/</g, '\\u003c');

const allowStyleOverrides =
	(themeManifest.allowStyleOverrides ?? true) &&
	site.themeSettings.overridesEnabled;
const theme = allowStyleOverrides
	? site.themeSettings
	: {
			primaryColor: null,
			secondaryColor: null,
			fontFamily: null,
			customCss: null,
			headScript: null,
			bodyScript: null,
			faviconUrl: null,
			overridesEnabled: false,
		};
const themeFont = resolveThemeFont(theme.fontFamily);
const themeOverrideDeclarations = [
	theme.primaryColor && `--primary: ${theme.primaryColor} !important;`,
	theme.secondaryColor && `--secondary: ${theme.secondaryColor} !important;`,
	themeFont && `--font-sans-value: ${themeFont.cssFontFamily} !important;`,
]
	.filter(Boolean)
	.join(' ');
const tokens = allowStyleOverrides ? site.themeTokens : DEFAULT_THEME_TOKENS;
const blockStyleOverridesCss = buildBlockStyleOverridesCss(
	tokens.blockStyles,
);

// --- Sidebar: a docs section is a 2-level hierarchy (root → category →
// doc page), all categories shown simultaneously (like inertiajs.com's own
// /docs), not just the current page's own siblings. Built from the flat
// page tree (docs/adr/0021's own list-published-page-tree endpoint, added
// for this theme) rather than `ancestors`: `ancestors` alone can't tell a
// section's *root* page (which has no ancestors of its own, being
// top-level) that it should still show its own category tree.
interface SidebarNode {
	slug: string;
	title: string;
	href: string;
}
interface SidebarGroup {
	title: string;
	items: SidebarNode[];
}
// `order` (drag-to-reorder in the editor's pages list) is the sort key to
// use now — `createdAt` is only a tiebreak for pages that predate manual
// ordering, all sharing the same default `order` value (see
// list-published-page-tree.use-case.ts), same "order asc, createdAt asc"
// semantics as the editor's own pages list.
const byOrderThenCreatedAtAsc = (a: PageTreeNodeDto, b: PageTreeNodeDto) =>
	a.order - b.order || a.createdAt.localeCompare(b.createdAt);
const toSidebarNode = (node: PageTreeNodeDto): SidebarNode => ({
	slug: node.slug,
	title: node.title,
	href: localePathFromAncestors(locale, node.ancestorSlugs, node.slug),
});

let sidebarGroups: SidebarGroup[] = [];
let currentSlug: string | null = null;

if (site.domain) {
	const currentPathSegments = Astro.url.pathname.split('/').filter(Boolean);
	currentSlug = currentPathSegments.at(-1) ?? null;

	let tree: PageTreeNodeDto[] = [];
	try {
		tree = await listPublishedPageTree(site.domain, locale);
	} catch {
		// Best-effort: a page tree fetch failing shouldn't take the whole
		// page down with it, just fall back to "no sidebar" like a
		// standalone page would render anyway.
		tree = [];
	}

	const currentNode = tree.find((node) => node.slug === currentSlug) ?? null;
	if (currentNode) {
		// Walk up to the docs root (parentId === null). The root itself
		// might *be* the current page (visiting the section's landing
		// page), a category, or a leaf doc page.
		let docsRoot = currentNode;
		const visited = new Set<string>([docsRoot.id]);
		while (docsRoot.parentId) {
			const parent = tree.find((node) => node.id === docsRoot.parentId);
			if (!parent || visited.has(parent.id)) break;
			docsRoot = parent;
			visited.add(docsRoot.id);
		}

		const categories = tree
			.filter((node) => node.parentId === docsRoot.id)
			.sort(byOrderThenCreatedAtAsc);
		sidebarGroups = categories
			.map((category) => ({
				title: category.title,
				items: tree
					.filter((node) => node.parentId === category.id)
					.sort(byOrderThenCreatedAtAsc)
					.map(toSidebarNode),
			}))
			.filter((group) => group.items.length > 0);
	}
}
const hasSidebar = sidebarGroups.length > 0;
const flatDocs = sidebarGroups.flatMap((group) => group.items);
const currentDocIndex = flatDocs.findIndex((node) => node.slug === currentSlug);
const prevDoc = currentDocIndex > 0 ? flatDocs[currentDocIndex - 1] : null;
const nextDoc =
	currentDocIndex >= 0 && currentDocIndex < flatDocs.length - 1
		? flatDocs[currentDocIndex + 1]
		: null;
---

<html lang={locale} dir={localeDirection(locale)}>
	<head>
		<meta charset="utf-8" />
		{
			theme.faviconUrl ? (
				<link rel="icon" href={theme.faviconUrl} />
			) : (
				<>
					<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
					<link rel="icon" href="/favicon.ico" />
				</>
			)
		}
		<meta name="viewport" content="width=device-width" />
		{
			// This theme's own default font (Sora, theme.css's --font-sans-value)
			// — themes ship no font-loading mechanism of their own, only the
			// Tier 1 site-override path below does, so without this the token
			// would silently fall back to the system stack. Skipped when the
			// site has its own Tier 1 font override (themeFont below already
			// covers that case, no reason to load both families).
			!themeFont && (
				<>
					<link rel="preconnect" href="https://fonts.googleapis.com" />
					<link
						rel="preconnect"
						href="https://fonts.gstatic.com"
						crossorigin
					/>
					<link
						rel="stylesheet"
						href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap"
					/>
				</>
			)
		}
		{
			themeFont && (
				<>
					<link rel="preconnect" href="https://fonts.googleapis.com" />
					<link
						rel="preconnect"
						href="https://fonts.gstatic.com"
						crossorigin
					/>
					<link
						rel="stylesheet"
						href={`https://fonts.googleapis.com/css2?family=${themeFont.googleFontsFamily}&display=swap`}
					/>
				</>
			)
		}
		{
			themeOverrideDeclarations && (
				<style set:html={`:root { ${themeOverrideDeclarations} }`} />
			)
		}
		{
			blockStyleOverridesCss && <style set:html={blockStyleOverridesCss} />
		}
		<meta name="generator" content={Astro.generator} />
		<title>{seoMeta.title}</title>
		<meta name="description" content={seoMeta.description} />
		{seoMeta.canonical && <link rel="canonical" href={seoMeta.canonical} />}
		{
			!site.searchEngineIndexingEnabled && (
				<meta name="robots" content="noindex, nofollow" />
			)
		}
		{
			translations.map((translation) => (
				<link
					rel="alternate"
					hreflang={translation.locale}
					href={`${Astro.url.origin}${localePath(translation.locale, translation.slug)}`}
				/>
			))
		}
		{
			defaultTranslation && (
				<link
					rel="alternate"
					hreflang="x-default"
					href={`${Astro.url.origin}${localePath(defaultTranslation.locale, defaultTranslation.slug)}`}
				/>
			)
		}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={seoMeta.title} />
		<meta property="og:description" content={seoMeta.description} />
		<meta property="og:url" content={pageUrl} />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta
			name="twitter:card"
			content={ogImage ? 'summary_large_image' : 'summary'}
		/>
		<meta name="twitter:title" content={seoMeta.title} />
		<meta name="twitter:description" content={seoMeta.description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<script is:inline type="application/ld+json" set:html={schemaOrgJson} />

		{theme.customCss && <style set:html={theme.customCss} />}
		{theme.headScript && <Fragment set:html={theme.headScript} />}
	</head>
	<body data-brisk-editor-app-url={editable ? editorAppUrl() : undefined}>
		{
			header && (
				<header
					class:list={[
						'border-b border-border bg-background px-6 py-4',
						{ 'brisk-header--sticky': headerSticky },
					]}
				>
					<div class="flex flex-col gap-3">
						{header.map((block) => (
							<BlockRenderer
								block={block}
								locale={locale}
								translations={translations}
								site={site}
								ancestors={ancestors}
								currentPageTitle={seoMeta.title}
								editable={editable}
							/>
						))}
					</div>
				</header>
			)
		}
		{
			hasSidebar ? (
				<div class="brisk-docs-shell">
					<nav class="brisk-docs-sidebar" aria-label={i18n.t('docs.sidebarLabel')}>
						{sidebarGroups.map((group) => (
							<div class="brisk-docs-sidebar__group">
								<div class="brisk-docs-sidebar__title">{group.title}</div>
								<ul class="brisk-docs-sidebar__list">
									{group.items.map((item) => (
										<li>
											<a
												href={item.href}
												aria-current={item.slug === currentSlug ? 'page' : undefined}
											>
												{item.title}
											</a>
										</li>
									))}
								</ul>
							</div>
						))}
					</nav>
					<div class="brisk-docs-shell__content">
						<slot />
						<nav class="brisk-docs-pagination" aria-label={i18n.t('docsPagination.navLabel')}>
							{prevDoc ? (
								<a class="brisk-docs-pagination__link brisk-docs-pagination__link--prev" href={prevDoc.href}>
									<span class="brisk-docs-pagination__label">{i18n.t('docsPagination.prev')}</span>
									<span class="brisk-docs-pagination__title">{prevDoc.title}</span>
								</a>
							) : (
								<span />
							)}
							{nextDoc && (
								<a class="brisk-docs-pagination__link brisk-docs-pagination__link--next" href={nextDoc.href}>
									<span class="brisk-docs-pagination__label">{i18n.t('docsPagination.next')}</span>
									<span class="brisk-docs-pagination__title">{nextDoc.title}</span>
								</a>
							)}
						</nav>
					</div>
				</div>
			) : (
				<slot />
			)
		}
		{
			footer && (
				<footer class="brisk-footer border-t border-border bg-secondary px-6 py-12">
					<div class="flex flex-col gap-3">
						{footer.map((block) => (
							<BlockRenderer
								block={block}
								locale={locale}
								translations={translations}
								site={site}
								ancestors={ancestors}
								currentPageTitle={seoMeta.title}
								editable={editable}
							/>
						))}
					</div>
				</footer>
			)
		}
		{theme.bodyScript && <Fragment set:html={theme.bodyScript} />}
		{
			editable && (
				<script>
					import { initPreviewBridge } from '../../apps/public-site/src/lib/init-preview-bridge';
					initPreviewBridge();
				</script>
			)
		}
	</body>
</html>

<style is:global>
	/* Standard sticky-footer trick: a short page's content (many docs pages
	   have just a few short paragraphs) previously left the footer sitting
	   right below the content instead of pinned to the viewport bottom —
	   `<body>` had no flex layout at all, so there was nothing pushing it
	   down. `margin-top: auto` on the footer does the pushing; `min-height:
	   100vh` gives it room to push into on a short page, and doesn't
	   interfere on a tall one (flex only grows, never shrinks content). Not
	   scoped (`is:global` on this style block) because `<body>` itself
	   lives above the `---` fence in this same file, not inside a
	   component Astro would apply a scope attribute to as a child.
	*/
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	.brisk-footer {
		margin-top: auto;
	}
</style>

<style>
	.brisk-header--sticky {
		position: sticky;
		top: 0;
		z-index: 40;
	}
	.brisk-docs-shell {
		display: grid;
		grid-template-columns: 16rem minmax(0, 1fr);
		gap: 2.5rem;
		max-width: 72rem;
		margin: 0 auto;
		padding: 2.5rem 1.5rem;
	}
	.brisk-docs-sidebar__group + .brisk-docs-sidebar__group {
		margin-top: 1.5rem;
	}
	.brisk-docs-sidebar__title {
		font-weight: 700;
		font-size: 0.9375rem;
		margin-bottom: 0.75rem;
	}
	.brisk-docs-sidebar__list {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		list-style: none;
		padding: 0;
		margin: 0;
		border-left: 2px solid var(--border);
	}
	.brisk-docs-sidebar__list a {
		display: block;
		padding: 0.375rem 0.875rem;
		margin-left: -2px;
		border-left: 2px solid transparent;
		font-size: 0.875rem;
		color: var(--muted-foreground);
		text-decoration: none;
	}
	.brisk-docs-sidebar__list a:hover {
		color: var(--foreground);
	}
	.brisk-docs-sidebar__list a[aria-current='page'] {
		border-left-color: var(--primary);
		color: var(--primary);
		font-weight: 600;
	}
	.brisk-docs-pagination {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	.brisk-docs-pagination__link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-width: 45%;
		text-decoration: none;
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		border: 1px solid var(--border);
	}
	.brisk-docs-pagination__link:hover {
		border-color: var(--primary);
	}
	.brisk-docs-pagination__link--next {
		margin-left: auto;
		text-align: right;
		align-items: flex-end;
	}
	.brisk-docs-pagination__label {
		font-size: 0.75rem;
		color: var(--muted-foreground);
	}
	.brisk-docs-pagination__title {
		font-weight: 600;
		color: var(--primary);
	}
	@media (max-width: 800px) {
		.brisk-docs-shell {
			grid-template-columns: 1fr;
		}
	}
</style>
