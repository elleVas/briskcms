{
  "name": "@brisk/theme-classic",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "app"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc --build tsconfig.json --emitDeclarationOnly && astro check --tsconfig tsconfig.astro.json",
        "options": {
          "cwd": "themes/classic"
        }
      }
    }
  },
  "dependencies": {
    "@brisk/block-registry": "workspace:*",
    "@brisk/block-sdk": "workspace:*",
    "@brisk/shared-types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "astro": "^7.2.9"
  }
}
