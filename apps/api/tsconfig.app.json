{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "express", "cookie-parser"],
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/shared-types/tsconfig.lib.json"
    },
    {
      "path": "../../libs/adapters/session-auth-adapter/tsconfig.lib.json"
    },
    {
      "path": "../../libs/adapters/postgres-user-repository/tsconfig.lib.json"
    },
    {
      "path": "../../libs/adapters/postgres-page-repository/tsconfig.lib.json"
    },
    {
      "path": "../../libs/adapters/postgres-db/tsconfig.lib.json"
    },
    {
      "path": "../../libs/ports/tsconfig.lib.json"
    },
    {
      "path": "../../libs/env-config/tsconfig.lib.json"
    },
    {
      "path": "../../libs/domain-core/tsconfig.lib.json"
    },
    {
      "path": "../../libs/application/tsconfig.lib.json"
    }
  ]
}
