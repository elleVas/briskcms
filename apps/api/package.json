{
  "name": "@brisk/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js"
  },
  "nx": {
    "tags": [
      "app"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "env": {
            "NODE_ENV": "production"
          },
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "env": {
              "NODE_ENV": "development"
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@brisk/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@brisk/api:build:development"
          },
          "production": {
            "buildTarget": "@brisk/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@brisk/application": "workspace:*",
    "@brisk/brevo-newsletter": "workspace:*",
    "@brisk/domain-core": "workspace:*",
    "@brisk/env-config": "workspace:*",
    "@brisk/filesystem-theme-catalog": "workspace:*",
    "@brisk/local-disk-attachment-storage": "workspace:*",
    "@brisk/local-disk-media-storage": "workspace:*",
    "@brisk/mailchimp-newsletter": "workspace:*",
    "@brisk/opaque-token": "workspace:*",
    "@brisk/ports": "workspace:*",
    "@brisk/postgres-dashboard-stats-repository": "workspace:*",
    "@brisk/postgres-db": "workspace:*",
    "@brisk/postgres-form-repository": "workspace:*",
    "@brisk/postgres-media-repository": "workspace:*",
    "@brisk/postgres-page-repository": "workspace:*",
    "@brisk/postgres-search-repository": "workspace:*",
    "@brisk/postgres-site-layout-section-repository": "workspace:*",
    "@brisk/postgres-site-repository": "workspace:*",
    "@brisk/postgres-user-repository": "workspace:*",
    "@brisk/preview-token-adapter": "workspace:*",
    "@brisk/s3-attachment-storage": "workspace:*",
    "@brisk/s3-media-storage": "workspace:*",
    "@brisk/session-auth-adapter": "workspace:*",
    "@brisk/shared-types": "workspace:*",
    "@brisk/smtp-email-adapter": "workspace:*",
    "@brisk/turnstile-captcha": "workspace:*",
    "@brisk/verification-token-adapter": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "supertest": "^7.2.2"
  }
}
