{
  "name": "@brisk/public-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "astro check",
          "cwd": "apps/public-site"
        }
      }
    }
  },
  "dependencies": {
    "@astrojs/node": "^11.1.2",
    "@brisk/shared-types": "workspace:*",
    "astro": "^7.2.2",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "~6.0.3"
  }
}
