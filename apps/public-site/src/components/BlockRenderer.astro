// Walks `Block[]`/`children` directly — no dependency on Puck's own data
// format here, by design (see docs/adr/0007: "any consumer of page content
// that isn't the editor... can walk children directly without knowing
// anything about Puck"). Each block's own Zod schema (shared with
// @brisk/puck-config, same source of truth) validates `props` at this
// boundary instead of an `as` cast — content comes from the API as
// unvalidated JSON as far as this component is concerned.
//
// `locale`/`translations`/`site` are only used by LanguageSwitcher, which
// can be nested inside a Nav (docs/adr/0018) — threaded through every
// recursive call rather than looked up again per block, since a leaf has
// no way to reach back up to the page-level values otherwise.
// `ancestors`/`currentPageTitle` follow the same reasoning for Breadcrumb.

interface Props {
  block: Block;
  locale: string;
  translations: PublishedPageTranslation[];
  site: PublishedSite;
  ancestors: PublishedPageAncestor[];
  currentPageTitle: string;
  // Solo le rotte di preview (apps/public-site/src/pages/preview/[pageId].astro)
  // passano true — la rotta pubblicata reale non la passa mai, quindi
  // `Wrapper` sotto resta sempre `Fragment` e l'HTML pubblicato è
  // byte-identico a prima di questa prop esistere (vedi il piano
  // dell'editor visuale, Giorno 2).
  editable?: boolean;
}

const {
  block,
  locale,
  translations,
  site,
  ancestors,
  currentPageTitle,
  editable,
} = Astro.props;

interface BlockRenderContext {
  locale: string;
  translations: PublishedPageTranslation[];
  site: PublishedSite;
  ancestors: PublishedPageAncestor[];
  currentPageTitle: string;
  editable?: boolean;
}

/**
 * Un'entry per ciascuno dei 48 tipi di blocco — sostituisce il vecchio
 * dispatch `{block.type === 'X' && (<X .../>)}` ripetuto 48 volte
 * (git history di questo file). La variazione tra i tipi è tutta metadata
 * STATICA nota a scrittura del file (5 fatti indipendenti: ha
 * styleOverride? ha locale? ha figli-contenitore? ha ancestors/
 * currentPageTitle? ha translations/site?), non logica calcolata a
 * runtime — da qui la scelta di una tabella dati invece di preservare il
 * conditional. `extra` resta l'unica via di fuga, usata solo dai 2 tipi
 * (Breadcrumb, LanguageSwitcher) con props davvero uniche a loro soli.
 *
 * `<Component />` con `Component` una variabile risolta a runtime da
 * questa tabella è lo stesso pattern già usato da `Wrapper` poco sotto
 * (`editable ? 'div' : Fragment`) — non una novità per Astro in questo
 * progetto, solo applicata a un insieme di 48 invece che di 2.
 */
interface BlockDispatchEntry {
  component: AstroComponentFactory;
  schema?: { parse: (props: unknown) => Record<string, unknown> };
  styleOverride?: boolean;
  locale?: boolean;
  /** Ricorre in `block.children` — vero anche per Nav/NavDropdown/HamburgerMenu/Tab, che però NON ricevono `editable`/`hasChildren` (non sono contenitori "a slot" nello stesso senso). */
  recurseChildren?: boolean;
  /** Solo i veri contenitori (Columns/Container/Accordion/ecc.) — passa anche `editable`+`hasChildren` oltre a ricorrere nei figli. */
  containerProps?: boolean;
  extra?: (context: BlockRenderContext) => Record<string, unknown>;
}

const BLOCK_REGISTRY: Record<string, BlockDispatchEntry> = {
  Hero: { component: Hero, schema: heroPropsSchema, styleOverride: true },
  Text: { component: Text, schema: textPropsSchema, styleOverride: true },
  Image: { component: Image, schema: imagePropsSchema, locale: true },
  Gallery: { component: Gallery, schema: galleryPropsSchema, locale: true },
  Form: {
