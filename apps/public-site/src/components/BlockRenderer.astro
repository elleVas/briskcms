// Docs/adr/0041 — the one, one-time edit this file needs for a theme to
// add its own genuinely new block types (`themes/<name>/blocks/*.block.ts`)
// with zero further changes here going forward: every other line above is
// untouched by this. `Object.assign` (not a `const` reassignment) since
// `BLOCK_REGISTRY` stays a single object identity referenced by the
// dispatch code below.
Object.assign(
  BLOCK_REGISTRY,
  themeBlockRegistry(Object.keys(BLOCK_REGISTRY), themeName),
);

// `Astro.slots.has('default')` is not enough for a freshly created empty
// container: canvas-editor-shell.tsx gives it `children: []` (an empty
// array, not `undefined`) — passing that through as children (even though
// `.map` produces an empty array) makes the slot count as "filled" for
// Astro, even when it renders nothing visible. The real count has to come
// from the `Block` itself, not from the slot.
const hasChildren = Boolean(block.children?.length);

// A single wrapping point for the whole component (not one scattered
// through the ~50 arms below) — a block is always exactly one of those
// arms, never more than one, so wrapping the entire output is equivalent to
// wrapping "the" block. `display:contents` avoids by construction the "a
// real wrapper breaks the CSS grid" bug this codebase already hit once
// (Column.astro, min-width:auto) — a real wrapper here (a <div> without
// display:contents, say) would break the layout of Columns/FeatureGrid/etc.
// A known consequence: getBoundingClientRect() on a display:contents node
// is empty — preview-bridge-client.ts (read by init-preview-bridge.ts) uses Range.selectNodeContents instead.
const Wrapper = editable ? 'div' : Fragment;
const wrapperProps = editable
  ? {
      'data-brisk-block-id': block.id,
      'data-brisk-block-type': block.type,
      style: 'display:contents',
    }
  : {};

// The per-INSTANCE overrides are CSS rules now, not an inline style
// (ADR-0047 — an inline style cannot hold a media query), so the element
// they apply to needs a class of its own.
//
// On the block's OWN root element, not on a wrapper around it. A
// `display:contents` wrapper would have saved editing every styled block,
// and it does not affect layout — but it does affect SELECTORS: it sits
// between a block and its parent, so `:last-child`, `:nth-child` and `>`
// stop meaning what they meant. `.brisk-timeline-step:last-child` already
// breaks that way, and a theme may write any selector it likes against
// core blocks. Structure is not something to change quietly to save
// thirty mechanical edits.
//
// Only for a block that actually has one: a class on every block of every
// page would be bytes nobody reads, and the rule it pairs with does not
// exist.
const instanceClass =
  block.styleOverride && block.id ? blockInstanceClassName(block.id) : null;

// The variant's modifier class (ADR-0047). Computed for every block
// rather than gated by a dispatch-entry flag: the answer is `null` unless
// the block actually names a variant, and a flag here would be a second
// copy of what the descriptor already says — the kind of copy that goes
// out of date silently.
const variantClass = blockVariantClassName(block.type, block.variant);

const entry = BLOCK_REGISTRY[block.type];
const Component = entry?.component;
const context: BlockRenderContext = {
  block,
  locale,
  translations,
  site,
  ancestors,
  currentPageTitle,
  editable,
};
const parsedProps: Record<string, unknown> = entry?.schema
  ? entry.schema.parse(block.props)
  : {};
// Resolved here, once, and handed down as `iconSvg` — a block (core's or a
// theme's override of it) never reaches into the icon registry itself.
// That registry is apps-only (eager glob + lucide-static via
// import.meta.resolve), so a theme override that had to call it could not
// live outside this repo. Only blocks whose schema actually has an `icon`
// field get the prop; for everything else this is a `typeof` check and
// nothing more.
const iconName =
  typeof parsedProps['icon'] === 'string' ? parsedProps['icon'] : null;
const dispatchProps = entry
  ? {
      ...normalizeRenderedProps(block.type, parsedProps, themeName),
      ...(entry.stylable ? { instanceClass } : {}),
      ...(variantClass ? { variantClass } : {}),
      ...(entry.locale ? { locale } : {}),
      ...(entry.containerProps ? { editable, hasChildren } : {}),
      // docs/adr/0042 — always included, not gated by a dispatch-entry
      // flag like stylable/locale above: cheap to pass to every
      // block (a plain string already resolved once per render), and
      // more than one block type may want it over time (NavLink/Feature
      // do today, for icon resolution) without this table needing a new
      // capability flag added per consumer.
      themeName,
      ...(iconName ? { iconSvg: resolveIconSvg(iconName, themeName) } : {}),
      ...(entry.extra ? entry.extra(context) : {}),
    }
  : {};
---

<Wrapper {...wrapperProps}>
{
  Component && entry && (
    <Component {...dispatchProps}>
      {entry.recurseChildren &&
        block.children?.map((child) => (
          <Astro.self
            block={child}
            locale={locale}
            translations={translations}
            site={site}
            ancestors={ancestors}
            currentPageTitle={currentPageTitle}
            editable={editable}
          />
        ))}
    </Component>
  )
}
