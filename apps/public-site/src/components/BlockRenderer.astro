---
import {
  accordionItemPropsSchema,
  accordionPropsSchema,
  backToTopPropsSchema,
  bannerPropsSchema,
  beforeAfterPropsSchema,
  breadcrumbPropsSchema,
  buttonPropsSchema,
  columnsPropsSchema,
  countdownPropsSchema,
  embedHtmlPropsSchema,
  featureGridPropsSchema,
  featurePropsSchema,
  formBlockPropsSchema,
  galleryPropsSchema,
  hamburgerMenuPropsSchema,
  heroPropsSchema,
  imagePropsSchema,
  imageSliderPropsSchema,
  languageSwitcherPropsSchema,
  logoStripPropsSchema,
  mapEmbedPropsSchema,
  navDropdownPropsSchema,
  navLinkPropsSchema,
  navPropsSchema,
  newsletterSignupPropsSchema,
  pricingPlanPropsSchema,
  pricingTablePropsSchema,
  quotePropsSchema,
  ratingPropsSchema,
  searchBoxPropsSchema,
  statPropsSchema,
  statsCounterPropsSchema,
  tabPropsSchema,
  tabsPropsSchema,
  tablePropsSchema,
  teamMemberPropsSchema,
  teamPropsSchema,
  testimonialPropsSchema,
  testimonialsPropsSchema,
  timelinePropsSchema,
  timelineStepPropsSchema,
  promoBarPropsSchema,
  textPropsSchema,
  videoEmbedPropsSchema,
  whatsAppButtonPropsSchema,
  type Block,
} from '@brisk/shared-types';
import type {
  PublishedPageAncestorDto,
  PublishedPageTranslationDto,
  PublishedSiteDto,
} from '../lib/public-api-client.js';
import Accordion from './blocks/Accordion.astro';
import AccordionItem from './blocks/AccordionItem.astro';
import BackToTop from './blocks/BackToTop.astro';
import Banner from './blocks/Banner.astro';
import BeforeAfter from './blocks/BeforeAfter.astro';
import Breadcrumb from './blocks/Breadcrumb.astro';
import Button from './blocks/Button.astro';
import Column from './blocks/Column.astro';
import Columns from './blocks/Columns.astro';
import Countdown from './blocks/Countdown.astro';
import EmbedHtml from './blocks/EmbedHtml.astro';
import Feature from './blocks/Feature.astro';
import FeatureGrid from './blocks/FeatureGrid.astro';
import Form from './blocks/Form.astro';
import Gallery from './blocks/Gallery.astro';
import HamburgerMenu from './blocks/HamburgerMenu.astro';
import Hero from './blocks/Hero.astro';
import Image from './blocks/Image.astro';
import ImageSlider from './blocks/ImageSlider.astro';
import LanguageSwitcher from './blocks/LanguageSwitcher.astro';
import LogoStrip from './blocks/LogoStrip.astro';
import MapEmbed from './blocks/MapEmbed.astro';
import Nav from './blocks/Nav.astro';
import NavDropdown from './blocks/NavDropdown.astro';
import NavLink from './blocks/NavLink.astro';
import NewsletterSignup from './blocks/NewsletterSignup.astro';
import PricingPlan from './blocks/PricingPlan.astro';
import PricingTable from './blocks/PricingTable.astro';
import Quote from './blocks/Quote.astro';
import Rating from './blocks/Rating.astro';
import Stat from './blocks/Stat.astro';
import StatsCounter from './blocks/StatsCounter.astro';
import Tab from './blocks/Tab.astro';
import Tabs from './blocks/Tabs.astro';
import Table from './blocks/Table.astro';
import Team from './blocks/Team.astro';
import TeamMember from './blocks/TeamMember.astro';
import Testimonial from './blocks/Testimonial.astro';
import Testimonials from './blocks/Testimonials.astro';
import Timeline from './blocks/Timeline.astro';
import TimelineStep from './blocks/TimelineStep.astro';
import PromoBar from './blocks/PromoBar.astro';
import SearchBox from './blocks/SearchBox.astro';
import Text from './blocks/Text.astro';
import VideoEmbed from './blocks/VideoEmbed.astro';
import WhatsAppButton from './blocks/WhatsAppButton.astro';

// Walks `Block[]`/`children` directly — no dependency on Puck's own data
// format here, by design (see docs/adr/0007: "any consumer of page content
// that isn't the editor... can walk children directly without knowing
// anything about Puck"). Each block's own Zod schema (shared with
// @brisk/puck-config, same source of truth) validates `props` at this
// boundary instead of an `as` cast — content comes from the API as
// unvalidated JSON as far as this component is concerned.
//
// `locale`/`translations`/`site` are only used by LanguageSwitcher, which
// can be nested inside a Nav (docs/adr/0018) — threaded through every
// recursive call rather than looked up again per block, since a leaf has
// no way to reach back up to the page-level values otherwise.
// `ancestors`/`currentPageTitle` follow the same reasoning for Breadcrumb.

interface Props {
  block: Block;
  locale: string;
  translations: PublishedPageTranslationDto[];
  site: PublishedSiteDto;
  ancestors: PublishedPageAncestorDto[];
  currentPageTitle: string;
}

const { block, locale, translations, site, ancestors, currentPageTitle } =
  Astro.props;
---

{block.type === 'Hero' && <Hero {...heroPropsSchema.parse(block.props)} />}
{block.type === 'Text' && <Text {...textPropsSchema.parse(block.props)} />}
{block.type === 'Image' && <Image {...imagePropsSchema.parse(block.props)} />}
{
  block.type === 'Gallery' && (
    <Gallery {...galleryPropsSchema.parse(block.props)} />
  )
}
{block.type === 'Form' && <Form {...formBlockPropsSchema.parse(block.props)} />}
{block.type === 'Quote' && <Quote {...quotePropsSchema.parse(block.props)} />}
{
  block.type === 'Rating' && (
    <Rating {...ratingPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Countdown' && (
    <Countdown {...countdownPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'EmbedHtml' && (
    <EmbedHtml {...embedHtmlPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Table' && (
    <Table {...tablePropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'NavLink' && (
    <NavLink {...navLinkPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'LanguageSwitcher' && (
    <LanguageSwitcher
      {...languageSwitcherPropsSchema.parse(block.props)}
      locale={locale}
      translations={translations}
      site={site}
    />
  )
}
{
  block.type === 'Breadcrumb' && (
    <Breadcrumb
      {...breadcrumbPropsSchema.parse(block.props)}
      locale={locale}
      ancestors={ancestors}
      currentPageTitle={currentPageTitle}
    />
  )
}
{
  block.type === 'SearchBox' && (
    <SearchBox {...searchBoxPropsSchema.parse(block.props)} locale={locale} />
  )
}
{
  block.type === 'Nav' && (
    <Nav {...navPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Nav>
  )
}
{
  block.type === 'HamburgerMenu' && (
    <HamburgerMenu {...hamburgerMenuPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </HamburgerMenu>
  )
}
{
  block.type === 'NavDropdown' && (
    <NavDropdown {...navDropdownPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </NavDropdown>
  )
}
{
  block.type === 'Columns' && (
    <Columns {...columnsPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Columns>
  )
}
{
  block.type === 'Column' && (
    <Column>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Column>
  )
}
{
  block.type === 'PromoBar' && (
    <PromoBar {...promoBarPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'BackToTop' && (
    <BackToTop {...backToTopPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'WhatsAppButton' && (
    <WhatsAppButton {...whatsAppButtonPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Accordion' && (
    <Accordion {...accordionPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Accordion>
  )
}
{
  block.type === 'AccordionItem' && (
    <AccordionItem {...accordionItemPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Tabs' && (
    <Tabs {...tabsPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Tabs>
  )
}
{
  block.type === 'Tab' && (
    <Tab {...tabPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Tab>
  )
}
{
  block.type === 'Banner' && (
    <Banner {...bannerPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Button' && (
    <Button {...buttonPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'FeatureGrid' && (
    <FeatureGrid {...featureGridPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </FeatureGrid>
  )
}
{
  block.type === 'Feature' && (
    <Feature {...featurePropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'VideoEmbed' && (
    <VideoEmbed {...videoEmbedPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'MapEmbed' && (
    <MapEmbed {...mapEmbedPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'ImageSlider' && (
    <ImageSlider {...imageSliderPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'BeforeAfter' && (
    <BeforeAfter {...beforeAfterPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'LogoStrip' && (
    <LogoStrip {...logoStripPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Testimonials' && (
    <Testimonials {...testimonialsPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Testimonials>
  )
}
{
  block.type === 'Testimonial' && (
    <Testimonial {...testimonialPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Team' && (
    <Team {...teamPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Team>
  )
}
{
  block.type === 'TeamMember' && (
    <TeamMember {...teamMemberPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'PricingTable' && (
    <PricingTable {...pricingTablePropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </PricingTable>
  )
}
{
  block.type === 'PricingPlan' && (
    <PricingPlan {...pricingPlanPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'StatsCounter' && (
    <StatsCounter {...statsCounterPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </StatsCounter>
  )
}
{block.type === 'Stat' && <Stat {...statPropsSchema.parse(block.props)} />}
{
  block.type === 'Timeline' && (
    <Timeline {...timelinePropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
        />
      ))}
    </Timeline>
  )
}
{
  block.type === 'TimelineStep' && (
    <TimelineStep {...timelineStepPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'NewsletterSignup' && (
    <NewsletterSignup {...newsletterSignupPropsSchema.parse(block.props)} />
  )
}
