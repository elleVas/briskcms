import VideoEmbedCore from './blocks/VideoEmbed.astro';
const VideoEmbed = resolveThemeBlockOverride('VideoEmbed', VideoEmbedCore, themeName);
import WhatsAppButtonCore from './blocks/WhatsAppButton.astro';
const WhatsAppButton = resolveThemeBlockOverride('WhatsAppButton', WhatsAppButtonCore, themeName);

// Walks `Block[]`/`children` directly — no dependency on Puck's own data
// format here, by design (see docs/adr/0007: "any consumer of page content
// that isn't the editor... can walk children directly without knowing
// anything about Puck"). Each block's own Zod schema (shared with
// @brisk/puck-config, same source of truth) validates `props` at this
// boundary instead of an `as` cast — content comes from the API as
// unvalidated JSON as far as this component is concerned.
//
// `locale`/`translations`/`site` are only used by LanguageSwitcher, which
// can be nested inside a Nav (docs/adr/0018) — threaded through every
// recursive call rather than looked up again per block, since a leaf has
// no way to reach back up to the page-level values otherwise.
// `ancestors`/`currentPageTitle` follow the same reasoning for Breadcrumb.

interface BlockRenderContext {
  /**
   * The block being rendered. Needed by a container whose own layout
   * depends on its children — Columns resolves one grid track per child
   * column (ADR-0050), and it cannot see them from inside its `<slot/>`.
   */
  block: Block;
  locale: string;
  translations: PublishedPageTranslation[];
  site: PublishedSite;
  ancestors: PublishedPageAncestor[];
  currentPageTitle: string;
  editable?: boolean;
}

/**
 * One entry for each of the 48 block types — replacing the old
 * `{block.type === 'X' && (<X .../>)}` dispatch repeated 48 times (see this
 * file's git history). The variation between types is entirely STATIC
 * metadata known when the file is written (5 independent facts: is it
 * stylable? does it have a locale? container children? ancestors/
 * currentPageTitle? translations/site?), not logic computed at runtime —
 * hence a data table rather than preserving the conditional. `extra`
 * remains the one escape hatch, used only by the 2 types (Breadcrumb,
 * LanguageSwitcher) with props genuinely unique to them.
 *
 * `<Component />` with `Component` a variable resolved at runtime from this
 * table is the same pattern `Wrapper` just below already uses
 * (`editable ? 'div' : Fragment`) — not something new for Astro in this
 * project, just applied to a set of 48 rather than of 2.
 */
interface BlockDispatchEntry {
  component: AstroComponentFactory;
  schema?: { parse: (props: unknown) => Record<string, unknown> };
  /** The block accepts per-instance styling, so it is handed the class its generated CSS rule targets. The override itself never reaches the component: since ADR-0047 it is a stylesheet rule, not an inline attribute. */
  stylable?: boolean;
  locale?: boolean;
  /** Recurses into `block.children` — true for Nav/NavDropdown/HamburgerMenu/Tab too, which however do NOT receive `editable`/`hasChildren` (they are not "slot" containers in the same sense). */
  recurseChildren?: boolean;
  /** Real containers only (Columns/Container/Accordion/etc.) — they also receive `editable`+`hasChildren` on top of recursing into their children. */
  containerProps?: boolean;
  extra?: (context: BlockRenderContext) => Record<string, unknown>;
}

const BLOCK_REGISTRY: Record<string, BlockDispatchEntry> = {
  Hero: { component: Hero, schema: heroPropsSchema, stylable: true },
  Heading: {
    component: Heading,
    schema: headingPropsSchema,
    stylable: true,
  },
  Text: { component: Text, schema: textPropsSchema, stylable: true },
  Image: {
    component: Image,
    schema: imagePropsSchema,
    locale: true,
    stylable: true,
  },
  Gallery: {
    component: Gallery,
    schema: galleryPropsSchema,
    locale: true,
    stylable: true,
  },
  Form: {
    component: Form,
    schema: formBlockPropsSchema,
    stylable: true,
    locale: true,
  },
  Quote: { component: Quote, schema: quotePropsSchema, stylable: true },
  Callout: { component: Callout, schema: calloutPropsSchema, stylable: true },
  Rating: { component: Rating, schema: ratingPropsSchema, stylable: true },
  Countdown: {
    component: Countdown,
    schema: countdownPropsSchema,
    stylable: true,
    locale: true,
  },
  EmbedHtml: {
    component: EmbedHtml,
    schema: embedHtmlPropsSchema,
    stylable: true,
  },
  Code: {
    component: Code,
    schema: codePropsSchema,
    stylable: true,
  },
  Table: { component: Table, schema: tablePropsSchema, stylable: true },
  NavLink: { component: NavLink, schema: navLinkPropsSchema, stylable: true },
  LanguageSwitcher: {
    component: LanguageSwitcher,
    schema: languageSwitcherPropsSchema,
    locale: true,
    extra: (ctx) => ({ translations: ctx.translations, site: ctx.site }),
    stylable: true,
  },
  Breadcrumb: {
    component: Breadcrumb,
    schema: breadcrumbPropsSchema,
    locale: true,
    extra: (ctx) => ({
      ancestors: ctx.ancestors,
      currentPageTitle: ctx.currentPageTitle,
    }),
    stylable: true,
  },
  SearchBox: {
    component: SearchBox,
    schema: searchBoxPropsSchema,
    locale: true,
    stylable: true,
  },
  Nav: {
    component: Nav,
    schema: navPropsSchema,
    recurseChildren: true,
    stylable: true,
  },
  HamburgerMenu: {
    component: HamburgerMenu,
    schema: hamburgerMenuPropsSchema,
    locale: true,
    stylable: true,
    recurseChildren: true,
  },
  NavDropdown: {
    component: NavDropdown,
    schema: navDropdownPropsSchema,
    stylable: true,
    recurseChildren: true,
  },
  Divider: { component: Divider, schema: dividerPropsSchema, stylable: true },
  VideoFile: {
    component: VideoFile,
    schema: videoFilePropsSchema,
    stylable: true,
  },
  Audio: { component: Audio, schema: audioPropsSchema, stylable: true },
  Spacer: { component: Spacer, schema: spacerPropsSchema, stylable: true },
  Icon: { component: Icon, schema: iconPropsSchema, stylable: true },
  SocialLinks: {
    component: SocialLinks,
    schema: socialLinksPropsSchema,
    stylable: true,
    recurseChildren: true,
    containerProps: true,
    locale: true,
  },
  SocialLink: {
    component: SocialLink,
    schema: socialLinkPropsSchema,
    stylable: true,
  },
  Slider: {
    component: Slider,
    schema: sliderPropsSchema,
    stylable: true,
    recurseChildren: true,
    containerProps: true,
    locale: true,
  },
  Columns: {
    component: Columns,
    schema: columnsPropsSchema,
    stylable: true,
    recurseChildren: true,
    containerProps: true,
    // One track per child column, resolved together: a column with no
    // width of its own takes an equal share of what the others left, so
    // the answer depends on all of them at once (ADR-0050).
    extra: (ctx) => ({ columnSpans: resolveColumnSpans(ctx.block.children) }),
  },
  Column: {
    component: Column,
    stylable: true,
    recurseChildren: true,
    containerProps: true,
  },
  Container: {
    component: Container,
    schema: containerPropsSchema,
    stylable: true,
    recurseChildren: true,
    containerProps: true,
  },
  PromoBar: {
    component: PromoBar,
    schema: promoBarPropsSchema,
    stylable: true,
    locale: true,
  },
  BackToTop: {
    component: BackToTop,
    schema: backToTopPropsSchema,
    locale: true,
    stylable: true,
  },
  WhatsAppButton: {
