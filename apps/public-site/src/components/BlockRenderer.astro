---
import {
  accordionItemPropsSchema,
  accordionPropsSchema,
  backToTopPropsSchema,
  bannerPropsSchema,
  beforeAfterPropsSchema,
  breadcrumbPropsSchema,
  buttonPropsSchema,
  columnsPropsSchema,
  containerPropsSchema,
  countdownPropsSchema,
  embedHtmlPropsSchema,
  featureGridPropsSchema,
  featurePropsSchema,
  formBlockPropsSchema,
  galleryPropsSchema,
  hamburgerMenuPropsSchema,
  heroPropsSchema,
  imagePropsSchema,
  imageSliderPropsSchema,
  languageSwitcherPropsSchema,
  linkPropsSchema,
  logoStripPropsSchema,
  mapEmbedPropsSchema,
  navDropdownPropsSchema,
  navLinkPropsSchema,
  navPropsSchema,
  newsletterSignupPropsSchema,
  pricingPlanPropsSchema,
  pricingTablePropsSchema,
  quotePropsSchema,
  ratingPropsSchema,
  searchBoxPropsSchema,
  statPropsSchema,
  statsCounterPropsSchema,
  tabPropsSchema,
  tabsPropsSchema,
  tablePropsSchema,
  teamMemberPropsSchema,
  teamPropsSchema,
  testimonialPropsSchema,
  testimonialsPropsSchema,
  timelinePropsSchema,
  timelineStepPropsSchema,
  promoBarPropsSchema,
  textPropsSchema,
  videoEmbedPropsSchema,
