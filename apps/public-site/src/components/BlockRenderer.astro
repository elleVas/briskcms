---
import {
  accordionItemPropsSchema,
  accordionPropsSchema,
  backToTopPropsSchema,
  bannerPropsSchema,
  buttonPropsSchema,
  columnsPropsSchema,
  countdownPropsSchema,
  embedHtmlPropsSchema,
  featureGridPropsSchema,
  featurePropsSchema,
  formBlockPropsSchema,
  galleryPropsSchema,
  hamburgerMenuPropsSchema,
  heroPropsSchema,
  imagePropsSchema,
  languageSwitcherPropsSchema,
  navDropdownPropsSchema,
  navLinkPropsSchema,
  navPropsSchema,
  quotePropsSchema,
  ratingPropsSchema,
  searchBoxPropsSchema,
  tabPropsSchema,
  tabsPropsSchema,
  tablePropsSchema,
  promoBarPropsSchema,
  textPropsSchema,
  whatsAppButtonPropsSchema,
  type Block,
} from '@brisk/shared-types';
import type {
  PublishedPageTranslationDto,
  PublishedSiteDto,
} from '../lib/public-api-client.js';
import Accordion from './blocks/Accordion.astro';
import AccordionItem from './blocks/AccordionItem.astro';
import BackToTop from './blocks/BackToTop.astro';
import Banner from './blocks/Banner.astro';
import Button from './blocks/Button.astro';
import Column from './blocks/Column.astro';
import Columns from './blocks/Columns.astro';
import Countdown from './blocks/Countdown.astro';
import EmbedHtml from './blocks/EmbedHtml.astro';
import Feature from './blocks/Feature.astro';
import FeatureGrid from './blocks/FeatureGrid.astro';
import Form from './blocks/Form.astro';
import Gallery from './blocks/Gallery.astro';
import HamburgerMenu from './blocks/HamburgerMenu.astro';
import Hero from './blocks/Hero.astro';
import Image from './blocks/Image.astro';
import LanguageSwitcher from './blocks/LanguageSwitcher.astro';
import Nav from './blocks/Nav.astro';
import NavDropdown from './blocks/NavDropdown.astro';
import NavLink from './blocks/NavLink.astro';
import Quote from './blocks/Quote.astro';
import Rating from './blocks/Rating.astro';
import Tab from './blocks/Tab.astro';
import Tabs from './blocks/Tabs.astro';
import Table from './blocks/Table.astro';
import PromoBar from './blocks/PromoBar.astro';
import SearchBox from './blocks/SearchBox.astro';
import Text from './blocks/Text.astro';
import WhatsAppButton from './blocks/WhatsAppButton.astro';

// Walks `Block[]`/`children` directly — no dependency on Puck's own data
// format here, by design (see docs/adr/0007: "any consumer of page content
// that isn't the editor... can walk children directly without knowing
// anything about Puck"). Each block's own Zod schema (shared with
// @brisk/puck-config, same source of truth) validates `props` at this
// boundary instead of an `as` cast — content comes from the API as
// unvalidated JSON as far as this component is concerned.
//
// `locale`/`translations`/`site` are only used by LanguageSwitcher, which
// can be nested inside a Nav (docs/adr/0018) — threaded through every
// recursive call rather than looked up again per block, since a leaf has
// no way to reach back up to the page-level values otherwise.

interface Props {
  block: Block;
  locale: string;
  translations: PublishedPageTranslationDto[];
  site: PublishedSiteDto;
}

const { block, locale, translations, site } = Astro.props;
---

{block.type === 'Hero' && <Hero {...heroPropsSchema.parse(block.props)} />}
{block.type === 'Text' && <Text {...textPropsSchema.parse(block.props)} />}
{block.type === 'Image' && <Image {...imagePropsSchema.parse(block.props)} />}
{
  block.type === 'Gallery' && (
    <Gallery {...galleryPropsSchema.parse(block.props)} />
  )
}
{block.type === 'Form' && <Form {...formBlockPropsSchema.parse(block.props)} />}
{block.type === 'Quote' && <Quote {...quotePropsSchema.parse(block.props)} />}
{
  block.type === 'Rating' && (
    <Rating {...ratingPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Countdown' && (
    <Countdown {...countdownPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'EmbedHtml' && (
    <EmbedHtml {...embedHtmlPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Table' && (
    <Table {...tablePropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'NavLink' && (
    <NavLink {...navLinkPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'LanguageSwitcher' && (
    <LanguageSwitcher
      {...languageSwitcherPropsSchema.parse(block.props)}
      locale={locale}
      translations={translations}
      site={site}
    />
  )
}
{
  block.type === 'SearchBox' && (
    <SearchBox {...searchBoxPropsSchema.parse(block.props)} locale={locale} />
  )
}
{
  block.type === 'Nav' && (
    <Nav {...navPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </Nav>
  )
}
{
  block.type === 'HamburgerMenu' && (
    <HamburgerMenu {...hamburgerMenuPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </HamburgerMenu>
  )
}
{
  block.type === 'NavDropdown' && (
    <NavDropdown {...navDropdownPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </NavDropdown>
  )
}
{
  block.type === 'Columns' && (
    <Columns {...columnsPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </Columns>
  )
}
{
  block.type === 'Column' && (
    <Column>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </Column>
  )
}
{
  block.type === 'PromoBar' && (
    <PromoBar {...promoBarPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'BackToTop' && (
    <BackToTop {...backToTopPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'WhatsAppButton' && (
    <WhatsAppButton {...whatsAppButtonPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Accordion' && (
    <Accordion {...accordionPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </Accordion>
  )
}
{
  block.type === 'AccordionItem' && (
    <AccordionItem {...accordionItemPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Tabs' && (
    <Tabs {...tabsPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </Tabs>
  )
}
{
  block.type === 'Tab' && (
    <Tab {...tabPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </Tab>
  )
}
{
  block.type === 'Banner' && (
    <Banner {...bannerPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Button' && (
    <Button {...buttonPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'FeatureGrid' && (
    <FeatureGrid {...featureGridPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
        />
      ))}
    </FeatureGrid>
  )
}
{
  block.type === 'Feature' && (
    <Feature {...featurePropsSchema.parse(block.props)} />
  )
}
