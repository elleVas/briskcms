    schema: formBlockPropsSchema,
    styleOverride: true,
    locale: true,
  },
  Quote: { component: Quote, schema: quotePropsSchema, styleOverride: true },
  Callout: { component: Callout, schema: calloutPropsSchema },
  Rating: { component: Rating, schema: ratingPropsSchema, styleOverride: true },
  Countdown: {
