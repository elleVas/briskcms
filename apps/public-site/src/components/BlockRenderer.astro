    locale: true,
    stylable: true,
  },
  LogoStrip: {
    component: LogoStrip,
    schema: logoStripPropsSchema,
    stylable: true,
    locale: true,
  },
  Testimonials: {
    component: Testimonials,
    schema: testimonialsPropsSchema,
    stylable: true,
    locale: true,
    recurseChildren: true,
    containerProps: true,
  },
  Testimonial: {
    component: Testimonial,
    schema: testimonialPropsSchema,
    stylable: true,
  },
  Team: {
    component: Team,
    schema: teamPropsSchema,
    stylable: true,
    recurseChildren: true,
    containerProps: true,
    locale: true,
  },
  TeamMember: {
    component: TeamMember,
