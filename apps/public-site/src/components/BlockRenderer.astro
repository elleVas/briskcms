}

const {
  block,
  locale,
  translations,
  site,
  ancestors,
  currentPageTitle,
  editable,
} = Astro.props;
// docs/adr/0042 — read here, before any of the resolveThemeBlockOverride
// calls below, since every one of them needs it. Derived from `site`
// (already threaded through every recursive <Astro.self> call further
// down) rather than a second, parallel prop — a block never needs a
// theme different from the site it's rendering for.
const themeName = site.themeName;

