} from '../lib/public-api-client.js';
import { resolveThemeBlockOverride } from '../lib/resolve-theme-block-override.js';
import AccordionCore from './blocks/Accordion.astro';
const Accordion = resolveThemeBlockOverride('Accordion', AccordionCore);
import AccordionItemCore from './blocks/AccordionItem.astro';
const AccordionItem = resolveThemeBlockOverride('AccordionItem', AccordionItemCore);
import BackToTopCore from './blocks/BackToTop.astro';
const BackToTop = resolveThemeBlockOverride('BackToTop', BackToTopCore);
import BannerCore from './blocks/Banner.astro';
const Banner = resolveThemeBlockOverride('Banner', BannerCore);
import BeforeAfterCore from './blocks/BeforeAfter.astro';
const BeforeAfter = resolveThemeBlockOverride('BeforeAfter', BeforeAfterCore);
import BreadcrumbCore from './blocks/Breadcrumb.astro';
const Breadcrumb = resolveThemeBlockOverride('Breadcrumb', BreadcrumbCore);
import ButtonCore from './blocks/Button.astro';
const Button = resolveThemeBlockOverride('Button', ButtonCore);
import ColumnCore from './blocks/Column.astro';
const Column = resolveThemeBlockOverride('Column', ColumnCore);
import ColumnsCore from './blocks/Columns.astro';
const Columns = resolveThemeBlockOverride('Columns', ColumnsCore);
import ContainerCore from './blocks/Container.astro';
const Container = resolveThemeBlockOverride('Container', ContainerCore);
import CountdownCore from './blocks/Countdown.astro';
const Countdown = resolveThemeBlockOverride('Countdown', CountdownCore);
import EmbedHtmlCore from './blocks/EmbedHtml.astro';
const EmbedHtml = resolveThemeBlockOverride('EmbedHtml', EmbedHtmlCore);
import FeatureCore from './blocks/Feature.astro';
const Feature = resolveThemeBlockOverride('Feature', FeatureCore);
import FeatureGridCore from './blocks/FeatureGrid.astro';
const FeatureGrid = resolveThemeBlockOverride('FeatureGrid', FeatureGridCore);
import FormCore from './blocks/Form.astro';
const Form = resolveThemeBlockOverride('Form', FormCore);
import GalleryCore from './blocks/Gallery.astro';
const Gallery = resolveThemeBlockOverride('Gallery', GalleryCore);
import HamburgerMenuCore from './blocks/HamburgerMenu.astro';
const HamburgerMenu = resolveThemeBlockOverride('HamburgerMenu', HamburgerMenuCore);
import HeroCore from './blocks/Hero.astro';
const Hero = resolveThemeBlockOverride('Hero', HeroCore);
import ImageCore from './blocks/Image.astro';
const Image = resolveThemeBlockOverride('Image', ImageCore);
import ImageSliderCore from './blocks/ImageSlider.astro';
const ImageSlider = resolveThemeBlockOverride('ImageSlider', ImageSliderCore);
import LanguageSwitcherCore from './blocks/LanguageSwitcher.astro';
const LanguageSwitcher = resolveThemeBlockOverride('LanguageSwitcher', LanguageSwitcherCore);
import LinkCore from './blocks/Link.astro';
const Link = resolveThemeBlockOverride('Link', LinkCore);
import LogoStripCore from './blocks/LogoStrip.astro';
const LogoStrip = resolveThemeBlockOverride('LogoStrip', LogoStripCore);
import MapEmbedCore from './blocks/MapEmbed.astro';
const MapEmbed = resolveThemeBlockOverride('MapEmbed', MapEmbedCore);
import NavCore from './blocks/Nav.astro';
const Nav = resolveThemeBlockOverride('Nav', NavCore);
import NavDropdownCore from './blocks/NavDropdown.astro';
const NavDropdown = resolveThemeBlockOverride('NavDropdown', NavDropdownCore);
import NavLinkCore from './blocks/NavLink.astro';
const NavLink = resolveThemeBlockOverride('NavLink', NavLinkCore);
import NewsletterSignupCore from './blocks/NewsletterSignup.astro';
const NewsletterSignup = resolveThemeBlockOverride('NewsletterSignup', NewsletterSignupCore);
import PricingPlanCore from './blocks/PricingPlan.astro';
const PricingPlan = resolveThemeBlockOverride('PricingPlan', PricingPlanCore);
import PricingTableCore from './blocks/PricingTable.astro';
const PricingTable = resolveThemeBlockOverride('PricingTable', PricingTableCore);
import QuoteCore from './blocks/Quote.astro';
const Quote = resolveThemeBlockOverride('Quote', QuoteCore);
import RatingCore from './blocks/Rating.astro';
const Rating = resolveThemeBlockOverride('Rating', RatingCore);
import StatCore from './blocks/Stat.astro';
const Stat = resolveThemeBlockOverride('Stat', StatCore);
import StatsCounterCore from './blocks/StatsCounter.astro';
const StatsCounter = resolveThemeBlockOverride('StatsCounter', StatsCounterCore);
import TabCore from './blocks/Tab.astro';
const Tab = resolveThemeBlockOverride('Tab', TabCore);
import TabsCore from './blocks/Tabs.astro';
const Tabs = resolveThemeBlockOverride('Tabs', TabsCore);
import TableCore from './blocks/Table.astro';
const Table = resolveThemeBlockOverride('Table', TableCore);
import TeamCore from './blocks/Team.astro';
const Team = resolveThemeBlockOverride('Team', TeamCore);
import TeamMemberCore from './blocks/TeamMember.astro';
const TeamMember = resolveThemeBlockOverride('TeamMember', TeamMemberCore);
import TestimonialCore from './blocks/Testimonial.astro';
const Testimonial = resolveThemeBlockOverride('Testimonial', TestimonialCore);
import TestimonialsCore from './blocks/Testimonials.astro';
const Testimonials = resolveThemeBlockOverride('Testimonials', TestimonialsCore);
import TimelineCore from './blocks/Timeline.astro';
const Timeline = resolveThemeBlockOverride('Timeline', TimelineCore);
import TimelineStepCore from './blocks/TimelineStep.astro';
const TimelineStep = resolveThemeBlockOverride('TimelineStep', TimelineStepCore);
import PromoBarCore from './blocks/PromoBar.astro';
const PromoBar = resolveThemeBlockOverride('PromoBar', PromoBarCore);
import SearchBoxCore from './blocks/SearchBox.astro';
const SearchBox = resolveThemeBlockOverride('SearchBox', SearchBoxCore);
import TextCore from './blocks/Text.astro';
const Text = resolveThemeBlockOverride('Text', TextCore);
import VideoEmbedCore from './blocks/VideoEmbed.astro';
const VideoEmbed = resolveThemeBlockOverride('VideoEmbed', VideoEmbedCore);
import WhatsAppButtonCore from './blocks/WhatsAppButton.astro';
const WhatsAppButton = resolveThemeBlockOverride('WhatsAppButton', WhatsAppButtonCore);

// Walks `Block[]`/`children` directly — no dependency on Puck's own data
// format here, by design (see docs/adr/0007: "any consumer of page content
// that isn't the editor... can walk children directly without knowing
// anything about Puck"). Each block's own Zod schema (shared with
// @brisk/puck-config, same source of truth) validates `props` at this
// boundary instead of an `as` cast — content comes from the API as
// unvalidated JSON as far as this component is concerned.
//
// `locale`/`translations`/`site` are only used by LanguageSwitcher, which
// can be nested inside a Nav (docs/adr/0018) — threaded through every
// recursive call rather than looked up again per block, since a leaf has
// no way to reach back up to the page-level values otherwise.
// `ancestors`/`currentPageTitle` follow the same reasoning for Breadcrumb.

interface Props {
  block: Block;
  locale: string;
  translations: PublishedPageTranslationDto[];
  site: PublishedSiteDto;
  ancestors: PublishedPageAncestorDto[];
  currentPageTitle: string;
  // Solo le rotte di preview (apps/public-site/src/pages/preview/[pageId].astro)
  // passano true — la rotta pubblicata reale non la passa mai, quindi
  // `Wrapper` sotto resta sempre `Fragment` e l'HTML pubblicato è
  // byte-identico a prima di questa prop esistere (vedi il piano
  // dell'editor visuale, Giorno 2).
  editable?: boolean;
}

const {
  block,
  locale,
  translations,
  site,
  ancestors,
  currentPageTitle,
  editable,
} = Astro.props;

// `Astro.slots.has('default')` non basta per un contenitore appena creato
// vuoto: canvas-editor-shell.tsx gli assegna `children: []` (array vuoto,
// non `undefined`) — passarlo comunque come children (anche se `.map`
// produce un array vuoto) fa risultare lo slot "riempito" per Astro,
// anche se non renderizza nulla di visibile. Il conteggio reale va preso
// dal `Block` stesso, non dallo slot.
const hasChildren = Boolean(block.children?.length);

// Un unico punto di wrapping per l'intero componente (non uno scattered
// nei ~50 arm sotto) — un blocco è sempre esattamente uno di quegli arm,
// mai più di uno, quindi avvolgere l'intero output equivale ad avvolgere
// "il" blocco. `display:contents` evita per costruzione il bug "wrapper
// reale rompe la griglia CSS" già preso una volta in questa codebase
// (Column.astro, min-width:auto) — un wrapper vero (es. un <div> senza
// display:contents) qui romperebbe il layout di Columns/FeatureGrid/ecc.
// Conseguenza nota: getBoundingClientRect() su un nodo display:contents è
// vuoto — preview-bridge-client.ts usa Range.selectNodeContents invece.
const Wrapper = editable ? 'div' : Fragment;
const wrapperProps = editable
  ? {
      'data-brisk-block-id': block.id,
      'data-brisk-block-type': block.type,
      style: 'display:contents',
    }
  : {};
---

<Wrapper {...wrapperProps}>
{block.type === 'Hero' && <Hero {...heroPropsSchema.parse(block.props)} />}
{block.type === 'Text' && <Text {...textPropsSchema.parse(block.props)} />}
{block.type === 'Image' && <Image {...imagePropsSchema.parse(block.props)} />}
{
  block.type === 'Gallery' && (
    <Gallery {...galleryPropsSchema.parse(block.props)} />
  )
}
{block.type === 'Form' && <Form {...formBlockPropsSchema.parse(block.props)} />}
{block.type === 'Quote' && <Quote {...quotePropsSchema.parse(block.props)} />}
{
  block.type === 'Rating' && (
    <Rating {...ratingPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Countdown' && (
    <Countdown {...countdownPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'EmbedHtml' && (
    <EmbedHtml {...embedHtmlPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Table' && (
    <Table {...tablePropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'NavLink' && (
    <NavLink {...navLinkPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'LanguageSwitcher' && (
    <LanguageSwitcher
      {...languageSwitcherPropsSchema.parse(block.props)}
      locale={locale}
      translations={translations}
      site={site}
    />
  )
}
{
  block.type === 'Breadcrumb' && (
    <Breadcrumb
      {...breadcrumbPropsSchema.parse(block.props)}
      locale={locale}
      ancestors={ancestors}
      currentPageTitle={currentPageTitle}
    />
  )
}
{
  block.type === 'SearchBox' && (
    <SearchBox {...searchBoxPropsSchema.parse(block.props)} locale={locale} />
  )
}
{
  block.type === 'Nav' && (
    <Nav {...navPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Nav>
  )
}
{
  block.type === 'HamburgerMenu' && (
    <HamburgerMenu {...hamburgerMenuPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </HamburgerMenu>
  )
}
{
  block.type === 'NavDropdown' && (
    <NavDropdown {...navDropdownPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </NavDropdown>
  )
}
{
  block.type === 'Columns' && (
    <Columns {...columnsPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Columns>
  )
}
{
  block.type === 'Column' && (
    <Column editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Column>
  )
}
{
  block.type === 'Container' && (
    <Container {...containerPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Container>
  )
}
{
  block.type === 'PromoBar' && (
    <PromoBar {...promoBarPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'BackToTop' && (
    <BackToTop {...backToTopPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'WhatsAppButton' && (
    <WhatsAppButton {...whatsAppButtonPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Accordion' && (
    <Accordion {...accordionPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Accordion>
  )
}
{
  block.type === 'AccordionItem' && (
    <AccordionItem {...accordionItemPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Tabs' && (
    <Tabs {...tabsPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Tabs>
  )
}
{
  block.type === 'Tab' && (
    <Tab {...tabPropsSchema.parse(block.props)}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Tab>
  )
}
{
  block.type === 'Banner' && (
    <Banner {...bannerPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Button' && (
    <Button {...buttonPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Link' && <Link {...linkPropsSchema.parse(block.props)} />
}
{
  block.type === 'FeatureGrid' && (
    <FeatureGrid {...featureGridPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </FeatureGrid>
  )
}
{
  block.type === 'Feature' && (
    <Feature {...featurePropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'VideoEmbed' && (
    <VideoEmbed {...videoEmbedPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'MapEmbed' && (
    <MapEmbed {...mapEmbedPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'ImageSlider' && (
    <ImageSlider {...imageSliderPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'BeforeAfter' && (
    <BeforeAfter {...beforeAfterPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'LogoStrip' && (
    <LogoStrip {...logoStripPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Testimonials' && (
    <Testimonials {...testimonialsPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Testimonials>
  )
}
{
  block.type === 'Testimonial' && (
    <Testimonial {...testimonialPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'Team' && (
    <Team {...teamPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Team>
  )
}
{
  block.type === 'TeamMember' && (
    <TeamMember {...teamMemberPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'PricingTable' && (
    <PricingTable {...pricingTablePropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </PricingTable>
  )
}
{
  block.type === 'PricingPlan' && (
    <PricingPlan {...pricingPlanPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'StatsCounter' && (
    <StatsCounter {...statsCounterPropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </StatsCounter>
  )
}
{block.type === 'Stat' && <Stat {...statPropsSchema.parse(block.props)} />}
{
  block.type === 'Timeline' && (
    <Timeline {...timelinePropsSchema.parse(block.props)} editable={editable} hasChildren={hasChildren}>
      {block.children?.map((child) => (
        <Astro.self
          block={child}
          locale={locale}
          translations={translations}
          site={site}
          ancestors={ancestors}
          currentPageTitle={currentPageTitle}
          editable={editable}
        />
      ))}
    </Timeline>
  )
}
{
  block.type === 'TimelineStep' && (
    <TimelineStep {...timelineStepPropsSchema.parse(block.props)} />
  )
}
{
  block.type === 'NewsletterSignup' && (
    <NewsletterSignup {...newsletterSignupPropsSchema.parse(block.props)} />
  )
}
</Wrapper>
