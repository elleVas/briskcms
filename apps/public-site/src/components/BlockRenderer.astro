const Tabs = resolveThemeBlockOverride('Tabs', TabsCore, themeName);
import TableCore from './blocks/Table.astro';
const Table = resolveThemeBlockOverride('Table', TableCore, themeName);
import TeamCore from './blocks/Team.astro';
const Team = resolveThemeBlockOverride('Team', TeamCore, themeName);
import TeamMemberCore from './blocks/TeamMember.astro';
