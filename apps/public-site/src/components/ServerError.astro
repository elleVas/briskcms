---
import { Translator } from '../lib/i18n.js';

// Same reasoning as NotFound.astro: rendered by Astro's own top-level
// 500.astro, which has no locale context at all — an unhandled SSR
// exception can happen before the request's locale was even parsed.
interface Props {
  locale?: string;
}

const { locale } = Astro.props;
const i18n = new Translator(locale ?? 'it');
---

<html lang={locale ?? 'it'}>
	<head>
		<meta charset="utf-8" />
		<title>{i18n.t('serverError.title')}</title>
		<meta name="viewport" content="width=device-width" />
	</head>
	<body>
		<h1>500</h1>
		<p>{i18n.t('serverError.message')}</p>
	</body>
</html>
