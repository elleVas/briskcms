---
// Cookie consent banner (docs/adr/0039) — rendered directly by
// PageLayout.astro as a site-wide global, deliberately OUTSIDE the
// editable block tree (unlike BackToTop/WhatsAppButton/PromoBar, which are
// regular block-registry blocks an editor must place): it must be
// guaranteed present on every page, not something an editor could forget
// to add to header/footer. Only rendered at all when
// `settings.enabled` is true — see both PageLayout.astro call sites.
import type { CookieBannerSettings } from '@brisk/shared-types';
import { localePath } from '../lib/locale-path';
import { Translator, type TranslationKey } from '../lib/i18n';
import { COOKIE_CONSENT_DISMISS_SCRIPT } from './cookie-consent-dismiss-script';

interface Props {
  settings: CookieBannerSettings;
  locale: string;
  privacyPolicySlug: string | null;
  cookiePolicySlug: string | null;
}

const { settings, locale, privacyPolicySlug, cookiePolicySlug } = Astro.props;
const i18n = new Translator(locale);

// copyOverrides wins field-by-field over the built-in dictionary (a site
// can enable a locale, e.g. fr, the dictionary has nothing for) — see
// cookie-consent.ts's own doc comment.
const override = settings.copyOverrides[locale];
const copy = {
  title: override?.title || i18n.t('cookieConsent.title'),
  body: override?.body || i18n.t('cookieConsent.body'),
  acceptAll: override?.acceptAll || i18n.t('cookieConsent.acceptAll'),
  rejectAll: override?.rejectAll || i18n.t('cookieConsent.rejectAll'),
  customize: override?.customize || i18n.t('cookieConsent.customize'),
};

const privacyHref = privacyPolicySlug ? localePath(locale, privacyPolicySlug) : null;
const cookieHref = cookiePolicySlug ? localePath(locale, cookiePolicySlug) : null;

// Explicit list, not a dynamic `cookieConsent.category${category}` template
// key: TranslationKey is a closed union derived from the dictionary
// itself, so a typo here fails typecheck instead of silently rendering the
// raw key string at runtime.
const CATEGORIES: Array<{
  key: 'functionality' | 'measurement' | 'experience';
  label: TranslationKey;
  description: TranslationKey;
}> = [
  {
    key: 'functionality',
    label: 'cookieConsent.categoryFunctionality',
    description: 'cookieConsent.categoryFunctionalityDescription',
  },
  {
    key: 'measurement',
    label: 'cookieConsent.categoryMeasurement',
    description: 'cookieConsent.categoryMeasurementDescription',
  },
  {
    key: 'experience',
    label: 'cookieConsent.categoryExperience',
    description: 'cookieConsent.categoryExperienceDescription',
  },
];
---

<div
  class:list={['brisk-cookie-consent', `brisk-cookie-consent--${settings.position}`]}
  role="dialog"
  aria-live="polite"
  aria-label={copy.title}
  data-brisk-cookie-consent
>
  {
    /* is:inline, must run before first paint — see cookie-consent-dismiss-script.ts's
       own comment for why this is a fixed, hashable string rather than a
       per-request nonce'd one. */
  }
  <script is:inline set:html={COOKIE_CONSENT_DISMISS_SCRIPT} />
  <div class="brisk-cookie-consent__row">
    <div class="brisk-cookie-consent__copy">
      <p class="brisk-cookie-consent__title">{copy.title}</p>
      <p class="brisk-cookie-consent__body">
        {copy.body}
        {' '}
        {privacyHref && <a href={privacyHref}>{i18n.t('cookieConsent.privacyPolicyLink')}</a>}
        {privacyHref && cookieHref && ' · '}
        {cookieHref && <a href={cookieHref}>{i18n.t('cookieConsent.cookiePolicyLink')}</a>}
      </p>
    </div>
    <div
      class="brisk-cookie-consent__actions"
      data-brisk-accept-side={settings.acceptButtonSide}
    >
      <button
        type="button"
        class="brisk-cookie-consent__btn brisk-cookie-consent__btn--primary"
        data-brisk-consent-action="accept"
      >
        {copy.acceptAll}
      </button>
      <button
        type="button"
        class="brisk-cookie-consent__btn brisk-cookie-consent__btn--secondary"
        data-brisk-consent-action="customize"
      >
        {copy.customize}
      </button>
      <button
        type="button"
        class="brisk-cookie-consent__btn brisk-cookie-consent__btn--secondary"
        data-brisk-consent-action="reject"
      >
        {copy.rejectAll}
      </button>
    </div>
  </div>

  <div class="brisk-cookie-consent__panel" hidden data-brisk-consent-panel>
    <div class="brisk-cookie-consent__category">
      <label>
        <input type="checkbox" checked disabled />
        {i18n.t('cookieConsent.categoryNecessary')}
      </label>
      <p>{i18n.t('cookieConsent.categoryNecessaryDescription')}</p>
    </div>
    {
      CATEGORIES.map((category) => (
        <div class="brisk-cookie-consent__category">
          <label>
            <input type="checkbox" data-brisk-consent-category={category.key} />
            {i18n.t(category.label)}
          </label>
          <p>{i18n.t(category.description)}</p>
        </div>
      ))
    }
    <button
      type="button"
      class="brisk-cookie-consent__btn brisk-cookie-consent__btn--primary"
      data-brisk-consent-action="save"
    >
      {i18n.t('cookieConsent.save')}
    </button>
  </div>
</div>

{
  settings.showReopenTab && (
    <button
      type="button"
      class:list={[
        'brisk-cookie-consent-reopen',
        `brisk-cookie-consent-reopen--${settings.reopenPosition}`,
      ]}
      hidden
      data-brisk-consent-action="reopen"
      aria-label={i18n.t('cookieConsent.reopenLabel')}
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <circle cx="12" cy="12" r="10" fill="currentColor" />
        <circle cx="9" cy="9" r="1.3" fill="var(--background)" />
        <circle cx="14" cy="8.5" r="1" fill="var(--background)" />
        <circle cx="15" cy="13" r="1.3" fill="var(--background)" />
        <circle cx="10" cy="14.5" r="1" fill="var(--background)" />
      </svg>
    </button>
  )
}

<script>
  const CONSENT_CATEGORIES = ['functionality', 'measurement', 'experience'] as const;

  const banner = document.querySelector<HTMLElement>('[data-brisk-cookie-consent]');
  const panel = banner?.querySelector<HTMLElement>('[data-brisk-consent-panel]');
  const reopenTab = document.querySelector<HTMLElement>('.brisk-cookie-consent-reopen');

  function syncPanelCheckboxes() {
    const record = window.briskConsent.get();
    for (const category of CONSENT_CATEGORIES) {
      const input = banner?.querySelector<HTMLInputElement>(
        `[data-brisk-consent-category="${category}"]`,
      );
      if (input) {
        input.checked = record?.cats[category] ?? false;
      }
    }
  }

  function showBanner() {
    if (banner) banner.hidden = false;
    if (reopenTab) reopenTab.hidden = true;
  }

  function hideBanner() {
    if (banner) banner.hidden = true;
    if (panel) panel.hidden = true;
    if (reopenTab) reopenTab.hidden = false;
  }

  banner?.addEventListener('click', (event) => {
    const action = (event.target as HTMLElement)
      .closest<HTMLElement>('[data-brisk-consent-action]')
      ?.dataset.briskConsentAction;
    if (!action) return;

    if (action === 'accept') {
      window.briskConsent.apply({
        functionality: true,
        measurement: true,
        experience: true,
      });
      hideBanner();
    } else if (action === 'reject') {
      window.briskConsent.apply({
        functionality: false,
        measurement: false,
        experience: false,
      });
      hideBanner();
    } else if (action === 'customize') {
      syncPanelCheckboxes();
      if (panel) panel.hidden = false;
    } else if (action === 'save') {
      const prefs = { functionality: false, measurement: false, experience: false };
      for (const category of CONSENT_CATEGORIES) {
        const input = banner?.querySelector<HTMLInputElement>(
          `[data-brisk-consent-category="${category}"]`,
        );
        prefs[category] = input?.checked ?? false;
      }
      window.briskConsent.apply(prefs);
      hideBanner();
    }
  });

  reopenTab?.addEventListener('click', () => {
    showBanner();
    syncPanelCheckboxes();
    if (panel) panel.hidden = false;
  });

  document.addEventListener('brisk-consent-open-preferences', () => {
    showBanner();
    syncPanelCheckboxes();
    if (panel) panel.hidden = false;
  });
</script>

<style>
  .brisk-cookie-consent {
    position: fixed;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32rem;
    padding: 1.25rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 8px 30px rgb(0 0 0 / 15%);
  }
  .brisk-cookie-consent--bottom-bar {
    left: 0;
    right: 0;
    bottom: 0;
    max-width: none;
    border-radius: 0;
    border-left: none;
    border-right: none;
    border-bottom: none;
  }
  .brisk-cookie-consent--bottom-bar .brisk-cookie-consent__row {
    max-width: 72rem;
    margin: 0 auto;
  }
  .brisk-cookie-consent--bottom-left {
    left: 1.5rem;
    bottom: 1.5rem;
  }
  .brisk-cookie-consent--bottom-right {
    right: 1.5rem;
    bottom: 1.5rem;
  }
  .brisk-cookie-consent--center-modal {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .brisk-cookie-consent__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brisk-cookie-consent__copy {
    flex: 1 1 20rem;
  }
  .brisk-cookie-consent__title {
    margin: 0 0 0.25rem;
    font-weight: 600;
  }
  .brisk-cookie-consent__body {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .brisk-cookie-consent__body a {
    color: inherit;
    text-decoration: underline;
  }
  .brisk-cookie-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .brisk-cookie-consent__actions[data-brisk-accept-side='right'] {
    flex-direction: row-reverse;
  }
  .brisk-cookie-consent__btn {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .brisk-cookie-consent__btn--primary {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--primary-foreground);
  }
  .brisk-cookie-consent__btn--secondary {
    background: var(--background);
    color: var(--foreground);
  }
  .brisk-cookie-consent__panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .brisk-cookie-consent__category label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }
  .brisk-cookie-consent__category p {
    margin: 0.15rem 0 0 1.5rem;
    font-size: 0.8rem;
    color: var(--muted-foreground);
  }
  .brisk-cookie-consent-reopen {
    position: fixed;
    z-index: 40;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--primary);
    color: var(--primary-foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 12px rgb(0 0 0 / 20%);
  }
  .brisk-cookie-consent-reopen--bottom-left {
    left: 1.5rem;
    bottom: 1.5rem;
  }
  .brisk-cookie-consent-reopen--bottom-right {
    right: 1.5rem;
    bottom: 1.5rem;
  }
</style>
