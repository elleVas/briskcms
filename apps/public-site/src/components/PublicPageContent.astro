---
import type { PublishedPage } from '@brisk/shared-types';
import PageLayoutCore from '../layouts/PageLayout.astro';
import { resolveThemeLayoutOverride } from '../lib/resolve-theme-layout-override.js';
const PageLayout = resolveThemeLayoutOverride(PageLayoutCore);
import BlockRenderer from './BlockRenderer.astro';
import NotFound from './NotFound.astro';

// Purely presentational — the 404 status itself must be set by the calling
// page route (src/pages/index.astro, src/pages/[slug].astro), not here:
// Astro.response.status only takes effect when set in a top-level page
// component, not a nested one (verified directly — a version of this that
// set it here rendered the right NotFound markup but still answered 200).
interface Props {
  page: PublishedPage | null;
  // Solo la rotta di preview lo passa (vedi il piano dell'editor visuale,
  // Giorno 2) — la rotta pubblicata reale non lo passa mai, quindi resta
  // undefined e l'HTML pubblicato è byte-identico a prima.
  editable?: boolean;
}

const { page, editable } = Astro.props;
---

{
  page ? (
    <PageLayout
      seoMeta={page.seoMeta}
      locale={page.locale}
      translations={page.translations}
      site={page.site}
      header={page.header}
      footer={page.footer}
      headerSticky={page.headerSticky}
      ancestors={page.ancestors}
      editable={editable}
    >
      {
        // The generic baseline layout every page gets for free: a vertical
        // gap between stacked blocks, and a centered max-width column with
        // horizontal padding — before this, BlockRenderer/PageLayout
        // applied neither, so every page ran blocks together edge-to-edge
        // AND stretched full-viewport-width on a wide desktop, regardless
        // of theme. One wrapper here fixes both site-wide instead of
        // touching all ~46 block files individually. A block that
        // deliberately wants full-bleed width (e.g. a future full-width
        // Container/Section) isn't supported by this default yet — that's
        // a real, separate case to design when a block actually needs it,
        // not something to guess at now. A per-block spacing override is
        // likewise a separate, not-yet-built editor field — this is only
        // the default every block gets for free.
      }
      <main
        id="main-content"
        class="mx-auto flex max-w-5xl flex-col gap-16 px-6"
        data-brisk-root-blocks={editable ? 'page' : undefined}
      >
        {page.content.map((block) => (
          <BlockRenderer
            block={block}
            locale={page.locale}
            translations={page.translations}
            site={page.site}
            ancestors={page.ancestors}
            currentPageTitle={page.seoMeta.title}
            editable={editable}
          />
        ))}
      </main>
    </PageLayout>
  ) : (
    <NotFound />
  )
}
