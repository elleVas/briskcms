---
import type { PublishedPageDto } from '../lib/public-api-client.js';
import PageLayout from '../layouts/PageLayout.astro';
import BlockRenderer from './BlockRenderer.astro';
import NotFound from './NotFound.astro';

// Purely presentational — the 404 status itself must be set by the calling
// page route (src/pages/index.astro, src/pages/[slug].astro), not here:
// Astro.response.status only takes effect when set in a top-level page
// component, not a nested one (verified directly — a version of this that
// set it here rendered the right NotFound markup but still answered 200).
interface Props {
  page: PublishedPageDto | null;
}

const { page } = Astro.props;
---

{
  page ? (
    <PageLayout
      seoMeta={page.seoMeta}
      locale={page.locale}
      translations={page.translations}
      site={page.site}
      header={page.header}
      footer={page.footer}
      headerSticky={page.headerSticky}
      ancestors={page.ancestors}
    >
      {
        // The generic baseline gap between stacked page blocks — before
        // this, BlockRenderer/PageLayout applied zero spacing of any kind
        // between siblings, so every page ran blocks together edge-to-edge
        // regardless of theme. One wrapper here fixes it site-wide instead
        // of touching all ~46 block files individually. A per-block
        // override (a block that wants tighter/looser spacing than this
        // default) is a separate, not-yet-built editor field — this is
        // only the default every block gets for free.
      }
      <div class="flex flex-col gap-16">
        {page.content.map((block) => (
          <BlockRenderer
            block={block}
            locale={page.locale}
            translations={page.translations}
            site={page.site}
            ancestors={page.ancestors}
            currentPageTitle={page.seoMeta.title}
          />
        ))}
      </div>
    </PageLayout>
  ) : (
    <NotFound />
  )
}
