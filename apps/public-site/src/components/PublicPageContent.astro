---
import type { PublishedPage } from '@brisk/shared-types';
import PageLayout from '../layouts/PageLayout.astro';
import BlockRenderer from './BlockRenderer.astro';
import ErrorPageShell from './ErrorPageShell.astro';
import NotFound from './NotFound.astro';
import { getPublishedSiteChrome } from '../lib/public-api-client';

// Purely presentational — the 404 status itself must be set by the calling
// page route (src/pages/index.astro, src/pages/[slug].astro), not here:
// Astro.response.status only takes effect when set in a top-level page
// component, not a nested one (verified directly — a version of this that
// set it here rendered the right NotFound markup but still answered 200).
interface Props {
  page: PublishedPage | null;
  // Only the preview route passes it (see the visual editor plan, Day 2) —
  // the real published route never does, so it stays undefined and the
  // published HTML is byte-identical to before.
  editable?: boolean;
  // Only the real public routes pass it ([locale]/[...slug].astro,
  // [locale]/index.astro) — preview/[pageId].astro does not (an expired
  // token does not guarantee a reliable locale or domain to derive the site
  // chrome from, and it is not a path a real visitor sees anyway). Used
  // ONLY for the `page === null` branch below: it fetches the site's real
  // header and footer so a 404 shows the actual navigation rather than a
  // bare page — when it is missing, or the fetch fails, the long-standing
  // behaviour remains.
  locale?: string;
}

const { page, editable, locale } = Astro.props;

// Best-effort, not a second point of failure: when the site or domain does
// not exist or the API does not answer, `chrome` stays `null` and the code
// below falls back to the bare <NotFound /> as always — the same "nothing
// to show" collapse search.astro already uses for the exact same problem (a
// route with no real Page behind it).
const chrome =
  !page && locale
    ? await getPublishedSiteChrome(Astro.url.hostname, locale).catch(
        () => null,
      )
    : null;


// LanguageSwitcher resolves its links from `translations`, matched against
// `site.enabledLocales` — there's no real Page here to have real
// translations, but "switch language on a 404" only ever makes sense as
// "go to that language's Home" anyway, so this fakes exactly that: one
// fabricated translation entry per enabled locale, all pointing at "home".
// Without this the switcher silently renders nothing (0 links) on every
// themed error page — found live-testing this exact fix, not guessed.
const errorPageTranslations =
  chrome?.site.enabledLocales.map((enabledLocale) => ({
    locale: enabledLocale,
    slug: 'home',
  })) ?? [];

// The fixed gap this value replaces (see the comment below, "A block can
// customize..."): a top-level block that does not customize `marginBottom`
// gets exactly the same space as before, so the published HTML of a page
// with no overrides stays identical to what it was before this field
// existed.
const DEFAULT_BLOCK_GAP = '4rem';

function rootBlockSpacing(
  styleOverride: PublishedPage['content'][number]['styleOverride'],
  isLast: boolean,
): string {
  const marginTop = styleOverride?.marginTop ?? '0';
  // The last block gets no default gap below it — `gap` never added one
  // after the final child, and replacing it with an unconditional margin
  // would have added space at the bottom of the page that was not there
  // before. An explicit override on the last block is still honoured: only
  // the DEFAULT is zeroed, not the customization.
  const marginBottom =
    styleOverride?.marginBottom ?? (isLast ? '0' : DEFAULT_BLOCK_GAP);
  return `margin-top: ${marginTop}; margin-bottom: ${marginBottom};`;
}
---

{
  page ? (
    <PageLayout
      seoMeta={page.seoMeta}
      locale={page.locale}
      translations={page.translations}
      site={page.site}
      header={page.header}
      footer={page.footer}
      headerSticky={page.headerSticky}
      ancestors={page.ancestors}
      editable={editable}
      route="page"
    >
      {
        // The generic baseline layout every page gets for free: a vertical
        // gap between stacked blocks, and a centered max-width column with
        // horizontal padding — before this, BlockRenderer/PageLayout
        // applied neither, so every page ran blocks together edge-to-edge
        // AND stretched full-viewport-width on a wide desktop, regardless
        // of theme. One wrapper here fixes both site-wide instead of
        // touching all ~46 block files individually. A block that
        // deliberately wants full-bleed width (e.g. a future full-width
        // Container/Section) isn't supported by this default yet — that's
        // a real, separate case to design when a block actually needs it,
        // not something to guess at now.
        //
        // The vertical gap itself is `margin`, not flex `gap`, on a
        // one-per-block wrapper below (rootBlockSpacing) — this is what
        // makes it possible for a root-level block to override its own
        // spacing (docs/adr/0022's per-instance style popover,
        // "Style this block" → editor-app's block-toolbar-overlay.tsx)
        // without affecting spacing anywhere else on the page.
      }
      <main
        id="main-content"
        class="mx-auto flex max-w-5xl flex-col px-6"
        data-brisk-root-blocks={editable ? 'page' : undefined}
      >
        {page.content.map((block, index) => (
          <div
            style={rootBlockSpacing(
              block.styleOverride,
              index === page.content.length - 1,
            )}
          >
            <BlockRenderer
              block={block}
              locale={page.locale}
              translations={page.translations}
              site={page.site}
              ancestors={page.ancestors}
              currentPageTitle={page.seoMeta.title}
              editable={editable}
            />
          </div>
        ))}
      </main>
    </PageLayout>
  ) : chrome && locale ? (
    <PageLayout
      seoMeta={{ title: '404', description: '' }}
      locale={locale}
      translations={errorPageTranslations}
      site={chrome.site}
      header={chrome.header}
      footer={chrome.footer}
      headerSticky={chrome.headerSticky}
      ancestors={[]}
      route="error"
    >
      <NotFound locale={locale} />
    </PageLayout>
  ) : (
    <ErrorPageShell title="404" locale={locale}>
      <NotFound locale={locale} />
    </ErrorPageShell>
  )
}
