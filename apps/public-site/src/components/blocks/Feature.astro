---
import type { FeatureProps } from '@brisk/shared-types';

type Props = FeatureProps & {
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
  /** Already resolved by BlockRenderer — see its comment on `iconName`. */
  iconSvg?: string | null;
  themeName: string;
};

const { title, text, iconSvg, instanceClass } = Astro.props;
---

<div class:list={['brisk-feature', instanceClass]}>
  {iconSvg && <div class="brisk-feature__icon" aria-hidden="true" data-brisk-field="icon" set:html={iconSvg} />}
  <h3 class="brisk-feature__title" data-brisk-field="title">{title}</h3>
  <div class="brisk-feature__text brisk-rich-text" data-brisk-field="text" set:html={text} />
</div>

<style>
  .brisk-feature {
    text-align: center;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  .brisk-feature__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--primary);
  }
  .brisk-feature__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .brisk-feature__title {
    margin: 0.5rem 0 0;
    font-size: 1rem;
  }
  .brisk-feature__text {
    margin: 0.25rem 0 0;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }
</style>
