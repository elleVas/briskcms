---
import type {
  BreadcrumbProps,
  PublishedPageAncestor,
} from '@brisk/shared-types';
import { localePath, localePathFromAncestors } from '../../lib/locale-path.js';
import { Translator } from '../../lib/i18n.js';

interface Props extends BreadcrumbProps {
  locale: string;
  ancestors: PublishedPageAncestor[];
  currentPageTitle: string;
}

const { homeLabel, visibility, locale, ancestors, currentPageTitle } =
  Astro.props;

interface Crumb {
  title: string;
  href: string | null;
}

// Each ancestor's own href is built from the slugs of the ancestors before
// it in the chain (root-to-parent order) — the same nesting rule the
// catch-all route uses to compute a page's own canonical URL
// (locale-path.ts). The current page itself is never a link.
const crumbs: Crumb[] = [
  { title: homeLabel, href: localePath(locale, 'home') },
  ...ancestors.map((ancestor, index) => ({
    title: ancestor.title,
    href: localePathFromAncestors(
      locale,
      ancestors.slice(0, index).map((a) => a.slug),
      ancestor.slug,
    ),
  })),
  { title: currentPageTitle, href: null },
];
const i18n = new Translator(locale);
---

<nav
  class:list={[
    'brisk-breadcrumb',
    { 'brisk-visibility-desktop-only': visibility === 'desktop-only' },
    { 'brisk-visibility-mobile-only': visibility === 'mobile-only' },
  ]}
  aria-label={i18n.t('breadcrumb.label')}
>
  <ol>
    {
      crumbs.map((crumb, index) => (
        <li>
          {crumb.href ? (
            <a href={crumb.href} data-brisk-field={index === 0 ? 'homeLabel' : undefined}>
              {crumb.title}
            </a>
          ) : (
            <span aria-current="page">{crumb.title}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .brisk-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .brisk-breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .brisk-breadcrumb li:not(:first-child)::before {
    content: '›';
    color: var(--muted-foreground);
  }
  .brisk-breadcrumb a {
    color: inherit;
    text-decoration: underline;
  }
  .brisk-breadcrumb span[aria-current='page'] {
    color: var(--muted-foreground);
  }
</style>
