---
import type { FileDownloadProps } from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';

type Props = FileDownloadProps & {
  locale?: string;
  editable?: boolean;
  instanceClass?: string | null;
};

const { file, label, showDetails, locale, editable, instanceClass } = Astro.props;
const i18n = new Translator(locale ?? '');

/** "PDF", "DOCX" — the file's own extension, which is what a person recognises. */
function formatOf(filename: string | undefined, mimeType: string | undefined): string {
  const extension = filename ? /\.([a-z0-9]{1,10})$/i.exec(filename)?.[1] : undefined;
  return (extension ?? mimeType?.split('/')[1] ?? '').toUpperCase();
}

/** Sizes the way this language writes numbers: "1,2 MB" in Italian. */
function sizeOf(bytes: number | undefined): string {
  if (bytes === undefined) return '';
  const units = ['B', 'KB', 'MB', 'GB'];
  let value = bytes;
  let unit = 0;
  while (value >= 1024 && unit < units.length - 1) {
    value /= 1024;
    unit += 1;
  }
  const number = new Intl.NumberFormat(locale || undefined, {
    maximumFractionDigits: unit === 0 ? 0 : 1,
  }).format(value);
  return `${number} ${units[unit]}`;
}

const text = label.trim() || file?.filename || i18n.t('fileDownload.download');
const details = file && showDetails
  ? [formatOf(file.filename, file.mimeType), sizeOf(file.size)].filter(Boolean).join(' · ')
  : '';
---

{
  file ? (
    <a
      class:list={['brisk-file-download', instanceClass]}
      href={file.url}
      download={file.filename ?? ''}
    >
      <svg
        class="brisk-file-download__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
        <path d="M14 2v4a2 2 0 0 0 2 2h4" />
        <path d="M12 18v-6" />
        <path d="m9 15 3 3 3-3" />
      </svg>
      <span class="brisk-file-download__text">
        <span class="brisk-file-download__label" data-brisk-field="label">{text}</span>
        {details && <span class="brisk-file-download__details">{details}</span>}
      </span>
    </a>
  ) : (
    editable && (
      <p class="brisk-file-download brisk-file-download--empty">
        {i18n.t('fileDownload.empty')}
      </p>
    )
  )
}

<style>
  .brisk-file-download {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    text-decoration: none;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, var(--radius));
    padding: var(--brisk-override-padding-y, 0.75rem)
      var(--brisk-override-padding-x, 1rem);
    border-width: var(--brisk-override-border-width, 1px);
    border-style: var(--brisk-override-border-style, solid);
    border-color: var(--brisk-override-border-color, var(--border));
  }

  .brisk-file-download:hover .brisk-file-download__label,
  .brisk-file-download:focus-visible .brisk-file-download__label {
    text-decoration: underline;
  }

  .brisk-file-download__icon {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
  }

  .brisk-file-download__text {
    display: grid;
    min-width: 0;
  }

  .brisk-file-download__label {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .brisk-file-download__details {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .brisk-file-download--empty {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
