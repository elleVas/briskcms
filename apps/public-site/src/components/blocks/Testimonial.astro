---
import {
  buildBlockInstanceStyle,
  STAR_ICON_PATH,
  type BlockStyleOverride,
  type TestimonialProps,
} from '@brisk/shared-types';
import OptimizedImage from '../OptimizedImage.astro';

type Props = TestimonialProps & { styleOverride?: BlockStyleOverride };

const { quote, author, role, avatar, rating, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);

const STAR_POSITIONS = [1, 2, 3, 4, 5];
---

<div class="brisk-testimonial" style={instanceStyle}>
  <div
    class="brisk-testimonial__stars"
    role="img"
    aria-label={`${rating} su 5 stelle`}
  >
    {
      // Filled stars stay literal amber regardless of theme — same
      // reasoning as Rating.astro's own stars.
      STAR_POSITIONS.map((position) => (
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
          <path
            d={STAR_ICON_PATH}
            fill={position <= rating ? '#f59e0b' : 'var(--border)'}
          />
        </svg>
      ))
    }
  </div>
  <blockquote class="brisk-testimonial__quote" data-brisk-field="quote">{quote}</blockquote>
  <div class="brisk-testimonial__footer">
    {avatar && (
      <OptimizedImage media={avatar} alt="" class="brisk-testimonial__avatar" />
    )}
    <div>
      <div class="brisk-testimonial__author" data-brisk-field="author">{author}</div>
      {role && <div class="brisk-testimonial__role" data-brisk-field="role">{role}</div>}
    </div>
  </div>
</div>

<style>
  .brisk-testimonial {
    flex: 0 0 min(320px, 85vw);
    scroll-snap-align: start;
    border: 1px solid var(--border);
    border-radius: var(--brisk-override-radius, 12px);
    padding: var(--brisk-override-padding-y, 1.5rem)
      var(--brisk-override-padding-x, 1.5rem);
    background: var(--brisk-override-bg, transparent);
  }
  .brisk-testimonial__stars {
    display: flex;
    gap: 2px;
  }
  .brisk-testimonial__quote {
    margin: 0.75rem 0;
    font-size: 0.9375rem;
    color: var(--brisk-override-text, var(--foreground));
  }
  .brisk-testimonial__footer {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  /* :global() because OptimizedImage (a child component) renders the
  actual <img> — see Image.astro's own style block for the full reasoning. */
  :global(.brisk-testimonial__avatar) {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .brisk-testimonial__author {
    font-weight: 600;
    font-size: 0.875rem;
  }
  .brisk-testimonial__role {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
</style>
