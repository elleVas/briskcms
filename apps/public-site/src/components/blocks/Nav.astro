---
import type { NavProps } from '@brisk/shared-types';

type Props = NavProps;

const { visibility } = Astro.props;
---

<nav
  class:list={[
    'brisk-nav',
    { 'brisk-visibility-desktop-only': visibility === 'desktop-only' },
    { 'brisk-visibility-mobile-only': visibility === 'mobile-only' },
  ]}
>
  <slot />
</nav>

<style>
  .brisk-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
