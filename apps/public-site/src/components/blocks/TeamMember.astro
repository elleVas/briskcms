---
import {
  buildBlockInstanceStyle,
  type BlockStyleOverride,
  type TeamMemberProps,
} from '@brisk/shared-types';

type Props = TeamMemberProps & { styleOverride?: BlockStyleOverride };

const { name, role, bio, photo, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<div class="brisk-team-member" style={instanceStyle}>
  {
    photo ? (
      <img
        src={photo.url}
        alt=""
        class="brisk-team-member__photo"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="brisk-team-member__photo brisk-team-member__photo--placeholder" />
    )
  }
  <div class="brisk-team-member__name" data-brisk-field="name">{name}</div>
  <div class="brisk-team-member__role" data-brisk-field="role">{role}</div>
  {bio && <p class="brisk-team-member__bio" data-brisk-field="bio">{bio}</p>}
</div>

<style>
  .brisk-team-member {
    text-align: center;
    background: var(--brisk-override-bg, transparent);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  .brisk-team-member__photo {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto;
  }
  .brisk-team-member__photo--placeholder {
    background: var(--muted);
  }
  .brisk-team-member__name {
    margin-top: 0.75rem;
    font-weight: 600;
    color: var(--brisk-override-text, inherit);
  }
  .brisk-team-member__role {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .brisk-team-member__bio {
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
</style>
