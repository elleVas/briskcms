---
import type { TeamMemberProps } from '@brisk/shared-types';

type Props = TeamMemberProps;

const { name, role, bio, photo } = Astro.props;
---

<div class="brisk-team-member">
  {
    photo ? (
      <img src={photo.url} alt="" class="brisk-team-member__photo" />
    ) : (
      <div class="brisk-team-member__photo brisk-team-member__photo--placeholder" />
    )
  }
  <div class="brisk-team-member__name">{name}</div>
  <div class="brisk-team-member__role">{role}</div>
  {bio && <p class="brisk-team-member__bio">{bio}</p>}
</div>

<style>
  .brisk-team-member {
    text-align: center;
  }
  .brisk-team-member__photo {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto;
  }
  .brisk-team-member__photo--placeholder {
    background: #f4f4f5;
  }
  .brisk-team-member__name {
    margin-top: 0.75rem;
    font-weight: 600;
  }
  .brisk-team-member__role {
    font-size: 0.875rem;
    color: #71717a;
  }
  .brisk-team-member__bio {
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    color: #52525b;
  }
</style>
