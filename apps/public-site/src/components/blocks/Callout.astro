---
import type { CalloutProps } from '@brisk/shared-types';

type Props = CalloutProps & {
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
};

const { message, tone, instanceClass } = Astro.props;
---

<div
  class:list={[`brisk-callout brisk-callout--${tone}`, instanceClass]}
  role="note"
>
  <div class="brisk-callout__message brisk-rich-text" data-brisk-field="message" set:html={message} />
</div>

<style>
  /* Every fallback is the value this block already had, so a callout
     nobody has styled renders exactly as before (ADR-0022's rule for
     every stylable block). The tone colours below stay where they are:
     they are set by a modifier class, and an override reaches this
     element with higher precedence, so setting one wins and setting
     nothing leaves the tone alone. */
  .brisk-callout {
    padding: var(--brisk-override-padding-y, 1rem)
      var(--brisk-override-padding-x, 1.25rem);
    border-radius: var(--brisk-override-radius, var(--radius));
    border-left: 4px solid;
  }
  .brisk-callout__message {
    margin: 0;
  }
  /*
    Tone colors are literal, not theme tokens on purpose — same reasoning
    as Testimonial's filled-star amber or BeforeAfter's divider white: an
    info/warning/success signal has to stay recognizable across every
    theme, not shift with whatever a theme happens to call --primary.
  */
  .brisk-callout--info {
    background: #eff6ff;
    border-color: #3b82f6;
    color: #1e3a8a;
  }
  .brisk-callout--warning {
    background: #fffbeb;
    border-color: #f59e0b;
    color: #78350f;
  }
  .brisk-callout--success {
    background: #f0fdf4;
    border-color: #22c55e;
    color: #14532d;
  }
</style>
