---
import type { ComparisonTableProps } from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';
import EmptyContainerHint from '../EmptyContainerHint.astro';

type Props = ComparisonTableProps & {
  locale: string;
  editable?: boolean;
  hasChildren?: boolean;
  emptyChildLabel?: string | null;
  instanceClass?: string | null;
};

const {
  columns,
  highlightColumn,
  locale,
  editable,
  hasChildren,
  emptyChildLabel,
  instanceClass,
} = Astro.props;
const i18n = new Translator(locale);

/** Six at most: past that a comparison is a spreadsheet, and a phone shows none of it. */
const MAX_COLUMNS = 6;
const names = columns
  .split('\n')
  .map((name) => name.trim())
  .filter(Boolean)
  .slice(0, MAX_COLUMNS);
const highlighted =
  highlightColumn >= 1 && highlightColumn <= names.length
    ? highlightColumn
    : null;
---

{/*
  A grid with table roles rather than a <table>, and not by taste: its
  rows are blocks, and in the canvas every block is wrapped in a <div>.
  A <div> between <tbody> and <tr> is not something the HTML parser
  keeps — it moves it out in front of the table, so the canvas would show
  every row above an empty table. The roles give a screen reader the same
  table a <table> would.
*/}
<div
  class:list={['brisk-comparison-table', instanceClass]}
  style={`--brisk-comparison-columns: ${Math.max(names.length, 1)};`}
  data-columns={names.length}
  data-highlight={highlighted ?? undefined}
  data-brisk-editable-outline={editable && hasChildren ? '' : undefined}
>
  <div class="brisk-comparison-table__scroll">
    <div class="brisk-comparison-table__grid" role="table">
      <div class="brisk-comparison-table__head" role="row">
        <span class="brisk-comparison-table__corner" role="columnheader">
          <span class="brisk-visually-hidden">{i18n.t('comparisonTable.feature')}</span>
        </span>
        {names.map((name, index) => (
          <span
            role="columnheader"
            class:list={[
              'brisk-comparison-table__column',
              { 'brisk-comparison-table__column--highlight': index + 1 === highlighted },
            ]}
          >
            {name}
          </span>
        ))}
      </div>
      <slot />
    </div>
  </div>
  <EmptyContainerHint
    show={!hasChildren && Boolean(editable)}
    locale={locale}
    childLabel={emptyChildLabel}
  />
</div>

<style>
  .brisk-comparison-table {
    min-width: 0;
    overflow: hidden;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, var(--radius));
    border-width: var(--brisk-override-border-width, 1px);
    border-style: var(--brisk-override-border-style, solid);
    border-color: var(--brisk-override-border-color, var(--border));
    padding: var(--brisk-override-padding-y, 0)
      var(--brisk-override-padding-x, 0);
  }

  /* Sideways scroll inside the block, never across the page. */
  .brisk-comparison-table__scroll {
    overflow-x: auto;
  }

  .brisk-comparison-table__grid {
    display: grid;
    grid-template-columns:
      minmax(9rem, 1.4fr)
      repeat(var(--brisk-comparison-columns), minmax(6rem, 1fr));
    min-width: min-content;
  }

  .brisk-comparison-table__head {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    font-weight: 600;
  }

  .brisk-comparison-table__head > * {
    padding: 0.75rem 1rem;
    text-align: center;
    overflow-wrap: break-word;
  }

  .brisk-comparison-table__column--highlight {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    color: var(--primary);
  }

  /* The highlighted column runs down through every row. The cells belong
     to ComparisonRow.astro, hence :global(); `n + 1` because the first
     cell of a row is its feature. */
  .brisk-comparison-table[data-highlight='1'] :global(.brisk-comparison-row > :nth-child(2)),
  .brisk-comparison-table[data-highlight='2'] :global(.brisk-comparison-row > :nth-child(3)),
  .brisk-comparison-table[data-highlight='3'] :global(.brisk-comparison-row > :nth-child(4)),
  .brisk-comparison-table[data-highlight='4'] :global(.brisk-comparison-row > :nth-child(5)),
  .brisk-comparison-table[data-highlight='5'] :global(.brisk-comparison-row > :nth-child(6)),
  .brisk-comparison-table[data-highlight='6'] :global(.brisk-comparison-row > :nth-child(7)) {
    background: color-mix(in srgb, var(--primary) 6%, transparent);
  }

  /* A row with more values than the table has columns: the extra ones
     have no column to sit in, and a subgrid would wrap them onto a line
     of their own. */
  .brisk-comparison-table[data-columns='0'] :global(.brisk-comparison-row > :nth-child(n + 2)),
  .brisk-comparison-table[data-columns='1'] :global(.brisk-comparison-row > :nth-child(n + 3)),
  .brisk-comparison-table[data-columns='2'] :global(.brisk-comparison-row > :nth-child(n + 4)),
  .brisk-comparison-table[data-columns='3'] :global(.brisk-comparison-row > :nth-child(n + 5)),
  .brisk-comparison-table[data-columns='4'] :global(.brisk-comparison-row > :nth-child(n + 6)),
  .brisk-comparison-table[data-columns='5'] :global(.brisk-comparison-row > :nth-child(n + 7)),
  .brisk-comparison-table[data-columns='6'] :global(.brisk-comparison-row > :nth-child(n + 8)) {
    display: none;
  }

  .brisk-comparison-table[data-brisk-editable-outline] {
    outline: 1px dashed var(--border);
    outline-offset: -4px;
  }
</style>
