---
import {
  buildBlockInstanceStyle,
  type BannerProps,
  type BlockStyleOverride,
} from '@brisk/shared-types';
import { localePath } from '../../lib/locale-path';

type Props = BannerProps & { styleOverride?: BlockStyleOverride };

const { title, text, buttonLabel, linkType, page, url, styleOverride } =
  Astro.props;
const href =
  linkType === 'page' && page ? localePath(page.locale, page.slug) : url;
const hasLink = linkType === 'page' ? Boolean(page) : Boolean(url);
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<div class="brisk-banner" style={instanceStyle}>
  <h2 class="brisk-banner__title" data-brisk-field="title">{title}</h2>
  <p class="brisk-banner__text" data-brisk-field="text">{text}</p>
  {
    hasLink && (
      <a class="brisk-banner__button" href={href} data-brisk-field="buttonLabel">
        {buttonLabel}
      </a>
    )
  }
</div>

<style>
  .brisk-banner {
    padding: var(--brisk-override-padding-y, 2.5rem)
      var(--brisk-override-padding-x, 1.5rem);
    border-radius: var(--brisk-override-radius, 12px);
    background: var(--brisk-override-bg, var(--secondary));
    color: var(--brisk-override-text, inherit);
    text-align: center;
  }
  .brisk-banner__title {
    margin: 0;
    font-size: 1.5rem;
  }
  .brisk-banner__text {
    margin: 0.5rem 0 0;
  }
  .brisk-banner__button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }
</style>
