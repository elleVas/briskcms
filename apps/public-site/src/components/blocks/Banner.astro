---
import type { BannerProps } from '@brisk/shared-types';
import { localePath } from '../../lib/locale-path.js';

type Props = BannerProps;

const { title, text, buttonLabel, linkType, page, url, backgroundColor } =
  Astro.props;
const href =
  linkType === 'page' && page ? localePath(page.locale, page.slug) : url;
const hasLink = linkType === 'page' ? Boolean(page) : Boolean(url);
---

<div
  class="brisk-banner"
  style={{ background: backgroundColor ?? 'var(--secondary)' }}
>
  <h2 class="brisk-banner__title" data-brisk-field="title">{title}</h2>
  <p class="brisk-banner__text" data-brisk-field="text">{text}</p>
  {
    hasLink && (
      <a class="brisk-banner__button" href={href} data-brisk-field="buttonLabel">
        {buttonLabel}
      </a>
    )
  }
</div>

<style>
  .brisk-banner {
    padding: 2.5rem 1.5rem;
    border-radius: 12px;
    text-align: center;
  }
  .brisk-banner__title {
    margin: 0;
    font-size: 1.5rem;
  }
  .brisk-banner__text {
    margin: 0.5rem 0 0;
  }
  .brisk-banner__button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }
</style>
