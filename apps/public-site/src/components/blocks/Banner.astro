---
import {
  type BannerProps,
  type BlockStyleOverride,
} from '@brisk/shared-types';
import { localePathFromAncestors } from '@brisk/theme-runtime';

type Props = BannerProps & { styleOverride?: BlockStyleOverride;
  instanceClass?: string | null;
};

const {
  title,
  text,
  buttonLabel,
  linkType,
  page,
  url,
  styleOverride,
  instanceClass,
} = Astro.props;
const href =
  linkType === 'page' && page?.locale && page?.slug ? localePathFromAncestors(page.locale, page.ancestorSlugs ?? [], page.slug) : url;
const hasLink = linkType === 'page' ? Boolean(page) : Boolean(url);
---

<div class:list={['brisk-banner', instanceClass]}>
  <h2 class="brisk-banner__title" data-brisk-field="title">{title}</h2>
  <div class="brisk-banner__text brisk-rich-text" data-brisk-field="text" set:html={text} />
  {
    hasLink && (
      <a class="brisk-banner__button" href={href} data-brisk-field="buttonLabel">
        {buttonLabel}
      </a>
    )
  }
</div>

<style>
  .brisk-banner {
    padding: var(--brisk-override-padding-y, 2.5rem)
      var(--brisk-override-padding-x, 1.5rem);
    border-radius: var(--brisk-override-radius, 12px);
    background: var(--brisk-override-bg, var(--secondary));
    color: var(--brisk-override-text, inherit);
    text-align: center;
  }
  .brisk-banner__title {
    margin: 0;
    font-size: 1.5rem;
  }
  .brisk-banner__text {
    margin: 0.5rem 0 0;
  }
  .brisk-banner__button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }
</style>
