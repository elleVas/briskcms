---
import type { NavDropdownProps } from '@brisk/shared-types';

type Props = NavDropdownProps;

const { label, position, visibility } = Astro.props;
---

<details
  class:list={[
    'brisk-nav-dropdown',
    { 'brisk-nav-dropdown--right': position === 'right' },
    { 'brisk-visibility-desktop-only': visibility === 'desktop-only' },
    { 'brisk-visibility-mobile-only': visibility === 'mobile-only' },
  ]}
>
  <summary class="brisk-nav-dropdown__trigger">{label}</summary>
  <div class="brisk-nav-dropdown__panel">
    <slot />
  </div>
</details>

<style>
  /* Native <details>/<summary> — click to open/close, keyboard-accessible
     by default, no JS needed at all. The trigger is not itself a link
     (docs/adr/0018 follow-up): combining "click opens the submenu" and
     "click navigates" on one element is the classic mega-menu UX
     conflict, so this is a pure disclosure toggle. */
  .brisk-nav-dropdown {
    position: relative;
  }
  .brisk-nav-dropdown--right {
    margin-left: auto;
  }

  .brisk-nav-dropdown__trigger {
    cursor: pointer;
    list-style: none;
  }
  .brisk-nav-dropdown__trigger::-webkit-details-marker {
    display: none;
  }
  .brisk-nav-dropdown__trigger::after {
    content: ' ▾';
  }

  .brisk-nav-dropdown__panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 10;
    min-width: 12rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
  }
  .brisk-nav-dropdown__panel :global(.brisk-nav-link) {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  .brisk-nav-dropdown__panel :global(.brisk-nav-link:hover) {
    background: #f4f4f5;
  }
</style>
