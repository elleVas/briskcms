---
import { parseMediaIcon, type ListProps } from '@brisk/shared-types';
import { siteIconImageUrl } from '../../lib/media-icon-url';
import EmptyContainerHint from '../EmptyContainerHint.astro';

type Props = ListProps & {
  /** Resolved by BlockRenderer from the `icon` prop (docs/adr/0023). */
  iconSvg?: string | null;
  locale?: string;
  emptyChildLabel?: string | null;
  editable?: boolean;
  hasChildren?: boolean;
  instanceClass?: string | null;
};

const { marker, icon, iconSvg, locale, emptyChildLabel, editable, hasChildren, instanceClass } =
  Astro.props;

// A numbered list is an <ol>, so a screen reader says "item 2 of 5"; the
// other markers are decoration on a <ul>.
const Tag = marker === 'number' ? 'ol' : 'ul';

// The icon travels to the items as a CSS mask on a custom property: an
// item is its own block and cannot see its list's props, but it inherits
// its list's custom properties. Painted with `currentColor`, so the text
// colour override colours the marker too.
const iconStyle =
  marker === 'icon' && iconSvg
    ? `--brisk-list-icon: url("data:image/svg+xml,${encodeURIComponent(iconSvg)}")`
    : undefined;

// An image from the media library cannot go through that mask: an SVG
// used as an image never loads what it points at, so the marker would be
// empty. It is shown as a background instead — as it is, not in the text
// colour, which is what a picture is. The address is the site's own
// image endpoint (see media-icon-url.ts), with the media URL encoded
// into its query: nothing in it can end the CSS string early.
const mediaIcon = marker === 'icon' && icon ? parseMediaIcon(icon) : null;
const markerStyle = mediaIcon
  ? `--brisk-list-icon-image: url("${siteIconImageUrl(mediaIcon.url)}")`
  : iconStyle;
---

<Tag
  class:list={[
    'brisk-list',
    `brisk-list--${marker}`,
    mediaIcon && 'brisk-list--icon-image',
    instanceClass,
  ]}
  style={markerStyle}
  data-brisk-editable-outline={editable && hasChildren ? '' : undefined}
>
  <slot />
  <EmptyContainerHint
    show={!hasChildren && Boolean(editable)}
    locale={locale}
    childLabel={emptyChildLabel}
  />
</Tag>

<style>
  .brisk-list {
    display: grid;
    gap: var(--brisk-override-gap, 0.5rem);
    margin: 0;
    /* Logical, so the markers sit on the right in a right-to-left page. */
    padding-inline-start: 1.5rem;
    padding-block: var(--brisk-override-padding-y, 0);
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
  }

  /* Stated, not inherited: the global reset takes every list's markers
     away, so "bullets" and "numbers" left to the browser show nothing. */
  .brisk-list--bullet {
    list-style: disc;
  }

  .brisk-list--number {
    list-style: decimal;
  }

  .brisk-list--check,
  .brisk-list--icon {
    list-style: none;
    padding-inline-start: 0;
  }

  .brisk-list--check :global(.brisk-list-item),
  .brisk-list--icon :global(.brisk-list-item) {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    column-gap: 0.5rem;
    align-items: baseline;
  }

  .brisk-list--check :global(.brisk-list-item)::before {
    content: '✓';
    font-weight: 700;
    color: var(--primary);
  }

  .brisk-list--icon :global(.brisk-list-item)::before {
    content: '';
    width: 1rem;
    height: 1rem;
    align-self: center;
    background: currentColor;
    mask: var(--brisk-list-icon) center / contain no-repeat;
  }

  .brisk-list--icon-image :global(.brisk-list-item)::before {
    background: var(--brisk-list-icon-image) center / contain no-repeat;
    mask: none;
  }
</style>
