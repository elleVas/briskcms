---
import EmptyContainerHint from '../EmptyContainerHint.astro';

export interface Props {
  editable?: boolean;
  hasChildren?: boolean;
}

const { editable, hasChildren } = Astro.props;
---

<div class="brisk-team">
  <slot />
  <EmptyContainerHint show={!hasChildren && Boolean(editable)} />
</div>

<style>
  .brisk-team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
  }
</style>
