---
import {
  type BlockStyleOverride,
  type TextProps,
} from '@brisk/shared-types';

type Props = TextProps & { styleOverride?: BlockStyleOverride;
  instanceClass?: string | null;
};

const { body, styleOverride, instanceClass} = Astro.props;
---

<div
  class:list={['brisk-text brisk-rich-text', instanceClass]}
  data-brisk-field="body"
  set:html={body}
/>

<style>
  .brisk-text {
    color: var(--brisk-override-text, inherit);
  }
</style>
