---
import {
  buildBlockInstanceStyle,
  type BlockStyleOverride,
  type TextProps,
} from '@brisk/shared-types';

type Props = TextProps & { styleOverride?: BlockStyleOverride };

const { body, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<p class="brisk-text" data-brisk-field="body" style={instanceStyle}>{body}</p>

<style>
  .brisk-text {
    color: var(--brisk-override-text, inherit);
  }
</style>
