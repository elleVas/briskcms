---
import type { ImageProps } from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';
import OptimizedImage from '../OptimizedImage.astro';

type Props = ImageProps & {
  locale: string;
  /** The per-instance style class, from BlockRenderer — see blockInstanceClassName. */
  instanceClass?: string | null;
};

const { media, alt, isDecorative, caption, locale, instanceClass } =
  Astro.props;
const i18n = new Translator(locale);
// Authoritative regardless of what's saved in `alt` — a decorative image
// gets alt="" per WCAG even if a value was typed there before this flag
// existed (see imagePropsSchema's own comment).
const resolvedAlt = isDecorative ? '' : alt;
---

{
  media ? (
    <figure class:list={['brisk-image-figure', instanceClass]}>
      {
        /* loading="eager" here (unlike the other image blocks): this is
        the one block type a page can use as a full-width hero at the very
        top — lazily loading a real LCP element actively delays it, the
        opposite of the Core Web Vitals fix this is for. */
      }
      <OptimizedImage
        media={media}
        alt={resolvedAlt}
        class="brisk-image"
        loading="eager"
      />
      {caption && <figcaption data-brisk-field="caption">{caption}</figcaption>}
    </figure>
  ) : (
    <p>{i18n.t('image.empty')}</p>
  )
}

<style>
  /* :global() because the actual <img> (or astro:assets' transformed
  <img>) is rendered by OptimizedImage, a child component — Astro's scoped
  styles don't cross that boundary, so a plain `.brisk-image` selector here
  would silently never match. Same reasoning applies in every other block
  below that styles an OptimizedImage by class. */
  :global(.brisk-image) {
    max-width: 100%;
    height: auto;
  }
  /* The overrides land on the <figure>, and the radius is passed down to
     the image because rounding the frame while the picture keeps square
     corners is not what anyone means by it. Fallbacks are what the block
     already rendered. */
  .brisk-image-figure {
    border-radius: var(--brisk-override-radius, 0);
    border: var(--brisk-override-border-width, 0)
      var(--brisk-override-border-style, solid)
      var(--brisk-override-border-color, var(--border));
    box-shadow: var(--brisk-override-shadow, none);
    max-width: var(--brisk-override-max-width, none);
    overflow: hidden;
  }
</style>
