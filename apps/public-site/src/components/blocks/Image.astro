---
import type { ImageProps } from '@brisk/shared-types';

type Props = ImageProps;

const { media, alt, caption } = Astro.props;
---

{
  media ? (
    <figure>
      <img src={media.url} alt={alt} />
      {caption && <figcaption data-brisk-field="caption">{caption}</figcaption>}
    </figure>
  ) : (
    <p>Nessuna immagine selezionata.</p>
  )
}

<style>
  img {
    max-width: 100%;
    height: auto;
  }
</style>
