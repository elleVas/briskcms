---
import {
  buildBlockInstanceStyle,
  type BlockStyleOverride,
  type CountdownProps,
} from '@brisk/shared-types';
import { Translator } from '../../lib/i18n.js';

type Props = CountdownProps & {
  styleOverride?: BlockStyleOverride;
  locale: string;
};

const { targetDate, label, styleOverride, locale } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
const i18n = new Translator(locale);
---

<div class="brisk-countdown" data-target-date={targetDate} style={instanceStyle}>
  {label && <p class="brisk-countdown__label" data-brisk-field="label">{label}</p>}
  <div class="brisk-countdown__timer">
    <div class="brisk-countdown__unit">
      <span class="brisk-countdown__value" data-unit="days">00</span>
      <span class="brisk-countdown__name">{i18n.t('countdown.days')}</span>
    </div>
    <div class="brisk-countdown__unit">
      <span class="brisk-countdown__value" data-unit="hours">00</span>
      <span class="brisk-countdown__name">{i18n.t('countdown.hours')}</span>
    </div>
    <div class="brisk-countdown__unit">
      <span class="brisk-countdown__value" data-unit="minutes">00</span>
      <span class="brisk-countdown__name">{i18n.t('countdown.minutes')}</span>
    </div>
    <div class="brisk-countdown__unit">
      <span class="brisk-countdown__value" data-unit="seconds">00</span>
      <span class="brisk-countdown__name">{i18n.t('countdown.seconds')}</span>
    </div>
  </div>
  <p class="brisk-countdown__expired" hidden>{i18n.t('countdown.expired')}</p>
</div>

<script>
  // No framework here on purpose (docs/adr/0007, same reasoning as
  // HamburgerMenu.astro) — the only difference from that block is that
  // this one updates on a timer (setInterval) instead of a click listener,
  // the first "tick" rather than "event" driven block in the public site.
  document
    .querySelectorAll<HTMLElement>('.brisk-countdown')
    .forEach((root) => {
      const targetDate = root.dataset.targetDate;
      if (!targetDate) return;
      const target = new Date(targetDate).getTime();
      if (Number.isNaN(target)) return;

      const timerEl = root.querySelector<HTMLElement>(
        '.brisk-countdown__timer',
      );
      const expiredEl = root.querySelector<HTMLElement>(
        '.brisk-countdown__expired',
      );
      const daysEl = root.querySelector<HTMLElement>('[data-unit="days"]');
      const hoursEl = root.querySelector<HTMLElement>('[data-unit="hours"]');
      const minutesEl = root.querySelector<HTMLElement>(
        '[data-unit="minutes"]',
      );
      const secondsEl = root.querySelector<HTMLElement>(
        '[data-unit="seconds"]',
      );

      function pad(value: number): string {
        return String(value).padStart(2, '0');
      }

      // Returns true once the target has passed, so the caller knows when
      // to stop ticking instead of the interval outliving its own timer.
      function updateOrExpire(): boolean {
        const remaining = target - Date.now();
        if (remaining <= 0) {
          if (timerEl) timerEl.hidden = true;
          if (expiredEl) expiredEl.hidden = false;
          return true;
        }
        const totalSeconds = Math.floor(remaining / 1000);
        if (daysEl) daysEl.textContent = pad(Math.floor(totalSeconds / 86400));
        if (hoursEl)
          hoursEl.textContent = pad(Math.floor((totalSeconds % 86400) / 3600));
        if (minutesEl)
          minutesEl.textContent = pad(Math.floor((totalSeconds % 3600) / 60));
        if (secondsEl) secondsEl.textContent = pad(totalSeconds % 60);
        return false;
      }

      if (!updateOrExpire()) {
        const intervalId = setInterval(() => {
          if (updateOrExpire()) clearInterval(intervalId);
        }, 1000);
      }
    });
</script>

<style>
  .brisk-countdown {
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  .brisk-countdown__timer {
    display: flex;
    gap: 1rem;
  }
  .brisk-countdown__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .brisk-countdown__value {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .brisk-countdown__name {
    font-size: 0.75rem;
    color: var(--muted-foreground);
  }
</style>
