---
import type { VideoEmbedProps } from '@brisk/shared-types';
import ConsentGatedEmbed from '../ConsentGatedEmbed.astro';
import { parseVideoEmbedUrl } from '../../lib/video-embed.js';

type Props = VideoEmbedProps;

const { url } = Astro.props;
const parsed = url ? parseVideoEmbedUrl(url) : null;
---

{
  parsed && (
    <ConsentGatedEmbed
      src={parsed.embedUrl}
      title="Video"
      buttonLabel={`Carica il video (${parsed.provider === 'youtube' ? 'YouTube' : 'Vimeo'})`}
    />
  )
}
{!url && <p>Nessun video selezionato.</p>}
{url && !parsed && (
  <p>URL video non riconosciuto (sono supportati solo link YouTube o Vimeo).</p>
)}
