---
import type { ContainerProps } from '@brisk/shared-types';
import EmptyContainerHint from '../EmptyContainerHint.astro';

type Props = ContainerProps & {
	editable?: boolean;
	hasChildren?: boolean;
	instanceClass?: string | null;
};

const {
	background,
	padding,
	editable,
	hasChildren,
	instanceClass,
} = Astro.props;

// Token-driven (docs/adr/0021) — a theme swap changes what these mean,
// this component never hardcodes a color. `primary`/`secondary` follow
// the same convention as Button/the global link color: primary is the
// accent surface, secondary is supporting/subtle chrome.
const backgroundClass: Record<ContainerProps['background'], string> = {
	none: '',
	muted: 'bg-muted text-foreground',
	primary: 'bg-primary text-primary-foreground',
	secondary: 'bg-secondary text-secondary-foreground',
};

const paddingClass: Record<ContainerProps['padding'], string> = {
	none: '',
	sm: 'p-4',
	md: 'p-8',
	lg: 'p-12',
};
---

<div
	class:list={[
		`brisk-container flex flex-col gap-4 rounded-lg ${backgroundClass[background]} ${paddingClass[padding]}`,
		instanceClass,
	]}
	data-brisk-editable-outline={editable && hasChildren ? '' : undefined}
>
	<slot />
	<EmptyContainerHint show={!hasChildren && Boolean(editable)} />
</div>

<style>
	/* Editor only (never on the published page, see editable), and only
	   once it has content — when empty it already shows its own dashed
	   border through EmptyContainerHint, and a second one here would be
	   redundant. Without this, a Container holding real content loses
	   every visible boundary — user feedback from live use, the same
	   reason as Column.astro. A conditional `data-*` attribute, not a
	   class inside a ternary expression — the latter is discarded by the
	   Astro compiler as "unused" (it analyses only static strings in the
	   markup), observed live on Column.astro itself.
	   No fixed `padding` here, unlike the other containers: unlike them,
	   Container already has a user-chosen padding (`none`/`sm`/`md`/`lg`,
	   above) — a fixed value would override it with higher CSS
	   specificity, making it look different in the editor from the
	   published page. The "md" default (2rem) is already enough of a
	   click target on its own. */
	.brisk-container[data-brisk-editable-outline] {
		outline: 1px dashed var(--border);
		outline-offset: -4px;
	}

	/* Background and padding are deliberately absent: they already have
	   their own dedicated user fields above, and adding them here would
	   create two conflicting mechanisms for the same property.
	   Everything else a container needs to hold a real section of a page
	   comes through (ADR-0047). Every fallback is the value this block
	   ALREADY had — `gap` matches the `gap-4` class, alignment matches the
	   flex defaults — so a container with nothing overridden renders byte
	   for byte as it did before. */
	.brisk-container {
		border-radius: var(--brisk-override-radius, 0.5rem);
		color: var(--brisk-override-text, inherit);
		border-width: var(--brisk-override-border-width, 0);
		border-style: var(--brisk-override-border-style, solid);
		border-color: var(--brisk-override-border-color, var(--border));
		box-shadow: var(--brisk-override-shadow, none);
		min-height: var(--brisk-override-min-height, auto);
		max-width: var(--brisk-override-max-width, none);
		gap: var(--brisk-override-gap, 1rem);
		/* The element is `flex flex-col`, so align-items is the HORIZONTAL
		   axis and justify-content the vertical — which is why the two
		   properties map this way round and not the other. */
		align-items: var(--brisk-override-align, stretch);
		justify-content: var(--brisk-override-justify, flex-start);
		/* The overlay is a flat gradient layer ON TOP of the image, rather
		   than a `::before` with a negative z-index. A pseudo-element would
		   need `position: relative` and `isolation: isolate` to sit in the
		   right place, and both change the stacking context for everything
		   nested inside — a real risk for a block whose whole job is to
		   contain other blocks. Transparent by default, so it is invisible
		   until someone sets it. */
		background-image:
			linear-gradient(
				var(--brisk-override-overlay, transparent),
				var(--brisk-override-overlay, transparent)
			),
			var(--brisk-override-bg-image, none);
		background-position: var(--brisk-override-bg-position, center);
		background-size: var(--brisk-override-bg-size, cover);
		background-repeat: var(--brisk-override-bg-repeat, no-repeat);
	}
</style>
