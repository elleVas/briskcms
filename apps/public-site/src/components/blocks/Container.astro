---
import type { ContainerProps } from '@brisk/shared-types';
import EmptyContainerHint from '../EmptyContainerHint.astro';

type Props = ContainerProps & { editable?: boolean; hasChildren?: boolean };

const { background, padding, editable, hasChildren } = Astro.props;

// Token-driven (docs/adr/0021) — a theme swap changes what these mean,
// this component never hardcodes a color. `primary`/`secondary` follow
// the same convention as Button/the global link color: primary is the
// accent surface, secondary is supporting/subtle chrome.
const backgroundClass: Record<ContainerProps['background'], string> = {
	none: '',
	muted: 'bg-muted text-foreground',
	primary: 'bg-primary text-primary-foreground',
	secondary: 'bg-secondary text-secondary-foreground',
};

const paddingClass: Record<ContainerProps['padding'], string> = {
	none: '',
	sm: 'p-4',
	md: 'p-8',
	lg: 'p-12',
};
---

<div
	class={`brisk-container flex flex-col gap-4 rounded-lg ${backgroundClass[background]} ${paddingClass[padding]}`}
	data-brisk-editable-outline={editable && hasChildren ? '' : undefined}
>
	<slot />
	<EmptyContainerHint show={!hasChildren && Boolean(editable)} />
</div>

<style>
	/* Solo nell'editor (mai sulla pagina pubblicata, vedi editable), e solo
	   una volta che ha contenuto — da vuoto mostra già il proprio bordo
	   tratteggiato via EmptyContainerHint, un secondo qui sarebbe ridondante.
	   Senza questo, un Container con dentro del vero contenuto perde ogni
	   confine visibile — feedback utente dal vivo, stesso motivo di
	   Column.astro. Un attributo `data-*` condizionale, non una classe
	   dentro un'espressione ternaria — quest'ultima viene scartata dal
	   compilatore Astro come "non usata" (analizza solo stringhe statiche
	   nel markup), osservato dal vivo proprio su Column.astro. */
	.brisk-container[data-brisk-editable-outline] {
		outline: 1px dashed var(--border);
		outline-offset: -4px;
	}
</style>
