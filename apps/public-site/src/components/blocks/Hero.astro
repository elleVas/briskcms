---
import type { BlockStyleOverride, HeroProps } from '@brisk/shared-types';
import { buildBlockInstanceStyle } from '@brisk/shared-types';

type Props = HeroProps & { styleOverride?: BlockStyleOverride };

const { title, subtitle, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

{/* <section>, not <header>: this block can be dropped anywhere in a
    page's body (not just a site's actual header slot) — a bare <header>
    there creates a second, ambiguous role="banner" landmark alongside the
    real one from PageLayout.astro. Security review 2026-08-24, accessibility. */}
<section
	class="brisk-hero mx-auto max-w-3xl py-20 text-center sm:py-28"
	style={instanceStyle}
>
	<h1
		data-brisk-field="title"
		class="text-4xl font-semibold tracking-tight text-balance text-foreground sm:text-5xl"
	>
		{title}
	</h1>
	<p
		data-brisk-field="subtitle"
		class="mt-4 text-lg text-pretty text-muted-foreground sm:text-xl"
	>
		{subtitle}
	</p>
</section>

<style>
	.brisk-hero {
		background: var(--brisk-override-bg, transparent);
		border-radius: var(--brisk-override-radius, 0);
	}
	.brisk-hero h1 {
		color: var(--brisk-override-text, var(--foreground));
	}
</style>
