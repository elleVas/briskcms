---
import type { AccordionItemProps } from '@brisk/shared-types';

type Props = AccordionItemProps;

const { question, answer } = Astro.props;
---

<details class="brisk-accordion-item">
  <summary class="brisk-accordion-item__question">{question}</summary>
  <div class="brisk-accordion-item__answer">{answer}</div>
</details>

<style>
  /* Native <details>/<summary> — same "no JS needed" reasoning as
     NavDropdown.astro's own comment on this exact HTML pattern. */
  .brisk-accordion-item {
    border-bottom: 1px solid var(--border);
    padding: 0.75rem 0;
  }
  .brisk-accordion-item__question {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  .brisk-accordion-item__question::-webkit-details-marker {
    display: none;
  }
  .brisk-accordion-item__question::after {
    content: ' +';
  }
  details[open] > .brisk-accordion-item__question::after {
    content: ' −';
  }
  .brisk-accordion-item__answer {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
  }
</style>
