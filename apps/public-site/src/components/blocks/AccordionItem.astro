---
import {
  buildBlockInstanceStyle,
  type AccordionItemProps,
  type BlockStyleOverride,
} from '@brisk/shared-types';

type Props = AccordionItemProps & { styleOverride?: BlockStyleOverride };

const { question, answer, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<details class="brisk-accordion-item" style={instanceStyle}>
  <summary class="brisk-accordion-item__question" data-brisk-field="question">{question}</summary>
  <div class="brisk-accordion-item__answer" data-brisk-field="answer">{answer}</div>
</details>

<style>
  /* Native <details>/<summary> — same "no JS needed" reasoning as
     NavDropdown.astro's own comment on this exact HTML pattern. */
  .brisk-accordion-item {
    border-bottom: 1px solid var(--border);
    padding: var(--brisk-override-padding-y, 0.75rem) var(--brisk-override-padding-x, 0);
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
  }
  .brisk-accordion-item__question {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  .brisk-accordion-item__question::-webkit-details-marker {
    display: none;
  }
  .brisk-accordion-item__question::after {
    content: ' +';
  }
  details[open] > .brisk-accordion-item__question::after {
    content: ' −';
  }
  .brisk-accordion-item__answer {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
  }
</style>
