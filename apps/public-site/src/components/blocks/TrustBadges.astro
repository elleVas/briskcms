---
import {
  PAYMENT_METHODS,
  type PaymentMethod,
  type TrustBadgesProps,
} from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';

type Props = TrustBadgesProps & {
  /** Each method's logo, resolved by BlockRenderer from the brand set (ADR-0053). */
  paymentIcons?: Partial<Record<PaymentMethod, string | null>>;
  locale: string;
  editable?: boolean;
  instanceClass?: string | null;
};

const props = Astro.props;
const { text, paymentIcons = {}, locale, editable, instanceClass } = props;
const i18n = new Translator(locale);

// A logo the brand set does not have is left out rather than drawn as an
// empty box: a blank tile beside "Visa" reads as a broken image.
const logos = PAYMENT_METHODS.filter((method) => props[method]).flatMap(
  (method) => {
    const svg = paymentIcons[method];
    return svg ? [{ method, svg }] : [];
  },
);
---

{
  logos.length > 0 || text ? (
    <div class:list={['brisk-trust-badges', instanceClass]}>
      {logos.length > 0 && (
        <ul
          class="brisk-trust-badges__logos"
          aria-label={i18n.t('trustBadges.label')}
        >
          {/* Each simple-icons SVG carries role="img" and a <title> with
              the brand's name, which is what a screen reader reads. */}
          {logos.map((logo) => (
            <li class="brisk-trust-badges__logo" set:html={logo.svg} />
          ))}
        </ul>
      )}
      {text && (
        <p class="brisk-trust-badges__text" data-brisk-field="text">
          {text}
        </p>
      )}
    </div>
  ) : (
    editable && (
      <p class="brisk-trust-badges brisk-trust-badges--empty">
        {i18n.t('trustBadges.empty')}
      </p>
    )
  )
}

<style>
  .brisk-trust-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--brisk-override-gap, 0.75rem);
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0)
      var(--brisk-override-padding-x, 0);
  }

  .brisk-trust-badges__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brisk-trust-badges__logo {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 0.75);
    color: var(--muted-foreground);
  }

  .brisk-trust-badges__logo :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .brisk-trust-badges__text {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }

  .brisk-trust-badges--empty {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
