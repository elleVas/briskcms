---
import type { HotspotProps } from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';

type Props = HotspotProps & {
  locale: string;
  instanceClass?: string | null;
};

const { x, y, title, text, locale, instanceClass } = Astro.props;
const i18n = new Translator(locale);
const left = Math.min(100, Math.max(0, x));
const top = Math.min(100, Math.max(0, y));
// Above the point in the lower part of the picture, below it otherwise,
// so the panel opens where there is picture left for it. Across the
// picture the stylesheet places it (see .brisk-hotspot__panel).
const vertical = top > 60 ? 'up' : 'down';
---

{/*
  `left`/`top` and not the logical properties used everywhere else: the
  point is a place ON A PHOTOGRAPH, and a photograph is not mirrored in a
  right-to-left language. 30% from the left is where the thing is.

  A native <details>: it opens and closes with a click, Enter or Space,
  and says whether it is open, with no script.
*/}
<details
  class:list={[
    'brisk-hotspot',
    `brisk-hotspot--${vertical}`,
    instanceClass,
  ]}
  style={`left: ${left}%; top: ${top}%; --brisk-hotspot-x: ${left};`}
>
  <summary class="brisk-hotspot__marker">
    <span class="brisk-visually-hidden">{title || i18n.t('hotspot.label')}</span>
  </summary>
  <div class="brisk-hotspot__panel">
    {title && (
      <p class="brisk-hotspot__title">
        {title}
      </p>
    )}
    {text && (
      <div
        class="brisk-hotspot__text brisk-rich-text"
        set:html={text}
      />
    )}
  </div>
</details>

<style>
  .brisk-hotspot {
    position: absolute;
    z-index: 1;
    transform: translate(-50%, -50%);
  }

  .brisk-hotspot[open] {
    z-index: 2;
  }

  .brisk-hotspot__marker {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 2px solid var(--background);
    border-radius: 50%;
    background: var(--brisk-override-bg, var(--primary));
    color: var(--brisk-override-text, var(--primary-foreground));
    box-shadow: 0 2px 8px rgb(0 0 0 / 30%);
    cursor: pointer;
    list-style: none;
  }

  .brisk-hotspot__marker::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a cross when the point is open. */
  .brisk-hotspot__marker::before,
  .brisk-hotspot__marker::after {
    content: '';
    position: absolute;
    width: 0.75rem;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 150ms ease;
  }

  .brisk-hotspot__marker::after {
    transform: rotate(90deg);
  }

  .brisk-hotspot[open] .brisk-hotspot__marker::before {
    transform: rotate(45deg);
  }

  .brisk-hotspot[open] .brisk-hotspot__marker::after {
    transform: rotate(135deg);
  }

  .brisk-hotspot__marker:focus-visible {
    outline: 2px solid var(--brisk-override-bg, var(--primary));
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .brisk-hotspot__marker::before,
    .brisk-hotspot__marker::after {
      transition: none;
    }
  }

  /*
   * Where the panel sits across the picture, worked out by the browser
   * rather than guessed from the point's position: centred on the point,
   * pushed back inside when that would cross an edge. `cqi` is the
   * ImageHotspots block, which measures itself (global.css) and is exactly
   * as wide as the picture — so 1cqi is 1% of it, and `--brisk-hotspot-x`
   * (0–100) times 1cqi is where the point is.
   *
   * It replaces three fixed positions (left of, centred, right of) picked
   * by thresholds: at 390px a point at 39% opened a panel that crossed the
   * picture's edge by 26px and made the whole page scroll sideways.
   *
   * `left` is measured from the point's own box, which starts half a
   * marker (0.875rem) before the point.
   */
  .brisk-hotspot__panel {
    --brisk-hotspot-panel-width: min(16rem, calc(100cqi - 1rem));
    position: absolute;
    width: var(--brisk-hotspot-panel-width);
    left: calc(
      clamp(
          0.5rem,
          var(--brisk-hotspot-x) * 1cqi - var(--brisk-hotspot-panel-width) / 2,
          100cqi - var(--brisk-hotspot-panel-width) - 0.5rem
        ) -
        var(--brisk-hotspot-x) * 1cqi + 0.875rem
    );
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--background);
    color: var(--foreground);
    box-shadow: 0 8px 24px rgb(0 0 0 / 18%);
    font-size: 0.875rem;
    text-align: start;
  }

  .brisk-hotspot--down .brisk-hotspot__panel {
    top: calc(100% + 0.5rem);
  }

  .brisk-hotspot--up .brisk-hotspot__panel {
    bottom: calc(100% + 0.5rem);
  }


  .brisk-hotspot__title {
    margin: 0 0 0.25rem;
    font-weight: 600;
  }
</style>
