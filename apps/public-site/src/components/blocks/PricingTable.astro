---
import EmptyContainerHint from '../EmptyContainerHint.astro';

export interface Props {
  editable?: boolean;
  hasChildren?: boolean;
}

const { editable, hasChildren } = Astro.props;
---

<div class="brisk-pricing-table">
  <slot />
  <EmptyContainerHint show={!hasChildren && Boolean(editable)} />
</div>

<style>
  .brisk-pricing-table {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }
</style>
