---
import {
  buildBlockInstanceStyle,
  columnsGridTemplate,
  type BlockStyleOverride,
  type ColumnsProps,
} from '@brisk/shared-types';
import EmptyContainerHint from '../EmptyContainerHint.astro';

type Props = ColumnsProps & {
  editable?: boolean;
  hasChildren?: boolean;
  styleOverride?: BlockStyleOverride;
};

const { layout, editable, hasChildren, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<div
  class="brisk-columns"
  style={`grid-template-columns: ${columnsGridTemplate(layout)}; ${instanceStyle ?? ''}`}
  data-brisk-editable-outline={editable && hasChildren ? '' : undefined}
>
  <slot />
</div>
<EmptyContainerHint show={!hasChildren && Boolean(editable)} />

<style>
  .brisk-columns {
    display: grid;
    gap: 1.5rem;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  @media (max-width: 640px) {
    .brisk-columns {
      grid-template-columns: 1fr !important;
    }
  }
  /* Editor only, and only once it has content — the same reason and
     pattern as Column.astro/Container.astro: without a persistent border a
     multi-column layout becomes hard to "read" while you work, especially
     once the columns already hold real content (user feedback from live
     use). */
  .brisk-columns[data-brisk-editable-outline] {
    outline: 1px dashed var(--border);
    outline-offset: -4px;
    padding: 0.5rem;
  }
</style>
