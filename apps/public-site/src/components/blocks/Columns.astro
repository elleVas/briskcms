---
import { columnsGridTemplate, type ColumnsProps } from '@brisk/shared-types';
import EmptyContainerHint from '../EmptyContainerHint.astro';

type Props = ColumnsProps & { editable?: boolean; hasChildren?: boolean };

const { layout, editable, hasChildren } = Astro.props;
---

<div class="brisk-columns" style={`grid-template-columns: ${columnsGridTemplate(layout)}`}>
  <slot />
</div>
<EmptyContainerHint show={!hasChildren && Boolean(editable)} />

<style>
  .brisk-columns {
    display: grid;
    gap: 1.5rem;
  }
  @media (max-width: 640px) {
    .brisk-columns {
      grid-template-columns: 1fr !important;
    }
  }
</style>
