---
import {
  buildBlockInstanceStyle,
  type BlockStyleOverride,
  type StatProps,
} from '@brisk/shared-types';

type Props = StatProps & { styleOverride?: BlockStyleOverride };

const { value, prefix, suffix, label, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<div class="brisk-stat" data-value={value} style={instanceStyle}>
  <div class="brisk-stat__value">
    <span class="brisk-stat__prefix" data-brisk-field="prefix">{prefix}</span><span
      class="brisk-stat__number"
      data-current="0">0</span
    ><span class="brisk-stat__suffix" data-brisk-field="suffix">{suffix}</span>
  </div>
  {label && <div class="brisk-stat__label" data-brisk-field="label">{label}</div>}
</div>

<script>
  // No framework here on purpose (docs/adr/0007), same reasoning as
  // Countdown.astro/HamburgerMenu.astro. Logic lives in a plain
  // importable module (not inline here) so it can also be re-run after a
  // live canvas insert/patch — see
  // block-behaviors/run-block-behaviors-in-subtree.ts.
  import { statBehaviors } from '../../lib/block-behaviors/stat';
  import { runBlockBehaviors } from '../../lib/block-behaviors/run-block-behaviors';
  runBlockBehaviors(document, statBehaviors);
</script>

<style>
  .brisk-stat {
    text-align: center;
    background: var(--brisk-override-bg, transparent);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  .brisk-stat__value {
    font-size: 2rem;
    font-weight: 700;
    color: var(--brisk-override-text, inherit);
  }
  .brisk-stat__label {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }
</style>
