---
import type { NavLinkProps } from '@brisk/shared-types';
import { localePath } from '@brisk/theme-runtime';

type Props = NavLinkProps & {
  /** Already resolved by BlockRenderer — see its comment on `iconName`. */
  iconSvg?: string | null;
  themeName: string;
};

const { label, linkType, page, url, position, visibility, iconSvg } =
  Astro.props;
const href = linkType === 'page' && page?.locale && page?.slug ? localePath(page.locale, page.slug) : url;
---

<a
  href={href}
  class:list={[
    'brisk-nav-link',
    { 'brisk-nav-link--right': position === 'right' },
    { 'brisk-visibility-desktop-only': visibility === 'desktop-only' },
    { 'brisk-visibility-mobile-only': visibility === 'mobile-only' },
  ]}
>
  {iconSvg && <span class="brisk-nav-link__icon" set:html={iconSvg} />}
  <span data-brisk-field="label">{label}</span>
</a>

<style>
  .brisk-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .brisk-nav-link--right {
    margin-left: auto;
  }
  .brisk-nav-link__icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
  }
  .brisk-nav-link__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
