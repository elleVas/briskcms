---
import {
  type BlockStyleOverride,
  type HeadingProps,
} from '@brisk/shared-types';

type Props = HeadingProps & { styleOverride?: BlockStyleOverride;
  instanceClass?: string | null;
};

const { text, level, styleOverride, instanceClass} = Astro.props;
const Tag = level;
---

<Tag class:list={['brisk-heading', instanceClass]} data-brisk-field="text">
  {text}
</Tag>

<style>
  .brisk-heading {
    color: var(--brisk-override-text, inherit);
  }
</style>
