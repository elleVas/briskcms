---
import type { HeadingProps } from '@brisk/shared-types';

type Props = HeadingProps & { instanceClass?: string | null };

const { text, level, instanceClass } = Astro.props;
const Tag = level;
---

<Tag class:list={['brisk-heading', instanceClass]} data-brisk-field="text">
  {text}
</Tag>

<style>
  .brisk-heading {
    color: var(--brisk-override-text, inherit);
  }
</style>
