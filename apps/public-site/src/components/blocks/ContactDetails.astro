---
import type { ContactDetailsProps, PublishedSite } from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';
import { mapSearchHref, telHref } from '../../lib/contact-links';

type Props = ContactDetailsProps & {
  site: PublishedSite;
  locale?: string;
  editable?: boolean;
  instanceClass?: string | null;
};

const {
  showAddress,
  showPhone,
  showEmail,
  showMapLink,
  site,
  locale,
  editable,
  instanceClass,
} =
  Astro.props;
const i18n = new Translator(locale ?? '');

const address = showAddress ? site.businessAddress?.trim() : '';
const phone = showPhone ? site.businessPhone?.trim() : '';
const email = showEmail ? site.businessEmail?.trim() : '';
const phoneHref = phone ? telHref(phone) : '';
const mapHref = address ? mapSearchHref(address) : '';
---

{
  address || phone || email ? (
    <address class:list={['brisk-contact-details', instanceClass]}>
      {address && (
        <p class="brisk-contact-details__row">
          <span class="brisk-contact-details__label">{i18n.t('contactDetails.address')}</span>
          <span class="brisk-contact-details__value">{address}</span>
          {showMapLink && (
            <a class="brisk-contact-details__map" href={mapHref} rel="noopener" target="_blank">
              {i18n.t('contactDetails.openMap')}
            </a>
          )}
        </p>
      )}
      {phone && (
        <p class="brisk-contact-details__row">
          <span class="brisk-contact-details__label">{i18n.t('contactDetails.phone')}</span>
          <a class="brisk-contact-details__value" href={phoneHref}>
            {phone}
          </a>
        </p>
      )}
      {email && (
        <p class="brisk-contact-details__row">
          <span class="brisk-contact-details__label">{i18n.t('contactDetails.email')}</span>
          <a class="brisk-contact-details__value" href={`mailto:${email}`}>
            {email}
          </a>
        </p>
      )}
    </address>
  ) : (
    // Only in the editor: on the site, a block with nothing to show shows
    // nothing, rather than a heading over an empty address.
    editable && (
      <p class="brisk-contact-details brisk-contact-details--empty">
        {i18n.t('contactDetails.empty')}
      </p>
    )
  )
}

<style>
  .brisk-contact-details {
    display: grid;
    gap: var(--brisk-override-gap, 0.5rem);
    margin: 0;
    font-style: normal;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0)
      var(--brisk-override-padding-x, 0);
  }

  .brisk-contact-details__row {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    min-width: 0;
  }

  .brisk-contact-details__label {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  .brisk-contact-details__value {
    overflow-wrap: anywhere;
  }

  .brisk-contact-details__map {
    font-size: 0.875rem;
    justify-self: start;
  }

  .brisk-contact-details--empty {
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
</style>
