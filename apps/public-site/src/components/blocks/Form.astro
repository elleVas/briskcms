---
import type { FormBlockProps } from '@brisk/shared-types';
import { getPublicForm } from '../../lib/public-api-client.js';

type Props = FormBlockProps;

const { form: pickedForm } = Astro.props;
const form = pickedForm ? await getPublicForm(pickedForm.formId) : null;

// Read back from the submission proxy's redirect (src/pages/api/forms/[id]/
// submit.ts) — keyed by form id so two Form blocks on the same page never
// cross-show each other's status.
const submitted = form && Astro.url.searchParams.get('formSubmitted') === form.id;
const errored = form && Astro.url.searchParams.get('formError') === form.id;

// Strips the status params before handing the URL back as the redirect
// target, so refreshing the page after a submit doesn't re-show the banner
// forever and doesn't accumulate params across repeat submissions.
const redirectParams = new URLSearchParams(Astro.url.search);
redirectParams.delete('formSubmitted');
redirectParams.delete('formError');
const redirectTo =
  Astro.url.pathname + (redirectParams.size > 0 ? `?${redirectParams}` : '');

// newsletter-consent renders and submits exactly like a checkbox
// (shared-types' own form-fields.ts comment) — both need the same
// unchecked-checkbox-omits-its-key hint for the submit proxy.
const checkboxFieldIds = (form?.fields ?? [])
  .filter((field) => field.type === 'checkbox' || field.type === 'newsletter-consent')
  .map((field) => field.id)
  .join(',');

// process.env, not import.meta.env/PUBLIC_ (same reasoning as apiUrl() in
// public-api-client.ts): read server-side per request, then written into
// the rendered HTML's data-sitekey — this app doesn't do per-domain
// build-time bundling, so a build-time-baked client constant would be
// wrong here anyway.
const turnstileSiteKey = process.env['TURNSTILE_SITE_KEY'] ?? '';
---

{
  form && (
    <div class="brisk-form">
      {submitted && (
        <p class="brisk-form__status brisk-form__status--success">
          Grazie! Il tuo messaggio è stato inviato.
        </p>
      )}
      {errored && (
        <p class="brisk-form__status brisk-form__status--error">
          Si è verificato un errore. Controlla i campi obbligatori e riprova.
        </p>
      )}
      {!submitted && (
        // multipart/form-data always, not just when a `file` field is
        // present — it works identically for every other field type too,
        // so there's no need to compute a per-form conditional for it.
        <form
          method="POST"
          action={`/api/forms/${form.id}/submit`}
          enctype="multipart/form-data"
        >
          <input type="hidden" name="_redirectTo" value={redirectTo} />
          <input type="hidden" name="_checkboxFields" value={checkboxFieldIds} />
          {/* Honeypot: real visitors never see or fill this (docs/adr/0015).
              `_`-prefixed like the other hint fields above, so the proxy
              never mistakes it for a real form field. */}
          <div class="brisk-form__honeypot" aria-hidden="true">
            <label for={`hp-${form.id}`}>Lascia questo campo vuoto</label>
            <input
              type="text"
              id={`hp-${form.id}`}
              name="_honeypot"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          {form.fields.map((field) => (
            <div class="brisk-form__field">
              <label for={`${form.id}-${field.id}`}>
                {field.label}
                {field.required && ' *'}
              </label>
              {field.type === 'textarea' ? (
                <textarea
                  id={`${form.id}-${field.id}`}
                  name={field.id}
                  required={field.required}
                />
              ) : field.type === 'select' ? (
                <select
                  id={`${form.id}-${field.id}`}
                  name={field.id}
                  required={field.required}
                >
                  <option value="" />
                  {(field.options ?? []).map((option) => (
                    <option value={option}>{option}</option>
                  ))}
                </select>
              ) : field.type === 'checkbox' ||
                field.type === 'newsletter-consent' ? (
                <input
                  type="checkbox"
                  id={`${form.id}-${field.id}`}
                  name={field.id}
                  required={field.required}
                />
              ) : (
                <input
                  type={field.type}
                  id={`${form.id}-${field.id}`}
                  name={field.id}
                  required={field.required}
                />
              )}
            </div>
          ))}
          {
            turnstileSiteKey && (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
            )
          }
          <button type="submit">Invia</button>
        </form>
      )}
    </div>
  )
}

{
  // Turnstile's own script auto-renders any .cf-turnstile element it finds
  // on the page and injects its response token as a hidden input inside
  // the enclosing <form> on completion — no glue JS needed here, same
  // "prefer native/self-contained mechanisms" reasoning as NavDropdown's
  // <details>/<summary>. Astro dedupes an identical external <script src>
  // across multiple Form blocks on the same page, so this is safe even
  // with more than one form on a page.
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<style>
  .brisk-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32rem;
  }
  .brisk-form form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .brisk-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .brisk-form__field:has(input[type='checkbox']) {
    flex-direction: row-reverse;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
  }
  .brisk-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .brisk-form input,
  .brisk-form textarea,
  .brisk-form select {
    padding: 0.5rem 0.75rem;
    border: 1px solid #d4d4d8;
    border-radius: 6px;
    font: inherit;
  }
  .brisk-form textarea {
    min-height: 6rem;
  }
  .brisk-form button {
    align-self: flex-start;
    padding: 0.5rem 1.25rem;
    border: none;
    border-radius: 6px;
    background: #18181b;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .brisk-form__status {
    padding: 0.75rem 1rem;
    border-radius: 6px;
  }
  .brisk-form__status--success {
    background: #dcfce7;
    color: #166534;
  }
  .brisk-form__status--error {
    background: #fee2e2;
    color: #991b1b;
  }
</style>
