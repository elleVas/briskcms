---
import {
  buildBlockInstanceStyle,
  type BlockStyleOverride,
  type PromoBarProps,
} from '@brisk/shared-types';
import { localePath } from '../../lib/locale-path.js';
import { t } from '../../lib/i18n.js';
import { PROMO_BAR_DISMISS_SCRIPT } from './promo-bar-dismiss-script.js';

type Props = PromoBarProps & {
  styleOverride?: BlockStyleOverride;
  locale: string;
};

const { message, linkType, page, url, visibility, styleOverride, locale } =
  Astro.props;
const href = linkType === 'page' && page ? localePath(page.locale, page.slug) : url;
const hasLink = linkType === 'page' ? Boolean(page) : Boolean(url);
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<div
  class:list={[
    'brisk-promo-bar',
    { 'brisk-visibility-desktop-only': visibility === 'desktop-only' },
    { 'brisk-visibility-mobile-only': visibility === 'mobile-only' },
  ]}
  style={instanceStyle}
>
  {
    /* is:inline, not the bundled/deferred <script> below: this one must run
       synchronously, before the browser paints the bar, or a visitor who
       already dismissed it sees a flash of it anyway. Reads
       `document.currentScript.parentElement` rather than an id so it still
       finds the right bar if this component is ever placed twice on the
       same page (header + footer), matching HamburgerMenu/NavLink's own
       querySelectorAll-over-id convention. Content lives in
       promo-bar-dismiss-script.ts, not inline here — content-security-
       policy.ts hashes that exact same string for `script-src`, so the two
       can never drift apart. */
  }
  <script is:inline set:html={PROMO_BAR_DISMISS_SCRIPT} />
  <p class="brisk-promo-bar__message">
    {hasLink ? (
      <a href={href} data-brisk-field="message">{message}</a>
    ) : (
      <span data-brisk-field="message">{message}</span>
    )}
  </p>
  <button
    type="button"
    class="brisk-promo-bar__close"
    aria-label={t(locale, 'promoBar.close')}
  >
    ×
  </button>
</div>

<script>
  // No framework here on purpose (docs/adr/0007) — a plain click listener
  // is all a dismiss button needs. Single fixed key, no per-message
  // versioning (see promoBarPropsSchema's own comment for the trade-off).
  document.querySelectorAll<HTMLElement>('.brisk-promo-bar').forEach((bar) => {
    const closeButton = bar.querySelector<HTMLButtonElement>('.brisk-promo-bar__close');
    closeButton?.addEventListener('click', () => {
      try {
        localStorage.setItem('brisk-promo-bar-dismissed', 'true');
      } catch {
        // Storage non disponibile (anteprima sandboxata) — la chiusura
        // resta comunque visiva per questo caricamento, vedi sotto.
      }
      bar.style.display = 'none';
    });
  });
</script>

<style>
  .brisk-promo-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: var(--brisk-override-padding-y, 0.75rem)
      var(--brisk-override-padding-x, 2.5rem);
    border-radius: var(--brisk-override-radius, 0);
    background: var(--brisk-override-bg, var(--primary));
    color: var(--brisk-override-text, var(--primary-foreground));
    text-align: center;
  }
  .brisk-promo-bar__message {
    margin: 0;
  }
  .brisk-promo-bar__message a {
    color: inherit;
    text-decoration: underline;
  }
  .brisk-promo-bar__close {
    position: absolute;
    right: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    padding: 0.25rem;
    border: none;
    background: none;
    color: inherit;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
