---
import type { NewsletterSignupProps } from '@brisk/shared-types';
import { t } from '../../lib/i18n.js';

type Props = NewsletterSignupProps & { locale: string };

const { title, buttonLabel, locale } = Astro.props;

// Simple presence flags, not keyed by a block id the way Form.astro keys
// by form.id — this block has no backing entity (docs/adr/0015's
// deliberately-decoupled design) and in practice a page has at most one
// newsletter signup, so there's nothing to disambiguate between.
const subscribed = Astro.url.searchParams.has('newsletterSubscribed');
const errored = Astro.url.searchParams.has('newsletterError');

const redirectParams = new URLSearchParams(Astro.url.search);
redirectParams.delete('newsletterSubscribed');
redirectParams.delete('newsletterError');
const redirectTo =
  Astro.url.pathname + (redirectParams.size > 0 ? `?${redirectParams}` : '');

// Same reasoning as Form.astro's own turnstileSiteKey.
const turnstileSiteKey = process.env['TURNSTILE_SITE_KEY'] ?? '';
---

<div class="brisk-newsletter-signup">
  {
    subscribed && (
      <p class="brisk-newsletter-signup__status brisk-newsletter-signup__status--success">
        {t(locale, 'newsletterSignup.submitSuccess')}
      </p>
    )
  }
  {
    errored && (
      <p class="brisk-newsletter-signup__status brisk-newsletter-signup__status--error">
        {t(locale, 'newsletterSignup.submitError')}
      </p>
    )
  }
  {
    !subscribed && (
      <form method="POST" action="/api/newsletter/subscribe">
        <input type="hidden" name="_redirectTo" value={redirectTo} />
        <p class="brisk-newsletter-signup__title" data-brisk-field="title">{title}</p>
        {/* Honeypot: same reasoning as Form.astro's own. */}
        <div class="brisk-newsletter-signup__honeypot" aria-hidden="true">
          <label for="newsletter-hp">{t(locale, 'form.honeypotLabel')}</label>
          <input
            type="text"
            id="newsletter-hp"
            name="_honeypot"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <div class="brisk-newsletter-signup__row">
          <input
            type="email"
            name="email"
            placeholder={t(locale, 'newsletterSignup.emailPlaceholder')}
            required
          />
          <button type="submit" data-brisk-field="buttonLabel">{buttonLabel}</button>
        </div>
        {
          turnstileSiteKey && (
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />
          )
        }
      </form>
    )
  }
</div>

{
  // Same reasoning as Form.astro's own script tag — Astro dedupes an
  // identical external <script src> across multiple blocks on one page,
  // so this is safe even alongside a Form block that also loads it.
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<style>
  .brisk-newsletter-signup {
    max-width: 24rem;
  }
  .brisk-newsletter-signup__title {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }
  .brisk-newsletter-signup__row {
    display: flex;
    gap: 0.5rem;
  }
  .brisk-newsletter-signup__row input {
    flex: 1;
    min-width: 0;
  }
  .brisk-newsletter-signup input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font: inherit;
  }
  .brisk-newsletter-signup button {
    padding: 0.5rem 1.25rem;
    border: none;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    font: inherit;
    cursor: pointer;
  }
  .brisk-newsletter-signup__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .brisk-newsletter-signup__status {
    padding: 0.75rem 1rem;
    border-radius: 6px;
  }
  /* Literal green/red regardless of theme — same reasoning as Form.astro's
     own status colors. */
  .brisk-newsletter-signup__status--success {
    background: #dcfce7;
    color: #166534;
  }
  .brisk-newsletter-signup__status--error {
    background: #fee2e2;
    color: #991b1b;
  }
</style>
