---
import type { HamburgerMenuProps } from '@brisk/shared-types';
import { Translator } from '../../lib/i18n.js';

type Props = HamburgerMenuProps & { locale: string };

const { position, visibility, locale } = Astro.props;
const i18n = new Translator(locale);
const openLabel = i18n.t('hamburgerMenu.open');
const closeLabel = i18n.t('hamburgerMenu.close');
---

<div
  class:list={[
    'brisk-hamburger',
    { 'brisk-hamburger--right': position === 'right' },
    { 'brisk-visibility-desktop-only': visibility === 'desktop-only' },
    { 'brisk-visibility-mobile-only': visibility === 'mobile-only' },
  ]}
>
  <button
    type="button"
    class="brisk-hamburger__toggle"
    aria-expanded="false"
    aria-controls="brisk-hamburger__panel"
    aria-label={openLabel}
    data-label-open={openLabel}
    data-label-close={closeLabel}
  >
    <span class="brisk-hamburger__bar"></span>
  </button>
  <div class="brisk-hamburger__panel" id="brisk-hamburger__panel">
    <div class="brisk-hamburger__links">
      <slot />
    </div>
  </div>
</div>

<script>
  // No framework here on purpose (docs/adr/0007: Puck/React stay isolated
  // to apps/editor-app) — a plain click listener toggling one class is
  // all a show/hide dropdown needs.
  document.querySelectorAll<HTMLElement>('.brisk-hamburger').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('.brisk-hamburger__toggle');
    if (!toggle) return;

    function setOpen(isOpen: boolean) {
      root.classList.toggle('brisk-hamburger--open', isOpen);
      toggle?.setAttribute('aria-expanded', String(isOpen));
      const label = isOpen
        ? toggle?.dataset.labelClose
        : toggle?.dataset.labelOpen;
      if (label) toggle?.setAttribute('aria-label', label);
    }

    toggle.addEventListener('click', () => {
      setOpen(!root.classList.contains('brisk-hamburger--open'));
    });

    // Security review 2026-08-24, accessibility: neither Esc nor a click
    // outside the panel closed it before — only re-clicking the toggle
    // itself did.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && root.classList.contains('brisk-hamburger--open')) {
        setOpen(false);
        toggle?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (
        root.classList.contains('brisk-hamburger--open') &&
        !root.contains(event.target as Node)
      ) {
        setOpen(false);
      }
    });
  });
</script>

<style>
  /* Visible by default at every width — which breakpoints (if any) hide
     it entirely is the `visibility` prop's job now (the
     brisk-visibility-desktop-only/mobile-only utility classes,
     src/styles/visibility.css), not something hardcoded here. */
  .brisk-hamburger {
    position: relative;
    display: block;
  }
  .brisk-hamburger--right {
    margin-left: auto;
  }

  .brisk-hamburger__toggle {
    position: relative;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  /* Three-bar icon via one middle bar + its ::before/::after — turns
     into an X (rotated bars, middle one hidden) when open. */
  .brisk-hamburger__bar,
  .brisk-hamburger__bar::before,
  .brisk-hamburger__bar::after {
    position: absolute;
    left: 0.375rem;
    right: 0.375rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .brisk-hamburger__bar {
    top: 50%;
    transform: translateY(-50%);
  }
  .brisk-hamburger__bar::before {
    content: '';
    top: -0.5rem;
  }
  .brisk-hamburger__bar::after {
    content: '';
    top: 0.5rem;
  }
  .brisk-hamburger.brisk-hamburger--open .brisk-hamburger__bar {
    background: transparent;
  }
  .brisk-hamburger.brisk-hamburger--open .brisk-hamburger__bar::before {
    top: 0;
    transform: rotate(45deg);
  }
  .brisk-hamburger.brisk-hamburger--open .brisk-hamburger__bar::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* A full-width panel under the toggle, not a corner-anchored card —
     spans the same width as the header it sits in (left/right: 0 against
     `.brisk-hamburger`'s own full block width), matching a standard
     hamburger dropdown. Overlays whatever is below it (position:
     absolute) instead of pushing page content down. */
  .brisk-hamburger__panel {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 10;
    padding: 1rem;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
  }
  .brisk-hamburger.brisk-hamburger--open .brisk-hamburger__panel {
    display: block;
  }

  .brisk-hamburger__links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  /* NavLink/LanguageSwitcher render their own <a> with no block styling
     of their own (they're also used inline in Nav's horizontal row) —
     :global() reaches into that child markup to give each item a proper
     full-width, tappable row here specifically. */
  .brisk-hamburger__links :global(.brisk-nav-link) {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
  }
  .brisk-hamburger__links :global(.brisk-nav-link:hover) {
    background: var(--muted);
  }
</style>
