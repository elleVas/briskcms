---
import type { GalleryProps } from '@brisk/shared-types';
import { t } from '../../lib/i18n.js';

type Props = GalleryProps & { locale: string };

const { images, locale } = Astro.props;
---

<div class="gallery">
  {
    images.some((image) => image.media) ? (
      images.map(
        (image) =>
          image.media && (
            <img
              src={image.media.url}
              alt={image.alt}
              width={image.media.width ?? undefined}
              height={image.media.height ?? undefined}
              loading="lazy"
              decoding="async"
            />
          ),
      )
    ) : (
      <p>{t(locale, 'gallery.empty')}</p>
    )
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
</style>
