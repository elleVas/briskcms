---
import type { GalleryProps } from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';
import OptimizedImage from '../OptimizedImage.astro';

type Props = GalleryProps & { locale: string };

const { images, locale } = Astro.props;
const i18n = new Translator(locale);
---

<div class="gallery">
  {
    images.some((image) => image.media) ? (
      images.map(
        (image) =>
          image.media && (
            <OptimizedImage
              media={image.media}
              alt={image.isDecorative ? '' : image.alt}
              class="gallery-image"
            />
          ),
      )
    ) : (
      <p>{i18n.t('gallery.empty')}</p>
    )
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.5rem;
  }
  /* :global() because OptimizedImage (a child component) renders the
  actual <img> — see Image.astro's own style block for the full reasoning. */
  :global(.gallery-image) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
</style>
