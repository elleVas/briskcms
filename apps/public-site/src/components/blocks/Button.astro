---
import type { ButtonProps } from '@brisk/shared-types';
import { localePathFromAncestors } from '@brisk/theme-runtime';

type Props = ButtonProps & { instanceClass?: string | null };

const { label, linkType, page, url, variant, instanceClass } = Astro.props;
const href =
  linkType === 'page' && page?.locale && page?.slug ? localePathFromAncestors(page.locale, page.ancestorSlugs ?? [], page.slug) : url;

// Override per-istanza (docs/adr/0022) — inline sull'elemento reale, non
// su un wrapper: funziona identico in editor e sul sito pubblicato.
---

<a
  class:list={[instanceClass, 
    'brisk-button',
    { 'brisk-button--secondary': variant === 'secondary' },
  ]}
  href={href}
  data-brisk-field="label"
>
  {label}
</a>

<style>
  .brisk-button {
    display: inline-block;
    padding: var(--brisk-override-padding-y, 0.5rem)
      var(--brisk-override-padding-x, 1.25rem);
    border-radius: var(--brisk-override-radius, var(--radius));
    background: var(--brisk-override-bg, var(--primary));
    color: var(--brisk-override-text, var(--primary-foreground));
    text-decoration: none;
    border: 1px solid var(--brisk-override-bg, var(--primary));
  }
  .brisk-button--secondary {
    background: transparent;
    color: var(--brisk-override-bg, var(--primary));
  }
</style>
