---
import type { ButtonProps } from '@brisk/shared-types';
import { localePathFromAncestors } from '@brisk/theme-runtime';

type Props = ButtonProps & {
  instanceClass?: string | null;
  variantClass?: string | null;
};

const { label, linkType, page, url, instanceClass, variantClass } =
  Astro.props;
const href =
  linkType === 'page' && page?.locale && page?.slug ? localePathFromAncestors(page.locale, page.ancestorSlugs ?? [], page.slug) : url;

// Neither class is built here: `variantClass` and `instanceClass` are
// both computed in BlockRenderer.astro, from `Block.variant` and
// `Block.id`. This component only has to put them on its root element —
// which is also the contract a theme's own Button override has to keep
// (see themes/README.md).
---

<a
  class:list={['brisk-button', variantClass, instanceClass]}
  href={href}
  data-brisk-field="label"
>
  {label}
</a>

<style>
  .brisk-button {
    display: inline-block;
    padding: var(--brisk-override-padding-y, 0.5rem)
      var(--brisk-override-padding-x, 1.25rem);
    border-radius: var(--brisk-override-radius, var(--radius));
    background: var(--brisk-override-bg, var(--primary));
    color: var(--brisk-override-text, var(--primary-foreground));
    text-decoration: none;
    border: 1px solid var(--brisk-override-bg, var(--primary));
  }
  .brisk-button--secondary {
    background: transparent;
    color: var(--brisk-override-bg, var(--primary));
  }
</style>
