---
import type { ButtonProps } from '@brisk/shared-types';
import { localePath } from '../../lib/locale-path.js';

type Props = ButtonProps;

const { label, linkType, page, url, variant, colorOverride } = Astro.props;
const href =
  linkType === 'page' && page ? localePath(page.locale, page.slug) : url;

// Per-instance escape hatch (docs/adr/0021, per-block granularity):
// scoping `--primary`/`--primary-foreground` locally on this element means
// `.brisk-button`'s existing var(--primary) usage below picks it up
// automatically — no separate color logic to duplicate.
const overrideStyle = colorOverride
  ? { '--primary': colorOverride, '--primary-foreground': '#fff' }
  : undefined;
---

<a
  class:list={[
    'brisk-button',
    { 'brisk-button--secondary': variant === 'secondary' },
  ]}
  href={href}
  style={overrideStyle}
  data-brisk-field="label"
>
  {label}
</a>

<style>
  .brisk-button {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
    border: 1px solid var(--primary);
  }
  .brisk-button--secondary {
    background: transparent;
    color: var(--primary);
  }
</style>
