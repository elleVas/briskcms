---
import EmptyContainerHint from '../EmptyContainerHint.astro';

export interface Props {
  editable?: boolean;
  hasChildren?: boolean;
}

const { editable, hasChildren } = Astro.props;
---

<div class="brisk-timeline">
  <slot />
  <EmptyContainerHint show={!hasChildren && Boolean(editable)} />
</div>

<style>
  .brisk-timeline {
    position: relative;
    padding-left: 1.5rem;
  }
  .brisk-timeline::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.375rem;
    bottom: 0.375rem;
    width: 2px;
    background: var(--border);
  }
</style>
