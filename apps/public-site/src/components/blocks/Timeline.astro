---
import { buildBlockInstanceStyle, type BlockStyleOverride } from '@brisk/shared-types';
import EmptyContainerHint from '../EmptyContainerHint.astro';

export interface Props {
  editable?: boolean;
  hasChildren?: boolean;
  styleOverride?: BlockStyleOverride;
}

const { editable, hasChildren, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
---

<div class="brisk-timeline" data-brisk-editable-outline={editable && hasChildren ? '' : undefined} style={instanceStyle}>
  <slot />
  <EmptyContainerHint show={!hasChildren && Boolean(editable)} />
</div>

<style>
  /* Niente paddingX/paddingY qui: padding-inline-start è strutturale
     (spazio per la linea verticale ::before), un override generico lo
     sovrascriverebbe rompendo il layout. Proprietà logiche (non
     left/padding-left) così la linea e il testo si specchiano da soli
     sotto dir="rtl". */
  .brisk-timeline {
    position: relative;
    padding-inline-start: 1.5rem;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
  }
  .brisk-timeline::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.25rem;
    top: 0.375rem;
    bottom: 0.375rem;
    width: 2px;
    background: var(--border);
  }

  /* Solo nell'editor, e solo con contenuto — vuoto mostra già il proprio
     bordo tratteggiato via EmptyContainerHint, un secondo qui sarebbe
     ridondante. Senza questo, un contenitore con dentro del vero contenuto
     perde ogni confine visibile mentre si lavora (feedback utente dal
     vivo, stesso motivo di Column.astro/Container.astro). */
  .brisk-timeline[data-brisk-editable-outline] {
    outline: 1px dashed var(--border);
    outline-offset: -4px;
    padding: 0.5rem;
  }
</style>
