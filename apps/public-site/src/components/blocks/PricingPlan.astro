---
import type { PricingPlanProps } from '@brisk/shared-types';
import { localePath } from '../../lib/locale-path.js';

type Props = PricingPlanProps;

const { name, price, period, features, highlighted, buttonLabel, linkType, page, url } =
  Astro.props;
const href =
  linkType === 'page' && page ? localePath(page.locale, page.slug) : url;
const hasLink = linkType === 'page' ? Boolean(page) : Boolean(url);
---

<div class:list={['brisk-pricing-plan', { 'brisk-pricing-plan--highlighted': highlighted }]}>
  <div class="brisk-pricing-plan__name">{name}</div>
  <div class="brisk-pricing-plan__price">
    {price}<span class="brisk-pricing-plan__period">{period}</span>
  </div>
  {
    features.length > 0 && (
      <ul class="brisk-pricing-plan__features">
        {features.map((feature) => (
          <li>{feature}</li>
        ))}
      </ul>
    )
  }
  {
    hasLink && (
      <a class="brisk-pricing-plan__button" href={href}>
        {buttonLabel}
      </a>
    )
  }
</div>

<style>
  .brisk-pricing-plan {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
  }
  /* No dedicated "accent" token distinct from primary — a highlighted
     plan uses the same "draw attention" role as a primary CTA. */
  .brisk-pricing-plan--highlighted {
    border: 2px solid var(--primary);
  }
  .brisk-pricing-plan__name {
    font-weight: 600;
  }
  .brisk-pricing-plan__price {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 0.5rem;
  }
  .brisk-pricing-plan__period {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted-foreground);
  }
  .brisk-pricing-plan__features {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .brisk-pricing-plan__features li {
    padding: 0.375rem 0;
    border-top: 1px solid var(--border);
  }
  .brisk-pricing-plan__button {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.5rem 1.25rem;
    border-radius: 6px;
    background: var(--primary);
    color: var(--primary-foreground);
    text-decoration: none;
  }
</style>
