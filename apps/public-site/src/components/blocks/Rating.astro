---
import {
  buildBlockInstanceStyle,
  STAR_ICON_PATH,
  type BlockStyleOverride,
  type RatingProps,
} from '@brisk/shared-types';

type Props = RatingProps & { styleOverride?: BlockStyleOverride };

const { rating, label, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);

const STAR_POSITIONS = [1, 2, 3, 4, 5];
---

<div class="brisk-rating" style={instanceStyle}>
  {label && <p class="brisk-rating__label">{label}</p>}
  <div
    class="brisk-rating__stars"
    role="img"
    aria-label={`${rating} su 5 stelle`}
  >
    {
      STAR_POSITIONS.map((position) => (
        // Filled stars stay literal amber regardless of theme — a rating
        // color, not a brand one, same reasoning as WhatsAppButton's green.
        <svg viewBox="0 0 20 20" width="24" height="24" aria-hidden="true">
          <path
            d={STAR_ICON_PATH}
            fill={position <= rating ? '#f59e0b' : 'var(--border)'}
          />
        </svg>
      ))
    }
  </div>
</div>

<style>
  .brisk-rating {
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  .brisk-rating__stars {
    display: flex;
    gap: 4px;
  }
</style>
