---
import type { ProfileCardProps } from '@brisk/shared-types';
import { Translator } from '@brisk/theme-runtime';
import { resolveThemeBlockOverride } from '../../lib/resolve-theme-block-override';
import { telHref } from '../../lib/contact-links';
import TeamMemberCore from './TeamMember.astro';

type Props = ProfileCardProps & {
  locale: string;
  themeName: string;
  instanceClass?: string | null;
};

const { photo, name, role, bio, email, phone, locale, themeName, instanceClass } =
  Astro.props;
const i18n = new Translator(locale);
// The theme's Team member card when it has one, so a profile and a team
// on the same site are the same card.
const TeamMember = resolveThemeBlockOverride(
  'TeamMember',
  TeamMemberCore,
  themeName,
);
const emailAddress = email.trim();
const phoneNumber = phone.trim();
---

<div class:list={['brisk-profile-card', instanceClass]}>
  <TeamMember photo={photo} name={name} role={role} bio={bio} />
  {(emailAddress || phoneNumber) && (
    <ul class="brisk-profile-card__contacts">
      {emailAddress && (
        <li>
          <a href={`mailto:${emailAddress}`}>
            <span class="brisk-visually-hidden">{i18n.t('contactDetails.email')}: </span>
            {emailAddress}
          </a>
        </li>
      )}
      {phoneNumber && (
        <li>
          <a href={telHref(phoneNumber)}>
            <span class="brisk-visually-hidden">{i18n.t('contactDetails.phone')}: </span>
            {phoneNumber}
          </a>
        </li>
      )}
    </ul>
  )}
</div>

<style>
  /* The card's own styling lives on this wrapper, and the Team member
     inside starts from its own defaults: the override variables set here
     would otherwise reach it too, and a padding set on the card would be
     applied twice. */
  .brisk-profile-card {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    text-align: center;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0)
      var(--brisk-override-padding-x, 0);
  }

  .brisk-profile-card > :global(*) {
    --brisk-override-bg: initial;
    --brisk-override-radius: initial;
    --brisk-override-padding-x: initial;
    --brisk-override-padding-y: initial;
  }

  .brisk-profile-card__contacts {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  .brisk-profile-card__contacts a {
    color: inherit;
    overflow-wrap: anywhere;
  }
</style>
