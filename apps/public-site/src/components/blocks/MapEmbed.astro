---
import type { MapEmbedProps } from '@brisk/shared-types';
import ConsentGatedEmbed from '../ConsentGatedEmbed.astro';

type Props = MapEmbedProps;

const { address } = Astro.props;
const src = address
  ? `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`
  : null;
---

{
  src ? (
    <ConsentGatedEmbed
      src={src}
      title={`Mappa: ${address}`}
      buttonLabel="Mostra la mappa (Google Maps)"
    />
  ) : (
    <p>Nessun indirizzo impostato.</p>
  )
}
