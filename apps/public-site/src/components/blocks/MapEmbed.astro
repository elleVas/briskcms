---
import type { MapEmbedProps } from '@brisk/shared-types';
import ConsentGatedEmbed from '../ConsentGatedEmbed.astro';
import { Translator } from '@brisk/theme-runtime';

type Props = MapEmbedProps & { locale: string };

const { address, locale } = Astro.props;
const src = address
  ? `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`
  : null;
const i18n = new Translator(locale);
---

{
  src ? (
    <ConsentGatedEmbed
      src={src}
      title={i18n.t('mapEmbed.title', { address: address ?? '' })}
      buttonLabel={i18n.t('mapEmbed.buttonLabel')}
    />
  ) : (
    <p>{i18n.t('mapEmbed.empty')}</p>
  )
}
