---
import sanitizeHtml from 'sanitize-html';
import {
  buildBlockInstanceStyle,
  type BlockStyleOverride,
  type EmbedHtmlProps,
} from '@brisk/shared-types';

type Props = EmbedHtmlProps & { styleOverride?: BlockStyleOverride };

const { html, styleOverride } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);

// Permissive policy (confirmed with the user, 2026-08-19): script/iframe
// stay allowed — that's what a free-embed block is for (YouTube, Calendly,
// chat widgets, analytics snippets) — but every `on*` inline event-handler
// attribute is stripped, since those are the one XSS vector that survives
// even this permissive a policy (e.g. a pasted `<img onerror=...>`).
const stripEventHandlers: sanitizeHtml.Transformer = (tagName, attribs) => {
  const safeAttribs: sanitizeHtml.Attributes = {};
  for (const [name, value] of Object.entries(attribs)) {
    if (!name.toLowerCase().startsWith('on')) {
      safeAttribs[name] = value;
    }
  }
  return { tagName, attribs: safeAttribs };
};

const safeHtml = sanitizeHtml(html, {
  allowedTags: false,
  allowedAttributes: false,
  allowVulnerableTags: true,
  transformTags: { '*': stripEventHandlers },
});
---

<div class="brisk-embed-html" style={instanceStyle} set:html={safeHtml} />

<style>
  .brisk-embed-html {
    background: var(--brisk-override-bg, transparent);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  /* `set:html` injects raw markup Astro never authored, so scoped styles
     can't reach it without :global() — a pasted embed (map, video,
     calendar widget) often ships with a fixed width/height attribute that
     would otherwise overflow the page on narrow screens. */
  .brisk-embed-html :global(iframe),
  .brisk-embed-html :global(img),
  .brisk-embed-html :global(video),
  .brisk-embed-html :global(embed),
  .brisk-embed-html :global(object) {
    max-width: 100%;
  }
</style>
