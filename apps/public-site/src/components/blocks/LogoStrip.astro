---
import type { LogoStripProps, PickedMedia } from '@brisk/shared-types';

type Props = LogoStripProps;
type LogoItem = LogoStripProps['logos'][number];

function isPictured(logo: LogoItem): logo is LogoItem & { media: PickedMedia } {
  return logo.media !== null;
}

const { logos } = Astro.props;
const pictured = logos.filter(isPictured);
---

{
  pictured.length > 0 ? (
    <div class="brisk-logo-strip">
      {pictured.map((logo) => (
        <img src={logo.media.url} alt={logo.alt} class="brisk-logo-strip__logo" />
      ))}
    </div>
  ) : (
    <p>Nessun logo aggiunto.</p>
  )
}

<style>
  .brisk-logo-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
  }
  .brisk-logo-strip__logo {
    max-width: 100%;
    height: 2.5rem;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .brisk-logo-strip__logo:hover {
    filter: none;
    opacity: 1;
  }
</style>
