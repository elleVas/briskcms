---
import {
  buildBlockInstanceStyle,
  type BlockStyleOverride,
  type LogoStripProps,
  type PickedMedia,
} from '@brisk/shared-types';
import { Translator } from '../../lib/i18n';

type Props = LogoStripProps & {
  styleOverride?: BlockStyleOverride;
  locale: string;
};
type LogoItem = LogoStripProps['logos'][number];

function isPictured(logo: LogoItem): logo is LogoItem & { media: PickedMedia } {
  return logo.media !== null;
}

const { logos, styleOverride, locale } = Astro.props;
const pictured = logos.filter(isPictured);
const instanceStyle = buildBlockInstanceStyle(styleOverride);
const i18n = new Translator(locale);
---

{
  pictured.length > 0 ? (
    <div class="brisk-logo-strip" style={instanceStyle}>
      {pictured.map((logo) => (
        <img
          src={logo.media.url}
          alt={logo.isDecorative ? '' : logo.alt}
          width={logo.media.width ?? undefined}
          height={logo.media.height ?? undefined}
          class="brisk-logo-strip__logo"
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>
  ) : (
    <p>{i18n.t('logoStrip.empty')}</p>
  )
}

<style>
  .brisk-logo-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    background: var(--brisk-override-bg, transparent);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  .brisk-logo-strip__logo {
    max-width: 100%;
    height: 2.5rem;
    width: auto;
    object-fit: contain;
    filter: grayscale(100%);
    opacity: 0.7;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }
  .brisk-logo-strip__logo:hover {
    filter: none;
    opacity: 1;
  }
</style>
