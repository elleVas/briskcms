---
import { buildBlockInstanceStyle, type BlockStyleOverride } from '@brisk/shared-types';
import EmptyContainerHint from '../EmptyContainerHint.astro';
import { Translator } from '../../lib/i18n';

export interface Props {
  editable?: boolean;
  hasChildren?: boolean;
  styleOverride?: BlockStyleOverride;
  locale: string;
}

const { editable, hasChildren, styleOverride, locale } = Astro.props;
const instanceStyle = buildBlockInstanceStyle(styleOverride);
const i18n = new Translator(locale);
---

<div
  class="brisk-testimonials"
  data-brisk-editable-outline={editable && hasChildren ? '' : undefined}
  style={instanceStyle}
>
  {
    hasChildren ? (
      <div class="brisk-testimonials__track">
        <slot />
      </div>
    ) : (
      <EmptyContainerHint show={Boolean(editable)} />
    )
  }
  {
    hasChildren && (
      <>
        <button
          type="button"
          class="brisk-testimonials__nav brisk-testimonials__nav--prev"
          aria-label={i18n.t('testimonials.prev')}
        >
          ‹
        </button>
        <button
          type="button"
          class="brisk-testimonials__nav brisk-testimonials__nav--next"
          aria-label={i18n.t('testimonials.next')}
        >
          ›
        </button>
      </>
    )
  }
</div>

<script>
  // Same "native scroll-snap first, buttons as progressive enhancement"
  // pattern as ImageSlider.astro's own carousel. Logic lives in a plain
  // importable module (not inline here) so it can also be re-run after a
  // live canvas insert/patch — see
  // block-behaviors/run-block-behaviors-in-subtree.ts.
  import { testimonialsBehaviors } from '../../lib/block-behaviors/testimonials';
  import { runBlockBehaviors } from '../../lib/block-behaviors/run-block-behaviors';
  runBlockBehaviors(document, testimonialsBehaviors);
</script>

<style>
  .brisk-testimonials {
    position: relative;
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0) var(--brisk-override-padding-x, 0);
  }
  .brisk-testimonials__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0.5rem 0;
  }
  .brisk-testimonials__track::-webkit-scrollbar {
    display: none;
  }
  .brisk-testimonials__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgb(255 255 255 / 90%);
    color: var(--foreground);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  /* Positive insets, not negative — unlike ImageSlider.astro's slider
     (which fills the block's full width, so its buttons float safely
     inside the image), a Testimonials track can end near the block's own
     edge with little margin around it; a negative offset here pushed the
     button past the page's own right edge and caused horizontal overflow
     (found via Playwright's scrollWidth check on a real preview page). */
  .brisk-testimonials__nav--prev {
    inset-inline-start: 0.5rem;
  }
  .brisk-testimonials__nav--next {
    inset-inline-end: 0.5rem;
  }
  /* Same glyph-mirroring reasoning as ImageSlider.astro's own nav. */
  .brisk-testimonials__nav:dir(rtl) {
    transform: translateY(-50%) scaleX(-1);
  }
  /* Solo nell'editor, e solo con contenuto — stesso pattern di
     Column.astro/Container.astro. */
  .brisk-testimonials[data-brisk-editable-outline] {
    outline: 1px dashed var(--border);
    outline-offset: -4px;
    padding: 0.5rem;
  }
</style>
