---
import type { ProductGridProps } from '@brisk/shared-types';
import CollectionLayout from '../CollectionLayout.astro';

export type Props = ProductGridProps & {
  editable?: boolean;
  hasChildren?: boolean;
  instanceClass?: string | null;
  emptyChildLabel?: string | null;
  locale: string;
};

const { display, editable, hasChildren, instanceClass, emptyChildLabel, locale } =
  Astro.props;
---

<CollectionLayout
  blockClass="brisk-product-grid"
  display={display}
  editable={editable}
  hasChildren={hasChildren}
  instanceClass={instanceClass}
  emptyChildLabel={emptyChildLabel}
  locale={locale}
  step="item"
>
  <slot />
</CollectionLayout>

<script>
  import { collectionBehaviors } from '../../lib/block-behaviors/collection';
  import { runBlockBehaviors } from '../../lib/block-behaviors/run-block-behaviors';
  runBlockBehaviors(document, collectionBehaviors);
</script>

<style>
  /* `:global()` for Testimonials.astro's reason: CollectionLayout renders
     the element, so this file's scoped styles would never reach it. */
  :global(.brisk-product-grid) {
    background: var(--brisk-override-bg, transparent);
    color: var(--brisk-override-text, inherit);
    border-radius: var(--brisk-override-radius, 0);
    padding: var(--brisk-override-padding-y, 0)
      var(--brisk-override-padding-x, 0);
  }
  /* `min(15rem, 100%)`: a column narrower than 15rem cannot hold one, and
     a fixed 15rem minimum would overflow a phone-width sidebar. */
  :global(.brisk-product-grid.brisk-collection--grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: var(--brisk-override-gap, 1.5rem);
  }
  :global(.brisk-product-grid[data-brisk-editable-outline]) {
    outline: 1px dashed var(--border);
    outline-offset: -4px;
    padding: 0.5rem;
  }
</style>
