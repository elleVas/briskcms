---
import { getPublishedPageBySlug } from '../../lib/public-api-client.js';
import { localePathFromAncestors } from '../../lib/locale-path.js';
import PublicPageContent from '../../components/PublicPageContent.astro';

// A dynamic route ([locale]/[...slug]) with no getStaticPaths() is
// ambiguous to Astro without this: it can't tell whether params should
// come from a build-time-enumerated list (SSG) or from each incoming
// request (SSR). output: 'server' alone resolves that ambiguity for
// static routes but not dynamic ones — this makes the SSR intent
// explicit, matching how the content is actually served here (fetched
// per-request from apps/api, never known at build time, see
// astro.config.mjs).
export const prerender = false;

// [...slug] is a rest param: Astro hands it back as one slash-joined
// string (e.g. "servizi/idraulica"), or undefined for zero segments —
// never an array. The page itself is looked up by only the LAST segment
// (slug stays globally unique per site+locale, see the page-hierarchy
// ADR — no per-parent scoping), so a request for any depth resolves with
// one direct lookup, never a segment-by-segment walk down the tree.
const { locale } = Astro.params;
const requestedPath = Astro.params.slug ?? '';
const segments = requestedPath.split('/').filter(Boolean);
const ownSlug = segments.at(-1);

const page =
  locale && ownSlug
    ? await getPublishedPageBySlug(Astro.url.hostname, locale, ownSlug)
    : null;

if (!page) {
  Astro.response.status = 404;
}

// A page's ancestors (parentId chain) determine its one canonical URL —
// if the requested path doesn't match it (most commonly: an old flat URL
// for a page that has since been nested under a parent), redirect rather
// than serving duplicate content at two URLs. Every page published before
// this feature existed has no ancestors, so its canonical path is
// unchanged and this never fires for it.
if (page && locale) {
  const canonicalPath = localePathFromAncestors(
    locale,
    page.ancestors.map((ancestor) => ancestor.slug),
    ownSlug as string,
  );
  if (canonicalPath !== Astro.url.pathname) {
    return Astro.redirect(canonicalPath + Astro.url.search, 301);
  }
}
---

<PublicPageContent page={page} />
