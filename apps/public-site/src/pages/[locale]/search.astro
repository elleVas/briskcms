---
import { parseSearchExcerpt } from '@brisk/shared-types';
import {
  getPublishedSiteChrome,
  searchPublishedPages,
} from '../../lib/public-api-client.js';
import { localePath } from '../../lib/locale-path.js';
import PageLayout from '../../layouts/PageLayout.astro';
import NotFound from '../../components/NotFound.astro';

// SSR (see astro.config.mjs) — content is fetched per-request, matching
// every other public-site route (docs/adr for [...slug].astro).
export const prerender = false;

const { locale } = Astro.params;
const query = Astro.url.searchParams.get('q') ?? '';

// Same site chrome (header/footer/site) as every real page, without
// anchoring to one — this route has no backing Page row, so
// getPublishedPageBySlug can't be used; getPublishedSiteChrome is the
// page-less counterpart (see apps/api's PublicPagesController#chrome).
const chrome = locale
  ? await getPublishedSiteChrome(Astro.url.hostname, locale)
  : null;

if (!chrome) {
  Astro.response.status = 404;
}

const results =
  chrome && locale && query.trim().length > 0
    ? await searchPublishedPages(Astro.url.hostname, locale, query)
    : [];
---

{
  chrome && locale ? (
    <PageLayout
      seoMeta={{
        title: query ? `Ricerca: ${query}` : 'Ricerca',
        description: '',
      }}
      locale={locale}
      translations={[]}
      site={chrome.site}
      header={chrome.header}
      footer={chrome.footer}
      headerSticky={chrome.headerSticky}
      ancestors={[]}
    >
      <main class="brisk-search-results">
        <h1>Ricerca</h1>
        <form
          method="get"
          action={`/${locale}/search`}
          class="brisk-search-results__form"
        >
          <input type="search" name="q" value={query} aria-label="Cerca nel sito" />
          <button type="submit">Cerca</button>
        </form>

        {
          query.trim().length === 0 ? (
            <p>Digita un termine di ricerca.</p>
          ) : results.length === 0 ? (
            <p>Nessun risultato per «{query}».</p>
          ) : (
            <ul class="brisk-search-results__list">
              {results.map((result) => (
                <li>
                  <a href={localePath(locale, result.slug)}>{result.title}</a>
                  <p>
                    {parseSearchExcerpt(result.excerpt).map((segment) =>
                      segment.matched ? (
                        <mark>{segment.text}</mark>
                      ) : (
                        segment.text
                      ),
                    )}
                  </p>
                </li>
              ))}
            </ul>
          )
        }
      </main>
    </PageLayout>
  ) : (
    <NotFound />
  )
}

<style>
  .brisk-search-results {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .brisk-search-results__form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .brisk-search-results__form input {
    flex: 1;
    padding: 0.5rem;
  }
  .brisk-search-results__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .brisk-search-results__list a {
    font-weight: 600;
  }
  .brisk-search-results__list p {
    margin: 0.25rem 0 0;
    color: #52525b;
  }
  .brisk-search-results__list mark {
    background: #fde68a;
    color: inherit;
  }
</style>
