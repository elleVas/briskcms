---
import { getPublishedPageBySlug } from '../lib/public-api-client.js';
import PublicPageContent from '../components/PublicPageContent.astro';

// Astro's own native routing for "/" (src/pages/index.astro) — the only
// CMS-specific decision here is which page's content answers it: the one
// slugged "home", by convention, same as any other page otherwise. Not a
// routing hack, just what index.astro fetches.
const page = await getPublishedPageBySlug(Astro.url.hostname, 'home');

if (!page) {
  Astro.response.status = 404;
}
---

<PublicPageContent page={page} />
