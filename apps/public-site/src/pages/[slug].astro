---
import { getPublishedPageBySlug } from '../lib/public-api-client.js';
import PublicPageContent from '../components/PublicPageContent.astro';

// A dynamic route ([slug]) with no getStaticPaths() is ambiguous to Astro
// without this: it can't tell whether params should come from a
// build-time-enumerated list (SSG) or from each incoming request (SSR).
// output: 'server' alone resolves that ambiguity for static routes but not
// dynamic ones — this makes the SSR intent explicit, matching how the
// content is actually served here (fetched per-request from apps/api,
// never known at build time, see astro.config.mjs).
export const prerender = false;

const { slug } = Astro.params;
const page = slug
  ? await getPublishedPageBySlug(Astro.url.hostname, slug)
  : null;

if (!page) {
  Astro.response.status = 404;
}
---

<PublicPageContent page={page} />
