---
import {
	buildBlockStyleOverridesCss,
	DEFAULT_THEME_TOKENS,
	type Block,
	type PublishedPageAncestor,
	type PublishedPageTranslation,
	type PublishedSite,
	type SeoMeta,
} from '@brisk/shared-types';
import BlockRenderer from '../components/BlockRenderer.astro';
import { injectScriptNonce } from '../lib/content-security-policy';
import { editorAppUrl } from '../lib/editor-app-url';
import { localeDirection, localePath } from '../lib/locale-path';
import { buildSchemaOrgGraph } from '../lib/schema-org';
import { resolveThemeFont } from '../lib/theme-font';
import { Translator } from '../lib/i18n';
import '../styles/global.css';
// ~theme resolves to themes/<BRISK_THEME>/theme.css (docs/adr/0021,
// astro.config.mjs) — imported after global.css so its :root tokens win
// the cascade over that file's bare fallback defaults.
import '~theme/theme.css';
// The theme's own manifest — see themeManifest.allowStyleOverrides below
// for why this exists (docs/adr/0021's later amendment: the theme, not the
// site, has final say over whether Tier 1 is even allowed to apply).
import themeManifest from '~theme/theme.json';
import '../styles/visibility.css';

interface Props {
	seoMeta: SeoMeta;
	locale: string;
	translations: PublishedPageTranslation[];
	site: PublishedSite;
	header: Block[] | null;
	footer: Block[] | null;
	headerSticky: boolean;
	ancestors: PublishedPageAncestor[];
	// Solo la rotta di preview lo passa (vedi il piano dell'editor visuale,
	// Giorno 2) — non influenza mai la rotta pubblicata reale.
	editable?: boolean;
}

const {
	seoMeta,
	locale,
	translations,
	site,
	header,
	footer,
	headerSticky,
	ancestors,
	editable,
} = Astro.props;
const i18n = new Translator(locale);
// The default locale's translation, if published, doubles as the
// x-default alternate (docs/adr/0017) — the version search engines should
// offer a visitor whose browser locale matches none of the site's.
const defaultTranslation = translations.find(
	(translation) => translation.locale === site.defaultLocale,
);

// seoMeta.canonical is the source of truth when set (docs/adr/0014's SEO
// panel lets an editor override it) — Astro.url.href is the fallback, not
// the default, so a site behind a different public hostname than the
// request's own Host header doesn't get a wrong canonical baked in.
const pageUrl = seoMeta.canonical || Astro.url.href;
const ogImage = seoMeta.ogTags?.['image'];
const schemaOrgGraph = buildSchemaOrgGraph({ site, seoMeta, pageUrl });
// JSON.stringify doesn't escape "<" — a "</script>" inside any string value
// (e.g. a site name an admin typed) would otherwise break out of this tag.
// The safety concern is about embedding JSON.stringify's output as raw
// script content, not the SEO/business data itself, so it lives here at the
// embedding point rather than in schema-org.ts's own (pure, testable) logic.
const schemaOrgJson = JSON.stringify(schemaOrgGraph).replace(/</g, '\\u003c');

// Tier 1 of docs/adr/0021's theming model — layered on top of the active
// filesystem theme (Tier 2, imported above) via a plain <style> block, but
// only when BOTH gates allow it:
//   1. `themeManifest.allowStyleOverrides` (theme.json) — the theme
//      author's own ceiling, defaults to true if the field is missing. A
//      bespoke agency theme can set this to false so *no* site can ever
//      override it, regardless of what's stored in the DB.
//   2. `site.themeSettings.overridesEnabled` — the day-to-day switch
//      *below* that ceiling, in the Style dialog itself, for "I want to
//      temporarily go back to the theme's own look without losing what
//      I've saved". A site can turn this off; it can never turn Tier 1
//      back on if the theme's own ceiling already said no.
// When either is false, no Tier 1 CSS is emitted at all, full stop.
//
// Every declaration below is !important, found necessary by testing this
// live rather than assumed: Astro's dev server injects `import '*.css'`
// side-effect styles (global.css, ~theme/theme.css) as their own <style
// data-vite-dev-id> tags positioned *after* this component's own inline
// markup in the rendered HTML, regardless of where those imports appear in
// the frontmatter above — so a same-specificity `:root { --font-sans-value:
// ... }` here would silently lose to the theme's own `:root` rule despite
// looking earlier in the source. !important is the explicit, order-
// independent way to say "Tier 1 wins over Tier 2's own default when both
// gates allow it", which is the whole point of this block when active, not
// a specificity workaround.
// `theme` below is the *effective* Tier 1 settings for this render: every
// field forced to its "not set" value when either gate disallows
// overrides, rather than checking both gates at each usage site further
// down — one check here is much harder to accidentally miss than four
// scattered conditionals in the markup.
const allowStyleOverrides =
	(themeManifest.allowStyleOverrides ?? true) &&
	site.themeSettings.overridesEnabled;
const theme = allowStyleOverrides
	? site.themeSettings
	: {
			primaryColor: null,
			secondaryColor: null,
			fontFamily: null,
			customCss: null,
			headScript: null,
			bodyScript: null,
			faviconUrl: null,
			overridesEnabled: false,
		};
const themeFont = resolveThemeFont(theme.fontFamily);
// Global Styles Editor (Fase 2a) — stessa gate di sopra: nessun token
// personalizzato emesso quando gli override sono disabilitati.
const tokens = allowStyleOverrides ? site.themeTokens : DEFAULT_THEME_TOKENS;
const themeOverrideDeclarations = [
	theme.primaryColor && `--primary: ${theme.primaryColor} !important;`,
	theme.secondaryColor && `--secondary: ${theme.secondaryColor} !important;`,
	themeFont && `--font-sans-value: ${themeFont.cssFontFamily} !important;`,
]
	.filter(Boolean)
	.join(' ');
// Override "a livello di componente" (docs/adr/0022) — una regola CSS per
// tipo di blocco stilizzato, non un `:root` unico come sopra: ogni tipo
// ha il proprio scoping via `[data-brisk-block-type]`, così solo i
// blocchi di quel tipo vedono il nuovo valore.
const blockStyleOverridesCss = buildBlockStyleOverridesCss(
	tokens.blockStyles,
);
---

<html lang={locale} dir={localeDirection(locale)}>
	<head>
		<meta charset="utf-8" />
		{
			theme.faviconUrl ? (
				<link rel="icon" href={theme.faviconUrl} />
			) : (
				<>
					<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
					<link rel="icon" href="/favicon.ico" />
				</>
			)
		}
		<meta name="viewport" content="width=device-width" />
		{
			themeFont && (
				<>
					<link rel="preconnect" href="https://fonts.googleapis.com" />
					<link
						rel="preconnect"
						href="https://fonts.gstatic.com"
						crossorigin
					/>
					<link
						rel="stylesheet"
						href={`https://fonts.googleapis.com/css2?family=${themeFont.googleFontsFamily}&display=swap`}
					/>
				</>
			)
		}
		{
			themeOverrideDeclarations && (
				<style set:html={`:root { ${themeOverrideDeclarations} }`} />
			)
		}
		{
			blockStyleOverridesCss && <style set:html={blockStyleOverridesCss} />
		}
		<meta name="generator" content={Astro.generator} />
		<title>{seoMeta.title}</title>
		<meta name="description" content={seoMeta.description} />
		{seoMeta.canonical && <link rel="canonical" href={seoMeta.canonical} />}
		{
			!site.searchEngineIndexingEnabled && (
				<meta name="robots" content="noindex, nofollow" />
			)
		}
		{
			translations.map((translation) => (
				<link
					rel="alternate"
					hreflang={translation.locale}
					href={`${Astro.url.origin}${localePath(translation.locale, translation.slug)}`}
				/>
			))
		}
		{
			defaultTranslation && (
				<link
					rel="alternate"
					hreflang="x-default"
					href={`${Astro.url.origin}${localePath(defaultTranslation.locale, defaultTranslation.slug)}`}
				/>
			)
		}

		<meta property="og:type" content="website" />
		<meta property="og:title" content={seoMeta.title} />
		<meta property="og:description" content={seoMeta.description} />
		<meta property="og:url" content={pageUrl} />
		{ogImage && <meta property="og:image" content={ogImage} />}

		<meta
			name="twitter:card"
			content={ogImage ? 'summary_large_image' : 'summary'}
		/>
		<meta name="twitter:title" content={seoMeta.title} />
		<meta name="twitter:description" content={seoMeta.description} />
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		<script is:inline type="application/ld+json" set:html={schemaOrgJson} />

		{
			// Raw injection, admin-trusted (docs/adr/0021) — same trust level as
			// anyone who already edits pages/blocks. theme.customCss/headScript
			// are never escaped or sanitized; headScript additionally gets a
			// per-request nonce injected into each of its own <script> tags
			// (see content-security-policy.ts) since ADR-0025's CSP is strict
			// on script-src — style-src still allows 'unsafe-inline', so
			// customCss needs no such treatment.
			theme.customCss && <style set:html={theme.customCss} />
		}
		{
			theme.headScript && (
				<Fragment
					set:html={injectScriptNonce(
						theme.headScript,
						Astro.locals.cspNonce,
					)}
				/>
			)
		}
	</head>
	<body data-brisk-editor-app-url={editable ? editorAppUrl() : undefined}>
		<a href="#main-content" class="brisk-skip-link">{i18n.t('skipLink')}</a>
		{
			header && (
				<header
					class:list={[
						'border-b border-border bg-background px-6 py-4',
						{ 'brisk-header--sticky': headerSticky },
					]}
				>
					<div
						class="flex flex-col gap-3"
						data-brisk-root-blocks={editable ? 'header' : undefined}
					>
						{header.map((block) => (
							<BlockRenderer
								block={block}
								locale={locale}
								translations={translations}
								site={site}
								ancestors={ancestors}
								currentPageTitle={seoMeta.title}
								editable={editable}
							/>
						))}
					</div>
				</header>
			)
		}
		<slot />
		{
			footer && (
				<footer class="border-t border-border bg-secondary px-6 py-12">
					<div
						class="flex flex-col gap-3"
						data-brisk-root-blocks={editable ? 'footer' : undefined}
					>
						{footer.map((block) => (
							<BlockRenderer
								block={block}
								locale={locale}
								translations={translations}
								site={site}
								ancestors={ancestors}
								currentPageTitle={seoMeta.title}
								editable={editable}
							/>
						))}
					</div>
				</footer>
			)
		}
		{
			theme.bodyScript && (
				<Fragment
					set:html={injectScriptNonce(
						theme.bodyScript,
						Astro.locals.cspNonce,
					)}
				/>
			)
		}
		{
			editable && (
				<script>
					import { initPreviewBridge } from '../lib/init-preview-bridge';
					initPreviewBridge();
				</script>
			)
		}
	</body>
</html>

<style>
	/* WCAG 2.4.1 Bypass Blocks — invisibile finché non riceve focus da
	   tastiera (primo elemento del body, prima di header/nav), poi si
	   posiziona in vista. Punta a #main-content, l'id che ogni contenuto
	   slottato in questo layout deve portare sul proprio <main> reale
	   (PublicPageContent.astro, search.astro). */
	.brisk-skip-link {
		position: absolute;
		top: -100%;
		left: 0.5rem;
		z-index: 100;
		padding: 0.5rem 1rem;
		background: var(--background);
		color: var(--foreground);
		border: 1px solid var(--border);
		border-radius: 0.25rem;
	}
	.brisk-skip-link:focus {
		top: 0.5rem;
	}

	/* Configurable per (site, locale) — editor-app's "Fisso durante lo
	   scroll" toggle on the Header editor (docs/adr/0018 follow-up). A
	   z-index high enough to sit above ordinary page content, but not
	   fighting the hamburger dropdown/nav-dropdown panels, which use 10. */
	.brisk-header--sticky {
		position: sticky;
		top: 0;
		z-index: 40;
	}
</style>
